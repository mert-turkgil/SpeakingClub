<Project Sdk="Microsoft.NET.Sdk">
  <!-- Data-only backup of the production database, run by plesk-deploy.yml when SqlPackage can't
       export a .bacpac. See Program.cs. Not part of the site: SpeakingClub.csproj ignores folders
       whose names start with a dot, so nothing here is compiled into or published with the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same versions as SpeakingClub.csproj (the Pkcs pin is there for the same advisories). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
