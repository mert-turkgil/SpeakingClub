@model ErrorViewModel
@*
    The page for a missing address (404) and for unexpected errors (500 and others), in the site's design.
    HomeController.Error renders it for UseExceptionHandler and UseStatusCodePagesWithReExecute (Program.cs).
*@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var notFound = Model.StatusCode == 404;
    ViewData["Title"] = notFound ? T("Sayfa bulunamadı", "Seite nicht gefunden") : T("Bir sorun oluştu", "Ein Fehler ist aufgetreten");
    var homePath = isGerman ? "/de" : "/";
    var blogPath = isGerman ? "/beitraege" : "/yazilar";
    var dictionaryPath = isGerman ? "/woerterbuch" : "/sozluk";
    var contactPath = (isGerman ? "/ueber-uns" : "/hakkimizda") + "#contact-form";
}
@section Css {
    <script>document.documentElement.classList.add('bp-js');</script>
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
    <style>
        .error-page .bp-hero { padding-bottom: clamp(3rem, 8vw, 5rem); }
        .error-page__code { display: block; margin-top: 1.2rem; color: var(--bp-coral); font-family: var(--bp-serif); font-size: clamp(4rem, 18vw, 7rem); font-weight: 600; line-height: 1; letter-spacing: -0.04em; }
        .error-page__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 2rem; }
        .error-page__id { margin-top: 1.5rem; color: var(--bp-muted); font-size: 0.8rem; overflow-wrap: anywhere; }
    </style>
}

<div class="site-page error-page">
    <header class="bp-hero">
        <div class="bp-container">
            <span class="bp-eyebrow bp-enter">
                <i class="fa-solid @(notFound ? "fa-compass" : "fa-triangle-exclamation")" aria-hidden="true"></i>@(notFound ? T("Bulunamadı", "Nicht gefunden") : T("Hata", "Fehler"))
            </span>
            <span class="error-page__code bp-enter" style="--bp-delay: 60ms" aria-hidden="true">@Model.StatusCode</span>
            <h1 class="bp-hero__title bp-enter" style="--bp-delay: 100ms">@ViewData["Title"]</h1>
            <p class="bp-hero__lead bp-enter" style="--bp-delay: 160ms">
                @if (notFound)
                {
                    @T("Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir. Aşağıdan devam edebilirsiniz.",
                       "Die Seite wurde vielleicht verschoben oder existiert nicht. Hier geht es weiter.")
                }
                else
                {
                    @T("Bir şeyler ters gitti. Lütfen biraz sonra tekrar deneyin; sorun sürerse bize yazın.",
                       "Etwas ist schiefgelaufen. Bitte versuchen Sie es gleich noch einmal; wenn es so bleibt, schreiben Sie uns.")
                }
            </p>
            <div class="error-page__actions bp-enter" style="--bp-delay: 220ms">
                <a class="bp-btn" href="@homePath"><i class="fa-solid fa-house" aria-hidden="true"></i>@T("Ana sayfa", "Startseite")</a>
                <a class="bp-btn bp-btn--ghost" href="@blogPath">@T("Yazılar", "Beiträge")</a>
                <a class="bp-btn bp-btn--ghost" href="@dictionaryPath">@T("Sözlük", "Wörterbuch")</a>
                <a class="bp-btn bp-btn--ghost" href="@contactPath">@T("İletişim", "Kontakt")</a>
            </div>
            @if (Model.ShowRequestId)
            {
                <p class="error-page__id">@T("Hata kodu", "Fehlercode"): <code>@Model.RequestId</code></p>
            }
        </div>
    </header>
</div>

@section Scripts {
    <script src="~/js/blog.js" asp-append-version="true" defer></script>
}
