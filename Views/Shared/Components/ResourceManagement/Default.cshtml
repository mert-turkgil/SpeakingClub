@model List<SpeakingClub.Models.SiteTextRow>
@*
    Admin → Site metinleri. Search by the words you see on the site, edit Turkish and German together in
    a dialog with large text boxes (it was a one-line input, too small for the About paragraphs), save
    without leaving the page. Behaviour: wwwroot/js/admin-texts.js.
*@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
}

<div data-list data-page-size="25" data-texts data-save-url="@Url.Action("EditTranslation", "Admin")">
    <div class="adm-toolbar">
        <label class="adm-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" data-list-search placeholder="@T("Sitede gördüğünüz yazıdan birkaç kelime yazın…", "Ein paar Wörter des Textes eingeben, wie er auf der Website steht…")" aria-label="@T("Metinlerde ara", "Texte durchsuchen")" />
            <button type="button" aria-label="@T("Aramayı temizle", "Suche löschen")"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </label>
        <span class="adm-toolbar__count" data-list-count></span>
    </div>

    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th data-sort>@T("Türkçe", "Türkisch")</th>
                    <th>@T("Almanca", "Deutsch")</th>
                    <th class="is-actions"><span class="adm-sr">@T("İşlemler", "Aktionen")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr data-key="@row.Key" data-search="@row.Key @row.Turkish @row.German">
                        <td class="is-primary" data-label="@T("Türkçe", "Türkisch")">
                            <span class="adm-clamp-2" data-text="tr-TR" style="color: var(--a-ink)">@(string.IsNullOrWhiteSpace(row.Turkish) ? "—" : row.Turkish)</span>
                            <small class="adm-hint" style="font-size:0.74rem"><i class="fa-solid fa-key" aria-hidden="true"></i>@row.Key</small>
                        </td>
                        <td data-label="@T("Almanca", "Deutsch")"><span class="adm-clamp-2" data-text="de-DE">@(string.IsNullOrWhiteSpace(row.German) ? "—" : row.German)</span></td>
                        <td class="is-actions">
                            <div class="adm-row-actions">
                                <button type="button" class="adm-btn adm-btn--sm" data-edit-text
                                        data-tr="@row.Turkish" data-de="@row.German"><i class="fa-solid fa-pen" aria-hidden="true"></i>@T("Düzenle", "Bearbeiten")</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="adm-noresult">@T("Bu kelimeleri içeren bir metin bulunamadı. Daha kısa bir arama deneyin.", "Kein Text enthält diese Wörter. Versuchen Sie eine kürzere Suche.")</p>
        <div class="adm-more"><button type="button" class="adm-btn adm-btn--sm" data-list-more hidden><i class="fa-solid fa-chevron-down" aria-hidden="true"></i><span></span></button></div>
    </div>
</div>

<dialog class="adm-dialog adm-dialog--wide" id="adm-text-dialog" aria-labelledby="adm-text-title">
    <form method="dialog" class="adm-dialog__form" data-text-form>
        @Html.AntiForgeryToken()
        <div class="adm-dialog__head">
            <h2 id="adm-text-title"><i class="fa-solid fa-language me-2" style="color: var(--a-coral-deep)" aria-hidden="true"></i>@T("Metni düzenle", "Text bearbeiten")</h2>
            <p class="adm-hint"><i class="fa-solid fa-key" aria-hidden="true"></i><span data-text-key></span></p>
        </div>
        <div class="adm-dialog__fields">
            <div class="adm-field">
                <label for="text-tr">@T("Türkçe", "Türkisch")</label>
                <textarea id="text-tr" class="adm-input" rows="5" data-lang="tr-TR"></textarea>
            </div>
            <div class="adm-field">
                <label for="text-de">@T("Almanca", "Deutsch")</label>
                <textarea id="text-de" class="adm-input" rows="5" data-lang="de-DE"></textarea>
            </div>
            <p class="adm-tip"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>@Html.Raw(T("<b>&lt;strong&gt;</b> gibi işaretleri silmeyin; yazının kalın görünmesini sağlarlar. Değişiklik kaydettiğiniz anda sitede görünür.", "Lassen Sie Zeichen wie <b>&lt;strong&gt;</b> stehen – sie machen den Text fett. Die Änderung ist sofort nach dem Speichern online."))</span></p>
        </div>
        <div class="adm-dialog__actions">
            <button type="button" class="adm-btn" data-text-cancel>@T("Vazgeç", "Abbrechen")</button>
            <button type="submit" class="adm-btn adm-btn--primary" data-text-save><i class="fa-solid fa-check" aria-hidden="true"></i>@T("Kaydet", "Speichern")</button>
        </div>
    </form>
</dialog>
<script src="~/js/admin-texts.js" asp-append-version="true" defer></script>
