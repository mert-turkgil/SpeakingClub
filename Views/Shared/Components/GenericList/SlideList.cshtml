@using SpeakingClub.Entity
@model List<SlideShow>
@* Admin → Ana sayfa slaytları: the home page carousel, newest first, shown as picture cards. *@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var culture = System.Globalization.CultureInfo.CurrentCulture;
}

@if (!Model.Any())
{
    <div class="adm-empty">
        <span class="adm-empty__icon" aria-hidden="true"><i class="fa-solid fa-images"></i></span>
        <h2>@T("Henüz slayt yok", "Noch keine Slider-Bilder")</h2>
        <p>@T("Ana sayfanın en üstünde gösterilecek ilk görseli ekleyin.", "Fügen Sie das erste Bild für den oberen Bereich der Startseite hinzu.")</p>
        <a class="adm-btn adm-btn--primary adm-btn--lg" href="@Url.Action("CarouselCreate", "Admin")"><i class="fa-solid fa-plus" aria-hidden="true"></i>@T("İlk slaytı ekle", "Erstes Bild hinzufügen")</a>
    </div>
}
else
{
    <div data-list data-page-size="24">
        <div class="adm-toolbar">
            <label class="adm-search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search" data-list-search placeholder="@T("Başlık veya açıklamada arayın…", "In Titel und Beschreibung suchen…")" aria-label="@T("Slaytlarda ara", "Slider durchsuchen")" />
                <button type="button" aria-label="@T("Aramayı temizle", "Suche löschen")"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </label>
            <span class="adm-toolbar__count" data-list-count></span>
        </div>
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th data-sort>@T("Slayt", "Bild")</th>
                        <th>@T("Düğme", "Schaltfläche")</th>
                        <th data-sort="num">@T("Eklenme", "Hinzugefügt")</th>
                        <th class="is-actions"><span class="adm-sr">@T("İşlemler", "Aktionen")</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slide in Model)
                    {
                        <tr>
                            <td class="is-primary" data-label="@T("Slayt", "Bild")">
                                <div class="adm-cell-title">
                                    @if (!string.IsNullOrEmpty(slide.CarouselImage))
                                    {
                                        <img class="adm-thumb" style="width:96px;height:56px" src="~/img/@slide.CarouselImage" alt="" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="adm-thumb adm-thumb--empty" style="width:96px;height:56px" aria-hidden="true"><i class="fa-regular fa-image"></i></span>
                                    }
                                    <span>
                                        <strong>@slide.CarouselTitle</strong>
                                        <small class="adm-clamp-2">@slide.CarouselDescription</small>
                                    </span>
                                </div>
                            </td>
                            <td data-label="@T("Düğme", "Schaltfläche")">
                                @if (!string.IsNullOrWhiteSpace(slide.CarouselLinkText))
                                {
                                    <span class="adm-badge adm-badge--plain">@slide.CarouselLinkText</span>
                                }
                                else
                                {
                                    <span class="adm-hint">—</span>
                                }
                            </td>
                            <td data-label="@T("Eklenme", "Hinzugefügt")" data-value="@slide.DateAdded.ToString("yyyyMMdd")">@slide.DateAdded.ToString("d MMM yyyy", culture)</td>
                            <td class="is-actions">
                                <div class="adm-row-actions">
                                    <a class="adm-btn adm-btn--sm" href="@Url.Action("CarouselEdit", "Admin", new { id = slide.SlideId })"><i class="fa-solid fa-pen" aria-hidden="true"></i>@T("Düzenle", "Bearbeiten")</a>
                                    <form method="post" asp-controller="Admin" asp-action="CarouselDelete" asp-route-id="@slide.SlideId"
                                          data-confirm="@T("Bu slayt silinsin mi?", "Dieses Bild löschen?")"
                                          data-confirm-text="@T($"“{slide.CarouselTitle}” ana sayfadan kaldırılacak ve görselleri silinecek.", $"„{slide.CarouselTitle}“ wird von der Startseite entfernt und seine Bilder werden gelöscht.")">
                                        <button type="submit" class="adm-btn adm-btn--danger adm-btn--sm adm-btn--icon" title="@T("Sil", "Löschen")" aria-label="@T("Sil", "Löschen"): @slide.CarouselTitle"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="adm-noresult">@T("Aramanıza uyan slayt bulunamadı.", "Kein Bild passt zu Ihrer Suche.")</p>
            <div class="adm-more"><button type="button" class="adm-btn adm-btn--sm" data-list-more hidden><i class="fa-solid fa-chevron-down" aria-hidden="true"></i><span></span></button></div>
        </div>
    </div>
}
