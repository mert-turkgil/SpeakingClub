@using SpeakingClub.Entity
@using SpeakingClub.Services
@model IEnumerable<Word>
@* Admin → Kelimeler. The fields are editor HTML (shown raw on the dictionary page); here they are plain text. *@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    string Plain(string? html) => HtmlUtility.StripHtml(html ?? string.Empty).Trim();
    var words = Model.OrderBy(w => w.Term).ToList();
}

@if (!words.Any())
{
    <div class="adm-empty">
        <span class="adm-empty__icon" aria-hidden="true"><i class="fa-solid fa-spell-check"></i></span>
        <h2>@T("Henüz kelime yok", "Noch keine Wörter")</h2>
        <p>@T("Sözlüğe ilk kelimeyi eklemek için aşağıdaki düğmeye basın.", "Klicken Sie unten, um das erste Wort ins Wörterbuch aufzunehmen.")</p>
        <a class="adm-btn adm-btn--primary adm-btn--lg" href="@Url.Action("WordCreate", "Admin")"><i class="fa-solid fa-plus" aria-hidden="true"></i>@T("İlk kelimeyi ekle", "Erstes Wort hinzufügen")</a>
    </div>
}
else
{
    <div data-list data-page-size="25">
        <div class="adm-toolbar">
            <label class="adm-search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input type="search" data-list-search placeholder="@T("Kelime veya anlamında arayın…", "Nach Wort oder Bedeutung suchen…")" aria-label="@T("Kelimelerde ara", "Wörter durchsuchen")" />
                <button type="button" aria-label="@T("Aramayı temizle", "Suche löschen")"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            </label>
            <span class="adm-toolbar__count" data-list-count></span>
        </div>
        <div class="adm-table-wrap">
            <table class="adm-table">
                <thead>
                    <tr>
                        <th data-sort>@T("Kelime", "Wort")</th>
                        <th>@T("Anlamı", "Bedeutung")</th>
                        <th>@T("Örnek", "Beispiel")</th>
                        <th class="is-actions"><span class="adm-sr">@T("İşlemler", "Aktionen")</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var word in words)
                    {
                        <tr>
                            <td class="is-primary" data-label="@T("Kelime", "Wort")">
                                <div class="adm-cell-title">
                                    <span>
                                        <strong>@word.Term</strong>
                                        @if (!string.IsNullOrWhiteSpace(Plain(word.Pronunciation)))
                                        {
                                            <small>/@Plain(word.Pronunciation)/</small>
                                        }
                                    </span>
                                </div>
                            </td>
                            <td data-label="@T("Anlamı", "Bedeutung")"><span class="adm-clamp-2">@Plain(word.Definition)</span></td>
                            <td data-label="@T("Örnek", "Beispiel")"><span class="adm-clamp-2 adm-hint">@(string.IsNullOrWhiteSpace(Plain(word.Example)) ? "—" : Plain(word.Example))</span></td>
                            <td class="is-actions">
                                <div class="adm-row-actions">
                                    <a class="adm-btn adm-btn--sm" href="@Url.Action("WordEdit", "Admin", new { id = word.WordId })"><i class="fa-solid fa-pen" aria-hidden="true"></i>@T("Düzenle", "Bearbeiten")</a>
                                    <form method="post" asp-controller="Admin" asp-action="WordDelete"
                                          data-confirm="@T("Bu kelime silinsin mi?", "Dieses Wort löschen?")"
                                          data-confirm-text="@T($"“{word.Term}” sözlükten kalıcı olarak silinecek.", $"„{word.Term}“ wird endgültig aus dem Wörterbuch gelöscht.")">
                                        <input type="hidden" name="id" value="@word.WordId" />
                                        <button type="submit" class="adm-btn adm-btn--danger adm-btn--sm adm-btn--icon" title="@T("Sil", "Löschen")" aria-label="@T("Sil", "Löschen"): @word.Term"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="adm-noresult">@T("Aramanıza uyan kelime bulunamadı.", "Kein Wort passt zu Ihrer Suche.")</p>
            <div class="adm-more"><button type="button" class="adm-btn adm-btn--sm" data-list-more hidden><i class="fa-solid fa-chevron-down" aria-hidden="true"></i><span></span></button></div>
        </div>
    </div>
}
