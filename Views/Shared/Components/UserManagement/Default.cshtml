@using SpeakingClub.Models
@model IEnumerable<UserListModel>
@* Admin → Kullanıcılar: name, e-mail, roles and account state; edit/delete only where it is allowed. *@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    string RoleName(string role) => role switch
    {
        "Teacher" => T("Öğretmen", "Lehrkraft"),
        "User" => T("Öğrenci", "Lernende"),
        _ => role
    };
    string RoleTone(string role) => role switch { "Root" => "adm-badge--red", "Admin" => "adm-badge--coral", "Teacher" => "adm-badge--blue", _ => "adm-badge--plain" };
    var users = Model.ToList();
    var roleNames = users.SelectMany(u => u.Roles).Distinct().OrderBy(r => r).ToList();
}

<div data-list data-page-size="25">
    <div class="adm-toolbar">
        <label class="adm-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <input type="search" data-list-search placeholder="@T("Ad, e-posta veya kullanıcı adıyla arayın…", "Nach Name, E-Mail oder Benutzername suchen…")" aria-label="@T("Kullanıcılarda ara", "Benutzer durchsuchen")" />
            <button type="button" aria-label="@T("Aramayı temizle", "Suche löschen")"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
        </label>
        <select class="form-select" data-list-filter="roles" aria-label="@T("Role göre göster", "Nach Rolle filtern")" style="width:auto">
            <option value="">@T("Tüm roller", "Alle Rollen")</option>
            @foreach (var role in roleNames)
            {
                <option value="@role">@RoleName(role)</option>
            }
        </select>
        <select class="form-select" data-list-filter="state" aria-label="@T("Duruma göre göster", "Nach Status filtern")" style="width:auto">
            <option value="">@T("Tüm hesaplar", "Alle Konten")</option>
            <option value="locked">@T("Kilitli hesaplar", "Gesperrte Konten")</option>
            <option value="unconfirmed">@T("E-postası onaylanmamış", "E-Mail nicht bestätigt")</option>
        </select>
        <span class="adm-toolbar__count" data-list-count></span>
    </div>

    <div class="adm-table-wrap">
        <table class="adm-table">
            <thead>
                <tr>
                    <th data-sort>@T("Kişi", "Person")</th>
                    <th>@T("Rol", "Rolle")</th>
                    <th>@T("Durum", "Status")</th>
                    <th class="is-actions"><span class="adm-sr">@T("İşlemler", "Aktionen")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in users)
                {
                    var name = string.IsNullOrWhiteSpace(user.FullName) ? user.UserName ?? user.Email ?? "?" : user.FullName;
                    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
                    var state = (user.IsLockedOut ? "locked " : "") + (user.EmailConfirmed ? "" : "unconfirmed");
                    <tr data-roles="@string.Join(' ', user.Roles)" data-state="@state.Trim()">
                        <td class="is-primary" data-label="@T("Kişi", "Person")">
                            <div class="adm-cell-title">
                                <span class="adm-avatar" aria-hidden="true">@initials</span>
                                <span>
                                    <strong>@name @if (user.IsSelf) { <span class="adm-badge adm-badge--plain">@T("siz", "Sie")</span> }</strong>
                                    <small>@user.Email</small>
                                </span>
                            </div>
                        </td>
                        <td data-label="@T("Rol", "Rolle")">
                            <span class="adm-chips">
                                @foreach (var role in user.Roles)
                                {
                                    <span class="adm-badge adm-badge--plain @RoleTone(role)">@RoleName(role)</span>
                                }
                                @if (!user.Roles.Any())
                                {
                                    <span class="adm-hint">—</span>
                                }
                            </span>
                        </td>
                        <td data-label="@T("Durum", "Status")">
                            <span class="adm-chips">
                                @if (user.IsLockedOut)
                                {
                                    <span class="adm-badge adm-badge--red">@T("Kilitli", "Gesperrt")</span>
                                }
                                else
                                {
                                    <span class="adm-badge adm-badge--green">@T("Aktif", "Aktiv")</span>
                                }
                                @if (!user.EmailConfirmed)
                                {
                                    <span class="adm-badge adm-badge--amber" title="@T("Kişi e-postasındaki onay bağlantısına henüz tıklamadı; giriş yapamaz.", "Die Person hat den Bestätigungslink noch nicht geöffnet und kann sich nicht anmelden.")">@T("E-posta onaysız", "E-Mail unbestätigt")</span>
                                }
                            </span>
                        </td>
                        <td class="is-actions">
                            <div class="adm-row-actions">
                                @if (user.CanEdit)
                                {
                                    <a class="adm-btn adm-btn--sm" href="@Url.Action("UserEdit", "Admin", new { id = user.Id })"><i class="fa-solid fa-pen" aria-hidden="true"></i>@T("Düzenle", "Bearbeiten")</a>
                                }
                                else if (user.IsSelf)
                                {
                                    <a class="adm-btn adm-btn--sm adm-btn--ghost" href="@Url.Action("Account", "Account")"><i class="fa-regular fa-user" aria-hidden="true"></i>@T("Hesabım", "Mein Konto")</a>
                                }
                                else
                                {
                                    <span class="adm-hint" title="@T("Yönetici hesaplarını yalnızca Root düzenleyebilir.", "Administratorenkonten kann nur Root bearbeiten.")"><i class="fa-solid fa-lock" aria-hidden="true"></i></span>
                                }
                                @if (user.CanDelete)
                                {
                                    <form method="post" asp-controller="Admin" asp-action="UserDelete"
                                          data-confirm="@T("Bu kullanıcı silinsin mi?", "Diesen Benutzer löschen?")"
                                          data-confirm-text="@T($"{name} ({user.Email}) hesabı kalıcı olarak silinecek. Kişi artık giriş yapamaz.", $"Das Konto von {name} ({user.Email}) wird endgültig gelöscht. Die Person kann sich nicht mehr anmelden.")"
                                          data-confirm-note="@T("Sadece geçici olarak durdurmak istiyorsanız silmek yerine düzenleyip “Hesabı kilitle”yi seçin.", "Wenn Sie die Person nur vorübergehend sperren möchten, bearbeiten Sie das Konto und wählen Sie „Konto sperren“.")">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="adm-btn adm-btn--danger adm-btn--sm adm-btn--icon" title="@T("Sil", "Löschen")" aria-label="@T("Sil", "Löschen"): @name"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="adm-noresult">@T("Aramanıza uyan kullanıcı bulunamadı.", "Kein Benutzer passt zu Ihrer Suche.")</p>
        <div class="adm-more"><button type="button" class="adm-btn adm-btn--sm" data-list-more hidden><i class="fa-solid fa-chevron-down" aria-hidden="true"></i><span></span></button></div>
    </div>
</div>
