@model List<SelectListItem>

@{
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    bool isTr = currentCulture == "tr-TR";
    // For reverse: bool isDe = currentCulture == "de-DE";
}

<form asp-controller="Home" asp-action="SetLanguage"
      asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" method="post" style="display:inline;">
    <label class="switch" aria-label="@(isTr ? "Dil değiştir" : "Sprache wechseln")" title="@(isTr ? "Dil değiştir" : "Sprache wechseln")">
        <input type="checkbox"
               name="culture"
               value="de-DE"
               @(isTr ? "" : "checked")
               onchange="toggleLanguage(this)" />
        <span lang="tr">Türkçe</span>
        <span lang="de">Deutsch</span>
    </label>
    <input type="hidden" name="culture" value="@(isTr ? "tr-TR" : "de-DE")" />
</form>

<script>
   function toggleLanguage(checkbox) {
        // Find the hidden input by its name inside the same form
        var hidden = checkbox.form.querySelector('input[type="hidden"][name="culture"]');
        hidden.value = checkbox.checked ? 'de-DE' : 'tr-TR';
        checkbox.form.submit();
    }
</script>

