@using Microsoft.AspNetCore.Identity
@using SpeakingClub.Identity
@using Microsoft.Extensions.Configuration
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject IConfiguration Configuration
@inject LanguageService Localizer
@{
    // Site-wide SEO: defaults in the page language and the organization's structured data (one @graph,
    // serialized so that no text can break the JSON). Pages override title, description, image… via ViewData.
    var seoGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string ST(string tr, string de) => seoGerman ? de : tr;
    var seoSite = SeoHelper.SiteUrl;
    var seoPath = Context.Request.Path.Value ?? "/";
    var seoIsHome = seoPath == "/" || seoPath.Equals("/de", StringComparison.OrdinalIgnoreCase);
    var seoDefaultTitle = ST("Online Almanca Konuşma Dersleri | Almanca Konuş", "Online-Deutschunterricht mit Sprechfokus | Almanca Konuş");
    var seoDefaultDescription = ST(
        "Anadili Almanca olan Suna Koç ile online birebir ve grup Almanca konuşma dersleri, seviye testleri, Almanca–Türkçe sözlük ve klinik Almanca.",
        "Online-Deutschunterricht mit Muttersprachlerin Suna Koç: Einzel- und Gruppenstunden, Einstufungstests, ein Wörterbuch Deutsch–Türkisch und klinisches Deutsch.");
    var seoOgImage = ViewData["OgImage"] as string;
    var seoGraph = new List<object>
    {
        new Dictionary<string, object>
        {
            ["@type"] = "EducationalOrganization",
            ["@id"] = seoSite + "/#organization",
            ["name"] = "Almanca Konuş",
            ["alternateName"] = "Almanca Konuşma Kulübü",
            ["url"] = seoSite + "/",
            ["logo"] = new Dictionary<string, object> { ["@type"] = "ImageObject", ["url"] = seoSite + "/img/logo-512.png", ["width"] = 512, ["height"] = 512 },
            ["image"] = seoSite + "/img/og-image.jpg",
            ["description"] = seoDefaultDescription,
            ["email"] = "almancakonus.info@gmail.com",
            ["telephone"] = "+49 160 3866222",
            ["founder"] = new Dictionary<string, object> { ["@id"] = seoSite + "/#suna" },
            ["knowsLanguage"] = new[] { "de", "tr" },
            ["sameAs"] = new[]
            {
                "https://www.facebook.com/AlmancaKonusmaKulubu.Suna/",
                "https://www.instagram.com/almanca_konusma_kulubu_",
                "https://www.youtube.com/channel/UCP0ZwNE7FazB7ndyiH_Knjg",
                "https://www.linkedin.com/in/almanca-konuş-suna-koç-2a9684407"
            },
            ["contactPoint"] = new Dictionary<string, object>
            {
                ["@type"] = "ContactPoint",
                ["contactType"] = "customer service",
                ["email"] = "almancakonus.info@gmail.com",
                ["telephone"] = "+49 160 3866222",
                ["availableLanguage"] = new[] { "Turkish", "German" }
            }
        },
        new Dictionary<string, object>
        {
            ["@type"] = "Person",
            ["@id"] = seoSite + "/#suna",
            ["name"] = "Suna Koç",
            ["jobTitle"] = ST("Almanca konuşma koçu", "Deutsch-Sprechcoach"),
            ["image"] = seoSite + "/img/suna-about-800.jpg",
            ["url"] = seoSite + ST("/hakkimizda", "/ueber-uns"),
            ["knowsLanguage"] = new[] { "de", "tr" },
            ["worksFor"] = new Dictionary<string, object> { ["@id"] = seoSite + "/#organization" }
        }
    };
    // WebSite (the site name Google shows in results) belongs on the home page
    if (seoIsHome)
    {
        seoGraph.Add(new Dictionary<string, object>
        {
            ["@type"] = "WebSite",
            ["@id"] = seoSite + "/#website",
            ["url"] = seoSite + "/",
            ["name"] = "Almanca Konuş",
            ["alternateName"] = new[] { "Almanca Konuşma Kulübü", "almanca-konus.com" },
            ["inLanguage"] = seoGerman ? "de" : "tr",
            ["publisher"] = new Dictionary<string, object> { ["@id"] = seoSite + "/#organization" }
        });
    }
    var seoSchema = System.Text.Json.JsonSerializer.Serialize(
        new Dictionary<string, object> { ["@context"] = "https://schema.org", ["@graph"] = seoGraph },
        new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Create(System.Text.Unicode.UnicodeRanges.All) });
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">

<head>
  <!-- Theme (dark/light) — applied before paint to avoid a flash of the wrong theme -->
  <script>
    (function () {
      var t = localStorage.getItem('theme') || 'light';
      document.documentElement.setAttribute('data-bs-theme', t);
    })();
  </script>
  <!-- Basic Meta Tags -->
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">

  <!-- SEO Meta Tags -->
  <title>@(ViewData["Title"] ?? seoDefaultTitle)</title>
  <meta name="description" content="@(ViewData["Description"] ?? seoDefaultDescription)" />
  @if (ViewData["Keywords"] != null)
  {
    <meta name="keywords" content="@ViewData["Keywords"]" />
  }
  <meta name="author" content="Suna Koç" />
  <meta name="robots" content="@(ViewData["Robots"] ?? "index, follow, max-image-preview:large")" />
  <meta name="language" content="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName" />
  <link rel="canonical" href="@(ViewData["Canonical"] ?? SeoHelper.SiteUrl + Context.Request.Path)" />

  <!-- Hreflang Alternate Language Links -->
  @if (ViewData["HreflangTr"] != null)
  {
    <link rel="alternate" hreflang="tr" href="@ViewData["HreflangTr"]" />
  }
  @if (ViewData["HreflangDe"] != null)
  {
    <link rel="alternate" hreflang="de" href="@ViewData["HreflangDe"]" />
  }
  @if (ViewData["HreflangTr"] != null || ViewData["HreflangDe"] != null)
  {
    <link rel="alternate" hreflang="x-default"
          href="@(ViewData["HreflangTr"] ?? ViewData["Canonical"] ?? SeoHelper.SiteUrl + Context.Request.Path)" />
  }

  <!-- Open Graph Meta Tags (Facebook, LinkedIn, WhatsApp) -->
  <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
  <meta property="og:site_name" content="Almanca Konuş" />
  <meta property="og:title" content="@(ViewData["OgTitle"] ?? ViewData["Title"] ?? seoDefaultTitle)" />
  <meta property="og:description" content="@(ViewData["OgDescription"] ?? ViewData["Description"] ?? seoDefaultDescription)" />
  <meta property="og:url" content="@(ViewData["Canonical"] ?? SeoHelper.SiteUrl + Context.Request.Path)" />
  <meta property="og:image" content="@(seoOgImage ?? seoSite + ST("/img/og-image.jpg", "/img/og-image-de.jpg"))" />
  @if (seoOgImage == null)
  {
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="@ST("Almanca Konuş – Suna Koç ile online Almanca konuşma dersleri", "Almanca Konuş – Online-Deutschunterricht mit Suna Koç")" />
  }
  <meta property="og:locale" content="@System.Globalization.CultureInfo.CurrentCulture.Name.Replace("-", "_")" />

  <!-- Twitter Card Meta Tags -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="@(ViewData["OgTitle"] ?? ViewData["Title"] ?? seoDefaultTitle)" />
  <meta name="twitter:description" content="@(ViewData["OgDescription"] ?? ViewData["Description"] ?? seoDefaultDescription)" />
  <meta name="twitter:image" content="@(seoOgImage ?? seoSite + ST("/img/og-image.jpg", "/img/og-image-de.jpg"))" />
  <!-- <meta name="twitter:site" content="@@yourtwitterhandle" /> -->
  <!-- <meta name="twitter:creator" content="@@yourtwitterhandle" /> -->

  <!-- Social Media Links -->
  <link rel="me" href="https://www.facebook.com/AlmancaKonusmaKulubu.Suna/" />
  <link rel="me" href="https://www.instagram.com/almanca_konusma_kulubu_" />
  <link rel="me" href="https://www.youtube.com/channel/UCP0ZwNE7FazB7ndyiH_Knjg" />
  <link rel="me"
        href="https://www.linkedin.com/in/almanca-konuş-suna-koç-2a9684407?utm_source=share_via&utm_content=profile&utm_medium=member_android" />
  <link rel="me" href="https://linktr.ee/almancakonus.info" />
  <!-- Favicon and App Icons -->
  <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
  <link rel="icon" type="image/png" sizes="512x512" href="/img/logo-512.png" />
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
  <!-- <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" /> -->
  <!-- <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" /> -->
  <!-- <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" /> -->

  <!-- Schema.org structured data: organization, teacher and (on the home page) the website -->
  <script type="application/ld+json">@Html.Raw(seoSchema)</script>

  <!-- Blog Article Schema (Uncomment when blog is ready) -->
  @if (ViewData["ArticleSchema"] != null)
  {
    @Html.Raw(ViewData["ArticleSchema"])
  }

  <!-- Fonts (served from this site) -->
  <partial name="_Fonts" />
  <!-- Every local file carries asp-append-version: Program.cs lets browsers keep versioned files for a year.
       Animate.css, Swiper and the DataTables scripts used to load here on every page; no page used them. -->
  <!-- Brand utility classes (.bg-first, .btn-fourth…); must stay before Bootstrap, as before -->
  <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />

  <!-- Font Awesome (all icons) -->
  <!-- Font Awesome, trimmed to the icons the site uses (fa-site.min.css; rebuild it after adding an icon) -->
  <link rel="stylesheet" href="~/lib/fontawesome/css/fa-site.min.css" asp-append-version="true" />

  <!-- Site-specific CSS -->
  <link rel="stylesheet" href="~/css/universe.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  <!-- Dark mode (must load last so it overrides the above) -->
  <link rel="stylesheet" href="~/css/dark-mode.css" asp-append-version="true" />
  <!-- Header, mobile menu and footer -->
  <link rel="stylesheet" href="~/css/site-chrome.css" asp-append-version="true" />

  @await RenderSectionAsync("Css", required: false)
  <style>
      .varela-round-regular {
        font-family: 'Varela Round', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        color: #000;
        letter-spacing: 1px;
      }
  </style>
</head>

<body>
  @{
    string? Home = _localization.GetKey("Home").Value;
    string? Blog = _localization.GetKey("Blog").Value;
    string? About = _localization.GetKey("About").Value;
    string? Sözlük = _localization.GetKey("Sözlük").Value;
    string? SeviyeniziÖlçün = _localization.GetKey("SeviyeniziÖlçün").Value;
    string? KlinikAlmanca = _localization.GetKey("KlinikAlmanca").Value;
    string? FuerAerzte = _localization.GetKey("FuerAerzte").Value;
    string? FuerPflege = _localization.GetKey("FuerPflege").Value;
    string? ToolsGroup = _localization.GetKey("ToolsGroup").Value;
    string? Login = _localization.GetKey("Login").Value;
    string? Logo = _localization.GetKey("Logo").Value;
    string? Copyright = _localization.GetKey("Copyright").Value;
    string? ThemeToggle = _localization.GetKey("ThemeToggle").Value;
    string? FollowUs = _localization.GetKey("FollowUs").Value;
    string? ContactUs = _localization.GetKey("ContactUs").Value;
    string? FooterDescription = _localization.GetKey("FooterDescription").Value;
    string? currentController = ViewContext.RouteData.Values["controller"] as string;
    string? currentAction = ViewContext.RouteData.Values["action"] as string;

    // Localized URL paths based on current culture
    bool isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    string? blogListPath = isGerman ? "/beitraege" : "/yazilar";
    string? quizzesPath = isGerman ? "/pruefungen" : "/sinavlar";
    string? aboutPath = isGerman ? "/ueber-uns" : "/hakkimizda";
    string? wordsPath = isGerman ? "/woerterbuch" : "/sozluk";
    string? privacyPath = isGerman ? "/datenschutz" : "/gizlilik";
    string? termsPath = isGerman ? "/nutzungsbedingungen" : "/kullanim-kosullari";
    string? doctorsPath = isGerman ? "/aerztedeutsch" : "/hekim-almancasi";
    string? nursesPath = isGerman ? "/pflegedeutsch" : "/hemsirelik-almancasi";
    bool isHome = currentController == "Home" && currentAction == "Index";
    string homePath = isGerman ? "/de" : "/";
    bool isAbout = currentController == "Home" && currentAction == "About";
    bool isBlog = currentController == "Home" && (currentAction == "Blog" || currentAction == "BlogDetail");
    bool isClinical = currentController == "Home" && (currentAction == "DoctorsGerman" || currentAction == "NursesGerman");
    string? Current(bool active) => active ? "page" : null;

    // The copyright text in the resources carries a fixed year; keep it current
    string copyrightText = System.Text.RegularExpressions.Regex.Replace(Copyright ?? "", @"\b20\d{2}\b", DateTime.Now.Year.ToString());

    string? fullName = null;
    string userInitial = "";
    if (SignInManager.IsSignedIn(User))
    {
      var currentUser = await UserManager.GetUserAsync(User);
      fullName = $"{currentUser?.FirstName} {currentUser?.LastName}".Trim();
      userInitial = string.IsNullOrEmpty(fullName) ? "" : fullName.Substring(0, 1).ToUpper();
    }
    bool canAdmin = User.IsInRole("Admin") || User.IsInRole("Teacher") || User.IsInRole("Root");
  }
  <a class="skip-link" href="#main">@T("İçeriğe geç", "Zum Inhalt springen")</a>
  <header class="site-header sticky-top">
    <nav class="navbar navbar-expand-lg site-nav" aria-label="@T("Ana menü", "Hauptmenü")">
      <div class="container-xxl">
        <!-- Brand (Left) -->
        <a class="navbar-brand site-brand" href="@homePath">
          <span class="site-brand__logo"><img src="~/img/logo.svg" alt="" width="30" height="30"></span>
          <span class="site-brand__name varela-round-regular">@Logo</span>
        </a>
        <!-- Off-canvas toggler (mobile) -->
        <button class="navbar-toggler site-burger" type="button" data-bs-toggle="offcanvas"
                data-bs-target="#offcanvasNavbar" aria-controls="offcanvasNavbar" aria-label="@T("Menüyü aç", "Menü öffnen")">
          <span class="site-burger__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
        <!-- Standard navbar (large screens) -->
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
            <li class="nav-item d-none d-xxl-block">
              <a class="nav-link @(isHome ? "active" : "")" aria-current="@Current(isHome)" href="@homePath">
                <i class="fa-solid fa-house" aria-hidden="true"></i>@Home
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link @(isAbout ? "active" : "")" aria-current="@Current(isAbout)" href="@aboutPath">
                <i class="fa-solid fa-circle-info" aria-hidden="true"></i>@About
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link @(isBlog ? "active" : "")" aria-current="@Current(isBlog)" href="@blogListPath">
                <i class="fa-solid fa-feather-pointed" aria-hidden="true"></i>@Blog
              </a>
            </li>
            <li class="nav-item dropdown klinik-megamenu">
              <a class="nav-link @(isClinical ? "active" : "")" href="@doctorsPath" id="klinikDropdown" role="button"
                 data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-staff-snake" aria-hidden="true"></i>@KlinikAlmanca
                <i class="fa-solid fa-chevron-down site-nav__chev" aria-hidden="true"></i>
              </a>
              <div class="dropdown-menu klinik-megamenu__panel" aria-labelledby="klinikDropdown">
                <div class="klinik-megamenu__grid">
                  <div class="klinik-megamenu__col">
                    <a class="klinik-megamenu__head" href="@doctorsPath"><i class="fa-solid fa-user-doctor" aria-hidden="true"></i>@FuerAerzte</a>
                    <a class="dropdown-item" href="@(doctorsPath)#anamnese">Anamnese</a>
                    <a class="dropdown-item" href="@(doctorsPath)#patientenvorstellung">Patientenvorstellung</a>
                    <a class="dropdown-item" href="@(doctorsPath)#arztbrief">Arztbrief</a>
                    <a class="dropdown-item" href="@(doctorsPath)#kommunikation">Klinische Kommunikation</a>
                    <a class="dropdown-item" href="@(doctorsPath)#redemittel">Redemittel</a>
                    <a class="dropdown-item" href="@(doctorsPath)#abkuerzungen">Abkürzungen</a>
                  </div>
                  <div class="klinik-megamenu__col">
                    <a class="klinik-megamenu__head" href="@nursesPath"><i class="fa-solid fa-user-nurse" aria-hidden="true"></i>@FuerPflege</a>
                    <a class="dropdown-item" href="@(nursesPath)#pflegekommunikation">Pflegekommunikation</a>
                    <a class="dropdown-item" href="@(nursesPath)#patientenuebergabe">Patientenübergabe</a>
                    <a class="dropdown-item" href="@(nursesPath)#pflegedokumentation">Pflegedokumentation</a>
                    <a class="dropdown-item" href="@(nursesPath)#redemittel">Redemittel</a>
                    <a class="dropdown-item" href="@(nursesPath)#abkuerzungen">Abkürzungen</a>
                  </div>
                  <div class="klinik-megamenu__col klinik-megamenu__col--tools">
                    <span class="klinik-megamenu__head"><i class="fa-solid fa-toolbox" aria-hidden="true"></i>@ToolsGroup</span>
                    <a class="dropdown-item" href="@wordsPath"><i class="fa-solid fa-spell-check me-2 text-fourth" aria-hidden="true"></i>@Sözlük</a>
                    <a class="dropdown-item" href="@quizzesPath"><i class="fa-solid fa-chart-line me-2 text-fourth" aria-hidden="true"></i>@SeviyeniziÖlçün</a>
                  </div>
                </div>
              </div>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="@(aboutPath)#contact-form">
                <i class="fa-solid fa-envelope" aria-hidden="true"></i>@ContactUs
              </a>
            </li>
          </ul>
          <!-- Account & language (right) -->
          <div class="d-flex align-items-center site-nav__actions">
            @if (fullName != null)
            {
              <div class="dropdown">
                <button class="site-btn dropdown-toggle" type="button" id="userDropdown"
                        data-bs-toggle="dropdown" aria-expanded="false">
                  <span class="site-avatar" aria-hidden="true">@userInitial</span>@fullName
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                  @if (canAdmin)
                  {
                    <li>
                      <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                        <i class="fa-solid fa-gauge" aria-hidden="true"></i> Admin Panel
                      </a>
                    </li>
                  }
                  <li>
                    <a class="dropdown-item" asp-controller="Account" asp-action="Account">
                      <i class="fa-solid fa-user-gear" aria-hidden="true"></i> @T("Hesabım", "Mein Konto")
                    </a>
                  </li>
                  <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                      <button type="submit" class="dropdown-item">
                        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> @T("Çıkış yap", "Abmelden")
                      </button>
                    </form>
                  </li>
                </ul>
              </div>
            }
            else
            {
              <a asp-controller="Account" asp-action="Login" class="site-btn" rel="nofollow">
                <i class="fa-solid fa-user" aria-hidden="true"></i>@Login
              </a>
            }

            <div class="dropdown">
              @await Component.InvokeAsync("LanguageSelector")
            </div>
          </div>
        </div>
      </div>
    </nav>
    @if (TempData["ContactSuccess"] != null)
    {
      <div class="container mt-3">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <i class="fa fa-check-circle"></i> @TempData["ContactSuccess"]
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    }
    @if (TempData["ContactError"] != null)
    {
      <div class="container mt-3">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="fa fa-exclamation-triangle"></i> @TempData["ContactError"]
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    }

    <!-- Off-canvas menu (mobile) -->
    <div class="offcanvas offcanvas-end site-offcanvas" tabindex="-1" id="offcanvasNavbar" aria-labelledby="offcanvasNavbarLabel">
      <div class="offcanvas-header">
        @* Not an <h1>: this menu is on every page, and each page's own title must be its only h1 *@
        <a class="site-brand varela-round-regular" href="@homePath" id="offcanvasNavbarLabel">
          <span class="site-brand__logo"><img src="~/img/logo.svg" alt="" width="30" height="30"></span>
          @Logo
        </a>
        <button type="button" class="site-offcanvas__close" data-bs-dismiss="offcanvas" aria-label="@T("Menüyü kapat", "Menü schließen")">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
      </div>
      <div class="offcanvas-body">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link @(isHome ? "active" : "")" aria-current="@Current(isHome)" href="@homePath">
              <i class="fa-solid fa-house" aria-hidden="true"></i>@Home
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link @(isAbout ? "active" : "")" aria-current="@Current(isAbout)" href="@aboutPath">
              <i class="fa-solid fa-circle-info" aria-hidden="true"></i>@About
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link @(isBlog ? "active" : "")" aria-current="@Current(isBlog)" href="@blogListPath">
              <i class="fa-solid fa-feather-pointed" aria-hidden="true"></i>@Blog
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link dropdown-toggle @(isClinical ? "active" : "")" data-bs-toggle="collapse"
               href="#klinikCollapse" role="button" aria-expanded="@(isClinical ? "true" : "false")" aria-controls="klinikCollapse">
              <i class="fa-solid fa-staff-snake" aria-hidden="true"></i>@KlinikAlmanca
              <i class="fa-solid fa-chevron-down site-nav__chev" aria-hidden="true"></i>
            </a>
            <div class="collapse klinik-collapse @(isClinical ? "show" : "")" id="klinikCollapse">
              <div class="klinik-collapse__group">
                <a class="klinik-collapse__head" href="@doctorsPath"><i class="fa-solid fa-user-doctor me-2" aria-hidden="true"></i>@FuerAerzte</a>
                <a class="dropdown-item" href="@(doctorsPath)#anamnese">Anamnese</a>
                <a class="dropdown-item" href="@(doctorsPath)#patientenvorstellung">Patientenvorstellung</a>
                <a class="dropdown-item" href="@(doctorsPath)#arztbrief">Arztbrief</a>
                <a class="dropdown-item" href="@(doctorsPath)#kommunikation">Klinische Kommunikation</a>
                <a class="dropdown-item" href="@(doctorsPath)#redemittel">Redemittel</a>
                <a class="dropdown-item" href="@(doctorsPath)#abkuerzungen">Abkürzungen</a>
              </div>
              <div class="klinik-collapse__group">
