                      <!-- Dark/light theme toggle (footer + off-canvas, kept in sync, persisted) -->
                      <script>
                        (function () {
                          var toggles = document.querySelectorAll('.js-theme-toggle');
                          function current() { return document.documentElement.getAttribute('data-bs-theme') || 'light'; }
                          function sync() {
                            var isDark = current() === 'dark';
                            toggles.forEach(function (t) { t.checked = isDark; });
                          }
                          function apply(theme) {
                            document.documentElement.setAttribute('data-bs-theme', theme);
                            try { localStorage.setItem('theme', theme); } catch (e) {}
                            sync();
                          }
                          sync();
                          toggles.forEach(function (t) {
                            t.addEventListener('change', function () {
                              apply(this.checked ? 'dark' : 'light');
                            });
                          });
                        })();
                      </script>

                      <!-- Header gets a soft shadow and condenses once the page scrolls -->
                      <script>
                        (function () {
                          var header = document.querySelector('.site-header');
                          if (!header) return;
                          var ticking = false;
                          function update() { ticking = false; header.classList.toggle('is-scrolled', window.scrollY > 8); }
                          window.addEventListener('scroll', function () {
                            if (!ticking) { ticking = true; window.requestAnimationFrame(update); }
                          }, { passive: true });
                          update();
                        })();
                      </script>

