@model SpeakingClub.Models.RoleCreateModel
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var section = AdminNav.Find("roles", isGerman)!;
    ViewData["Title"] = T("Yeni rol", "Neue Rolle");
    ViewData["AdminSection"] = section.Key;
}

@{
    var adminHeader = new AdminHeader("role-form", T("Yeni rol", "Neue Rolle"),
    T("Çoğu zaman yeni bir role gerek yoktur: Root, Admin, Teacher ve User her şeyi karşılar.", "Meist braucht es keine neue Rolle: Root, Admin, Teacher und User decken alles ab."),
    ParentTitle: section.Title, ParentHref: Url.Action(section.Action));
}
<partial name="_AdminHeader" model="adminHeader" />

<form method="post" asp-action="RoleCreate" class="adm-form adm-form--single" data-dirty-guard data-loading>
    <div class="adm-form__main">
        <partial name="_AdminErrors" />
        <section class="adm-panel">
            <div class="adm-panel__head">
                <span class="adm-panel__num">1</span>
                <div>
                    <h2>@T("Rolün adı", "Name der Rolle")</h2>
                    <p>@T("Kısa ve İngilizce harflerle bir ad seçin (ör. Editor).", "Wählen Sie einen kurzen Namen (z. B. Editor).")</p>
                </div>
            </div>
            <div class="adm-panel__body">
                <div class="adm-field">
                    <label asp-for="Name">@T("Rol adı", "Rollenname") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                    <input asp-for="Name" class="adm-input" autocomplete="off" maxlength="50" data-val-required="@T("Lütfen bir ad yazın.", "Bitte geben Sie einen Namen ein.")" />
                    <span asp-validation-for="Name"></span>
                    <p class="adm-hint"><i class="fa-solid fa-lightbulb" aria-hidden="true"></i>@T("Yeni bir rol tek başına hiçbir yetki vermez; sayfaların hangi rollere açık olduğu sitenin kodunda belirlenir.", "Eine neue Rolle gibt allein keine Rechte; welche Rollen welche Seiten sehen, legt der Code der Website fest.")</p>
                </div>
            </div>
        </section>
        <div class="adm-savebar">
            <span class="adm-savebar__hint">@T("Hazır olduğunuzda kaydedin.", "Speichern Sie, wenn Sie fertig sind.")</span>
            <a class="adm-btn adm-btn--ghost" href="@Url.Action(section.Action)">@T("Vazgeç", "Abbrechen")</a>
            <button type="submit" class="adm-btn adm-btn--primary"><i class="fa-solid fa-check" aria-hidden="true"></i>@T("Rolü oluştur", "Rolle anlegen")</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
