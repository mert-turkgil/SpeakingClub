@model SpeakingClub.Models.QuizEditViewModel
@* Admin → Sınavlar → Düzenle. The form itself: _QuizForm.cshtml. *@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var section = AdminNav.Find("quizzes", isGerman)!;
    ViewData["Title"] = T("Sınavı düzenle", "Prüfung bearbeiten");
    ViewData["AdminSection"] = section.Key;
    var adminHeader = new AdminHeader("quiz-form", string.IsNullOrWhiteSpace(Model.Title) ? T("Sınavı düzenle", "Prüfung bearbeiten") : Model.Title,
        T("Soruları düzeltin ya da yenilerini ekleyin. Öğrencilerin daha önce aldığı puanlar değişmez.", "Korrigieren Sie Fragen oder fügen Sie neue hinzu. Bisherige Punktzahlen bleiben gleich."),
        ParentTitle: section.Title, ParentHref: Url.Action(section.Action));
}

<partial name="_AdminHeader" model="adminHeader" />
<partial name="_QuizForm" model="QuizFormData.From(Model)" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-quiz.js" asp-append-version="true"></script>
}
