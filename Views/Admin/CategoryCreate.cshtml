@model CategoryCreateViewModel
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var section = AdminNav.Find("categories", isGerman)!;
    ViewData["Title"] = T("Yeni kategori", "Neue Kategorie");
    ViewData["AdminSection"] = section.Key;
}

@{
    var adminHeader = new AdminHeader("category-form", T("Yeni kategori", "Neue Kategorie"),
    T("Bir ad yazın; isterseniz bu kategoriye girecek yazıları ve sınavları da hemen işaretleyin.", "Geben Sie einen Namen ein und markieren Sie auf Wunsch gleich die Beiträge und Prüfungen dafür."),
    ParentTitle: section.Title, ParentHref: Url.Action(section.Action), Guide: AdminNav.ForForm(section.Guide));
}
<partial name="_AdminHeader" model="adminHeader" />

<form method="post" asp-action="CategoryCreate" class="adm-form adm-form--single" data-dirty-guard data-loading>
    <div class="adm-form__main">
        <partial name="_AdminErrors" />
        <partial name="_CategoryFields" model="(Model.Name, Model.SelectedBlogIds, Model.SelectedQuizIds, Model.AvailableBlogs, Model.AvailableQuizzes)" />
        <div class="adm-savebar">
            <span class="adm-savebar__hint">@T("Hazır olduğunuzda kaydedin.", "Speichern Sie, wenn Sie fertig sind.")</span>
            <a class="adm-btn adm-btn--ghost" href="@Url.Action(section.Action)">@T("Vazgeç", "Abbrechen")</a>
            <button type="submit" class="adm-btn adm-btn--primary"><i class="fa-solid fa-check" aria-hidden="true"></i>@T("Kategoriyi kaydet", "Kategorie speichern")</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
