@model SpeakingClub.Models.UserCreateModel
@*
    Admin → Kullanıcılar → Yeni kullanıcı. The Age field was missing from this form while the model requires
    it (1–120), so creating a user always failed with an error the page had no field for.
*@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var section = AdminNav.Find("users", isGerman)!;
    ViewData["Title"] = T("Yeni kullanıcı", "Neuer Benutzer");
    ViewData["AdminSection"] = section.Key;
    string RoleName(string role) => role switch { "Teacher" => T("Öğretmen (Teacher)", "Lehrkraft (Teacher)"), "User" => T("Öğrenci (User)", "Lernende (User)"), _ => role };
    string RoleHint(string role) => role switch
    {
        "Root" => T("Her şey, diğer yöneticiler dahil", "Alles, auch andere Administratoren"),
        "Admin" => T("Paneldeki her şey", "Alles im Panel"),
        "Teacher" => T("Yazı, sınav, soru, kelime", "Beiträge, Prüfungen, Fragen, Wörter"),
        "User" => T("Sınav çözer, panele giremez", "Legt Prüfungen ab, kein Panel"),
        _ => ""
    };
}

@{
    var adminHeader = new AdminHeader("user-form", T("Yeni kullanıcı", "Neuer Benutzer"),
    T("Öğrenciler genellikle siteye kendileri kayıt olur. Bu sayfa, birine elle hesap açmanız gerektiğinde içindir.", "Lernende registrieren sich meist selbst. Diese Seite ist für den Fall, dass Sie jemandem selbst ein Konto anlegen."),
    ParentTitle: section.Title, ParentHref: Url.Action(section.Action),
    Guide: new AdminGuide(T("Hesap nasıl açılır?", "Wie lege ich ein Konto an?"), new[] {
        T("Kişinin adını, soyadını, yaşını ve e-postasını yazın.", "Geben Sie Vorname, Nachname, Alter und E-Mail der Person ein."),
        T("<b>Şifre oluştur</b> düğmesine basın; güvenli bir şifre kendiliğinden yazılır.", "Klicken Sie auf <b>Passwort erzeugen</b>; ein sicheres Passwort wird eingetragen."),
        T("<b>Kopyala</b> ile şifreyi alın ve kişiye iletin (ör. WhatsApp ile).", "Kopieren Sie das Passwort mit <b>Kopieren</b> und geben Sie es weiter (z. B. per WhatsApp)."),
        T("Rolünü seçin. Öğrenciler için <b>Öğrenci (User)</b> yeterlidir.", "Wählen Sie die Rolle. Für Lernende genügt <b>Lernende (User)</b>."),
        T("<b>Kullanıcıyı oluştur</b> düğmesine basın.", "Klicken Sie auf <b>Benutzer anlegen</b>.")
    }, T("Kişi ilk girişten sonra şifresini “Hesabım” sayfasından değiştirebilir.", "Die Person kann das Passwort nach der ersten Anmeldung unter „Mein Konto“ ändern.")));
}
<partial name="_AdminHeader" model="adminHeader" />

<form method="post" asp-action="UserCreate" class="adm-form" autocomplete="off" data-dirty-guard data-loading>
    <div class="adm-form__main">
        <partial name="_AdminErrors" />
        <section class="adm-panel" style="--i:0">
            <div class="adm-panel__head">
                <span class="adm-panel__num">1</span>
                <div><h2>@T("Kişisel bilgiler", "Persönliche Angaben")</h2></div>
            </div>
            <div class="adm-panel__body">
                <div class="adm-row">
                    <div class="adm-field">
                        <label asp-for="FirstName">@T("Ad", "Vorname") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                        <input asp-for="FirstName" class="adm-input" data-val-required="@T("Lütfen adı yazın.", "Bitte Vornamen eingeben.")" />
                        <span asp-validation-for="FirstName"></span>
                    </div>
                    <div class="adm-field">
                        <label asp-for="LastName">@T("Soyad", "Nachname") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                        <input asp-for="LastName" class="adm-input" data-val-required="@T("Lütfen soyadı yazın.", "Bitte Nachnamen eingeben.")" />
                        <span asp-validation-for="LastName"></span>
                    </div>
                </div>
                <div class="adm-row">
                    <div class="adm-field">
                        <label asp-for="Age">@T("Yaş", "Alter") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                        <input asp-for="Age" type="number" min="1" max="120" class="adm-input" value="@(Model.Age > 0 ? Model.Age.ToString() : "")"
                               data-val-required="@T("Lütfen yaşı yazın.", "Bitte Alter eingeben.")" data-val-range="@T("Yaş 1 ile 120 arasında olmalı.", "Das Alter muss zwischen 1 und 120 liegen.")" />
                        <span asp-validation-for="Age"></span>
                    </div>
                    <div class="adm-field">
                        <label asp-for="Email">@T("E-posta", "E-Mail") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                        <input asp-for="Email" type="email" class="adm-input" data-val-required="@T("Lütfen e-postayı yazın.", "Bitte E-Mail eingeben.")" data-val-email="@T("Bu bir e-posta adresi gibi görünmüyor.", "Das sieht nicht nach einer E-Mail-Adresse aus.")" />
                        <span asp-validation-for="Email"></span>
                    </div>
                </div>
                <div class="adm-field">
                    <label asp-for="UserName">@T("Kullanıcı adı", "Benutzername") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                    <input asp-for="UserName" class="adm-input" data-val-required="@T("Lütfen bir kullanıcı adı yazın.", "Bitte Benutzernamen eingeben.")" />
                    <span asp-validation-for="UserName"></span>
                    <p class="adm-hint"><i class="fa-solid fa-lightbulb" aria-hidden="true"></i>@T("En kolayı e-posta adresini kullanmaktır. Boşluk ve Türkçe harf kullanmayın.", "Am einfachsten nehmen Sie die E-Mail-Adresse. Keine Leerzeichen oder Umlaute.")</p>
                </div>
            </div>
        </section>

        <section class="adm-panel" style="--i:1">
            <div class="adm-panel__head">
                <span class="adm-panel__num">2</span>
                <div>
                    <h2>@T("Şifre", "Passwort")</h2>
                    <p>@T("En az 8 karakter; büyük harf, küçük harf ve rakam içermeli.", "Mindestens 8 Zeichen mit Groß- und Kleinbuchstaben und einer Ziffer.")</p>
                </div>
            </div>
            <div class="adm-panel__body">
                <div class="adm-field">
                    <label asp-for="Password">@T("Şifre", "Passwort") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                    <div class="input-group">
                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" data-val-required="@T("Lütfen bir şifre yazın veya oluşturun.", "Bitte ein Passwort eingeben oder erzeugen.")" />
                        <button type="button" class="btn" data-reveal="Password" aria-label="@T("Şifreyi göster", "Passwort anzeigen")"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
                        <button type="button" class="btn" data-copy="Password"><i class="fa-regular fa-copy" aria-hidden="true"></i>@T("Kopyala", "Kopieren")</button>
                    </div>
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="adm-field">
                    <label asp-for="ConfirmPassword">@T("Şifre (tekrar)", "Passwort (Wiederholung)") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                    <input asp-for="ConfirmPassword" type="password" class="adm-input" autocomplete="new-password" data-val-equalto="@T("İki şifre aynı değil.", "Die Passwörter stimmen nicht überein.")" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
                <div>
                    <button type="button" class="adm-btn adm-btn--soft" data-generate-password="Password,ConfirmPassword"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>@T("Şifre oluştur", "Passwort erzeugen")</button>
                </div>
            </div>
        </section>
    </div>

    <aside class="adm-form__aside">
        <section class="adm-panel" style="--i:2">
            <div class="adm-panel__head">
                <span class="adm-panel__num">3</span>
                <div><h2>@T("Rol ve hesap", "Rolle und Konto")</h2></div>
            </div>
            <div class="adm-panel__body adm-panel__body--tight">
                <div class="adm-choices adm-choices--grid" style="grid-template-columns: 1fr">
                    @foreach (var role in Model.AllRoles)
                    {
                        <label class="adm-choice">
                            <input type="checkbox" name="SelectedRoles" value="@role" @(Model.SelectedRoles.Contains(role) ? "checked" : "") />
                            <span>@RoleName(role)<small class="adm-hint" style="margin-left:auto; font-size:0.74rem">@RoleHint(role)</small></span>
                        </label>
                    }
                </div>
                <label class="adm-toggle">
                    <input type="checkbox" asp-for="EmailConfirmed" />
                    <span class="adm-toggle__track" aria-hidden="true"></span>
                    <span class="adm-toggle__text">
                        <strong>@T("E-posta onaylı sayılsın", "E-Mail als bestätigt markieren")</strong>
                        <small>@T("Açıksa kişi hemen giriş yapabilir. Kapalıysa önce e-postasındaki bağlantıya tıklaması gerekir.", "Wenn an, kann sich die Person sofort anmelden. Sonst muss sie zuerst den Link in ihrer E-Mail öffnen.")</small>
                    </span>
                </label>
            </div>
        </section>
        <div class="adm-savebar" style="margin-top:0">
            <a class="adm-btn adm-btn--ghost" href="@Url.Action(section.Action)">@T("Vazgeç", "Abbrechen")</a>
            <button type="submit" class="adm-btn adm-btn--primary" style="flex:1"><i class="fa-solid fa-user-plus" aria-hidden="true"></i>@T("Kullanıcıyı oluştur", "Benutzer anlegen")</button>
        </div>
    </aside>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
