@model SpeakingClub.Models.CarouselViewModel
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var section = AdminNav.Find("slides", isGerman)!;
    ViewData["Title"] = T("Yeni slayt", "Neues Slider-Bild");
    ViewData["AdminSection"] = section.Key;
}

@{
    var adminHeader = new AdminHeader("slide-form", T("Yeni slayt", "Neues Slider-Bild"),
    T("Ana sayfanın en üstünde kayan büyük görsellerden biri.", "Eines der großen Bilder oben auf der Startseite."),
    ParentTitle: section.Title, ParentHref: Url.Action(section.Action), Guide: AdminNav.ForForm(section.Guide));
}
<partial name="_AdminHeader" model="adminHeader" />

<form method="post" asp-action="CarouselCreate" enctype="multipart/form-data" class="adm-form" data-dirty-guard data-loading>
    <div class="adm-form__main">
        <partial name="_AdminErrors" />
        <section class="adm-panel" style="--i:0">
            <div class="adm-panel__head">
                <span class="adm-panel__num">1</span>
                <div>
                    <h2>@T("Türkçe metinler", "Türkische Texte")</h2>
                    <p>@T("Sitenin Türkçe halinde görünür.", "Erscheinen auf der türkischen Website.")</p>
                </div>
            </div>
            <div class="adm-panel__body">
                <div class="adm-field">
                    <label asp-for="CarouselTitle">@T("Başlık", "Titel") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                    <input asp-for="CarouselTitle" class="adm-input" maxlength="100" data-val-required="@T("Lütfen bir başlık yazın.", "Bitte einen Titel eingeben.")" />
                    <span class="adm-count" data-count-for="CarouselTitle" data-max="100"></span>
                    <span asp-validation-for="CarouselTitle"></span>
                </div>
                <div class="adm-field">
                    <label asp-for="CarouselDescription">@T("Kısa açıklama", "Kurzbeschreibung") <span class="adm-opt">@T("isteğe bağlı", "freiwillig")</span></label>
                    <textarea asp-for="CarouselDescription" class="adm-input" rows="3" maxlength="500"></textarea>
                    <span class="adm-count" data-count-for="CarouselDescription" data-max="500"></span>
                </div>
                <div class="adm-row">
                    <div class="adm-field">
                        <label asp-for="CarouselLinkText">@T("Düğme yazısı", "Text der Schaltfläche") <span class="adm-opt">@T("isteğe bağlı", "freiwillig")</span></label>
                        <input asp-for="CarouselLinkText" class="adm-input" maxlength="100" placeholder="@T("ör. Hemen başla", "z. B. Jetzt starten")" />
                        <p class="adm-hint">@T("Boş bırakırsanız düğme gösterilmez.", "Leer = keine Schaltfläche.")</p>
                    </div>
                    <div class="adm-field">
                        <label for="CarouselLink">@T("Düğme nereye gitsin?", "Wohin führt die Schaltfläche?")</label>
                        <partial name="_SlideLinkPicker" model="(nameof(Model.CarouselLink), Model.CarouselLink)" />
                    </div>
                </div>
            </div>
        </section>

        <section class="adm-panel" style="--i:1">
            <div class="adm-panel__head">
                <span class="adm-panel__num">2</span>
                <div>
                    <h2>@T("Almanca metinler", "Deutsche Texte")</h2>
                    <p>@T("Sitenin Almanca halinde görünür. Boş bırakırsanız Türkçesi gösterilir.", "Erscheinen auf der deutschen Website. Leer = der türkische Text wird gezeigt.")</p>
                </div>
            </div>
            <div class="adm-panel__body">
                <div class="adm-field">
                    <label for="TranslationsDE_Title">@T("Başlık (Almanca)", "Titel (Deutsch)")</label>
                    <input id="TranslationsDE_Title" name="TranslationsDE.Title" value="@Model.TranslationsDE?.Title" class="adm-input" maxlength="100" lang="de" />
                </div>
                <div class="adm-field">
                    <label for="TranslationsDE_Description">@T("Kısa açıklama (Almanca)", "Kurzbeschreibung (Deutsch)")</label>
                    <textarea id="TranslationsDE_Description" name="TranslationsDE.Description" class="adm-input" rows="3" maxlength="500" lang="de">@Model.TranslationsDE?.Description</textarea>
                </div>
                <div class="adm-field">
                    <label for="TranslationsDE_LinkText">@T("Düğme yazısı (Almanca)", "Text der Schaltfläche (Deutsch)")</label>
                    <input id="TranslationsDE_LinkText" name="TranslationsDE.LinkText" value="@Model.TranslationsDE?.LinkText" class="adm-input" maxlength="100" lang="de" />
                </div>
            </div>
        </section>
    </div>

    <aside class="adm-form__aside">
        <section class="adm-panel" style="--i:2">
            <div class="adm-panel__head">
                <span class="adm-panel__num">3</span>
                <div>
                    <h2>@T("Görsel", "Bild")</h2>
                    <p>@T("Geniş, yatay bir fotoğraf seçin (en az 1600 piksel genişlik). JPG, PNG veya WEBP, en fazla 5 MB.", "Wählen Sie ein breites Querformat (mind. 1600 Pixel breit). JPG, PNG oder WEBP, höchstens 5 MB.")</p>
                </div>
            </div>
            <div class="adm-panel__body">
                <label class="adm-drop">
                    <input type="file" asp-for="CarouselImage" accept="image/*" data-max-mb="5" />
                    <span class="adm-drop__empty">
                        <span class="adm-drop__icon"><i class="fa-solid fa-image" aria-hidden="true"></i></span>
                        <strong>@T("Görsel seçmek için tıklayın", "Zum Auswählen klicken")</strong>
                        <small>@T("ya da dosyayı buraya sürükleyin", "oder Datei hierher ziehen")</small>
                    </span>
                    <span class="adm-drop__preview"></span>
                </label>
                <span asp-validation-for="CarouselImage"></span>
                <details class="adm-details">
                    <summary><i class="fa-solid fa-mobile-screen" aria-hidden="true"></i>@T("Telefon ve tablet için ayrı görsel", "Eigene Bilder für Handy und Tablet") <small>@T("isteğe bağlı", "freiwillig")</small></summary>
                    <div class="adm-details__body">
                        <p class="adm-hint">@T("Genelde gerekmez. Telefonda görselin farklı bir kesimini göstermek isterseniz kullanın.", "Meist nicht nötig. Nutzen Sie es, wenn das Handy einen anderen Bildausschnitt zeigen soll.")</p>
                        <div class="adm-field">
                            <label asp-for="CarouselImage600w">@T("Telefon (600 px)", "Handy (600 px)")</label>
                            <input type="file" asp-for="CarouselImage600w" class="form-control" accept="image/*" />
                        </div>
                        <div class="adm-field">
                            <label asp-for="CarouselImage1200w">@T("Tablet (1200 px)", "Tablet (1200 px)")</label>
                            <input type="file" asp-for="CarouselImage1200w" class="form-control" accept="image/*" />
                        </div>
                    </div>
                </details>
            </div>
        </section>
        <div class="adm-savebar" style="margin-top:0">
            <a class="adm-btn adm-btn--ghost" href="@Url.Action(section.Action)">@T("Vazgeç", "Abbrechen")</a>
            <button type="submit" class="adm-btn adm-btn--primary" style="flex:1"><i class="fa-solid fa-check" aria-hidden="true"></i>@T("Slaytı kaydet", "Bild speichern")</button>
        </div>
    </aside>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
