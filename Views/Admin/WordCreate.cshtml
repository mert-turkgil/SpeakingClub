@model WordCreateViewModel
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var section = AdminNav.Find("words", isGerman)!;
    ViewData["Title"] = T("Yeni kelime", "Neues Wort");
    ViewData["AdminSection"] = section.Key;
}
@section Css {
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/44.3.0/ckeditor5.css" />
}

@{
    var adminHeader = new AdminHeader("word-form", T("Yeni kelime", "Neues Wort"),
    T("Kelimeyi ve anlamını yazın; diğer alanlar isteğe bağlıdır.", "Geben Sie das Wort und seine Bedeutung ein; der Rest ist freiwillig."),
    ParentTitle: section.Title, ParentHref: Url.Action(section.Action), Guide: section.Guide);
}
<partial name="_AdminHeader" model="adminHeader" />

<form method="post" asp-action="WordCreate" class="adm-form adm-form--single" data-dirty-guard data-loading>
    <div class="adm-form__main">
        <partial name="_AdminErrors" />
        <partial name="_WordFields" model="(Model.Term, Model.Definition, Model.Pronunciation, Model.Example, Model.Synonyms, Model.Origin, Model.IsFromApi, Model.SelectedQuizIds, Model.AvailableQuizzes)" />
        <div class="adm-savebar">
            <span class="adm-savebar__hint">@T("Hazır olduğunuzda kaydedin.", "Speichern Sie, wenn Sie fertig sind.")</span>
            <a class="adm-btn adm-btn--ghost" href="@Url.Action(section.Action)">@T("Vazgeç", "Abbrechen")</a>
            <button type="submit" class="adm-btn adm-btn--primary"><i class="fa-solid fa-check" aria-hidden="true"></i>@T("Kelimeyi kaydet", "Wort speichern")</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.ckeditor.com/ckeditor5/44.3.0/ckeditor5.umd.js"></script>
}
