@model SpeakingClub.Models.BlogCreateModel
@* Admin → Blog yazıları → Yeni yazı. The form itself: _BlogForm.cshtml. *@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var section = AdminNav.Find("blogs", isGerman)!;
    ViewData["Title"] = T("Yeni yazı", "Neuer Beitrag");
    ViewData["AdminSection"] = section.Key;
    var adminHeader = new AdminHeader("blog-form", T("Yeni yazı", "Neuer Beitrag"),
        T("Yukarıdaki adımları sırayla doldurun. Yalnızca başlık ve yazar zorunludur; gerisini sonra da ekleyebilirsiniz.", "Füllen Sie die Schritte der Reihe nach aus. Nur Titel und Autor sind Pflicht; den Rest können Sie später ergänzen."),
        ParentTitle: section.Title, ParentHref: Url.Action(section.Action), Guide: section.Guide);
}
@section Css {
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/44.3.0/ckeditor5.css" />
    <link rel="stylesheet" href="~/css/ck.css" />
}

<partial name="_AdminHeader" model="adminHeader" />
<partial name="_BlogForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.ckeditor.com/ckeditor5/44.3.0/ckeditor5.umd.js"></script>
    <script src="~/js/ckeditor.js" asp-append-version="true"></script>
    <script src="~/js/admin-blog.js" asp-append-version="true"></script>
}
