@model QuizCreateViewModel
@* Admin → Sınavlar → Yeni sınav. The form itself: _QuizForm.cshtml. *@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var section = AdminNav.Find("quizzes", isGerman)!;
    ViewData["Title"] = T("Yeni sınav", "Neue Prüfung");
    ViewData["AdminSection"] = section.Key;
    var adminHeader = new AdminHeader("quiz-form", T("Yeni sınav", "Neue Prüfung"),
        T("Sınava bir ad verin, soruları ekleyin ve her sorunun doğru cevabını işaretleyin.", "Geben Sie der Prüfung einen Namen, fügen Sie die Fragen hinzu und markieren Sie jeweils die richtige Antwort."),
        ParentTitle: section.Title, ParentHref: Url.Action(section.Action), Guide: AdminNav.ForForm(section.Guide));
}

<partial name="_AdminHeader" model="adminHeader" />
<partial name="_QuizForm" model="QuizFormData.From(Model)" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-quiz.js" asp-append-version="true"></script>
}
