@model SpeakingClub.Models.CarouselEditModel
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var section = AdminNav.Find("slides", isGerman)!;
    ViewData["Title"] = T("Slaytı düzenle", "Slider-Bild bearbeiten");
    ViewData["AdminSection"] = section.Key;
}

@{
    var adminHeader = new AdminHeader("slide-form", string.IsNullOrWhiteSpace(Model.CarouselTitle) ? T("Slaytı düzenle", "Slider-Bild bearbeiten") : Model.CarouselTitle,
    T("Metinleri değiştirin ya da yeni bir görsel seçin. Görsel seçmezseniz mevcut görsel kalır.", "Ändern Sie die Texte oder wählen Sie ein neues Bild. Ohne neues Bild bleibt das aktuelle."),
    ParentTitle: section.Title, ParentHref: Url.Action(section.Action));
}
<partial name="_AdminHeader" model="adminHeader" />

<form method="post" asp-action="CarouselEdit" asp-route-id="@Model.CarouselId" enctype="multipart/form-data" class="adm-form" data-dirty-guard data-loading>
    <input type="hidden" asp-for="CarouselId" />
    <input type="hidden" asp-for="DateAdded" />
    <div class="adm-form__main">
        <partial name="_AdminErrors" />
        <section class="adm-panel" style="--i:0">
            <div class="adm-panel__head">
                <span class="adm-panel__num">1</span>
                <div>
                    <h2>@T("Türkçe metinler", "Türkische Texte")</h2>
                    <p>@T("Sitenin Türkçe halinde görünür.", "Erscheinen auf der türkischen Website.")</p>
                </div>
            </div>
            <div class="adm-panel__body">
                <div class="adm-field">
                    <label asp-for="CarouselTitle">@T("Başlık", "Titel") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                    <input asp-for="CarouselTitle" class="adm-input" maxlength="100" data-val="true" data-val-required="@T("Lütfen bir başlık yazın.", "Bitte einen Titel eingeben.")" />
                    <span class="adm-count" data-count-for="CarouselTitle" data-max="100"></span>
                    <span asp-validation-for="CarouselTitle"></span>
                </div>
                <div class="adm-field">
                    <label asp-for="CarouselDescription">@T("Kısa açıklama", "Kurzbeschreibung") <span class="adm-opt">@T("isteğe bağlı", "freiwillig")</span></label>
                    <textarea asp-for="CarouselDescription" class="adm-input" rows="3" maxlength="500"></textarea>
                    <span class="adm-count" data-count-for="CarouselDescription" data-max="500"></span>
                </div>
                <div class="adm-row">
                    <div class="adm-field">
                        <label asp-for="CarouselLinkText">@T("Düğme yazısı", "Text der Schaltfläche") <span class="adm-opt">@T("isteğe bağlı", "freiwillig")</span></label>
                        <input asp-for="CarouselLinkText" class="adm-input" maxlength="100" />
                        <p class="adm-hint">@T("Boş bırakırsanız düğme gösterilmez.", "Leer = keine Schaltfläche.")</p>
                    </div>
                    <div class="adm-field">
                        <label for="CarouselLink">@T("Düğme nereye gitsin?", "Wohin führt die Schaltfläche?")</label>
                        <partial name="_SlideLinkPicker" model="(nameof(Model.CarouselLink), Model.CarouselLink)" />
                    </div>
                </div>
            </div>
        </section>

        <section class="adm-panel" style="--i:1">
            <div class="adm-panel__head">
                <span class="adm-panel__num">2</span>
                <div>
                    <h2>@T("Almanca metinler", "Deutsche Texte")</h2>
                    <p>@T("Sitenin Almanca halinde görünür.", "Erscheinen auf der deutschen Website.")</p>
                </div>
            </div>
            <div class="adm-panel__body">
                <div class="adm-field">
                    <label asp-for="CarouselTitleDE">@T("Başlık (Almanca)", "Titel (Deutsch)")</label>
                    <input asp-for="CarouselTitleDE" class="adm-input" maxlength="100" lang="de" />
                </div>
                <div class="adm-field">
                    <label asp-for="CarouselDescriptionDE">@T("Kısa açıklama (Almanca)", "Kurzbeschreibung (Deutsch)")</label>
                    <textarea asp-for="CarouselDescriptionDE" class="adm-input" rows="3" maxlength="500" lang="de"></textarea>
                </div>
                <div class="adm-field">
                    <label asp-for="CarouselLinkTextDE">@T("Düğme yazısı (Almanca)", "Text der Schaltfläche (Deutsch)")</label>
                    <input asp-for="CarouselLinkTextDE" class="adm-input" maxlength="100" lang="de" />
                </div>
            </div>
        </section>
    </div>

    <aside class="adm-form__aside">
        <section class="adm-panel" style="--i:2">
            <div class="adm-panel__head">
                <span class="adm-panel__num">3</span>
                <div>
                    <h2>@T("Görsel", "Bild")</h2>
                    <p>@T("Yeni bir görsel seçerseniz eskisinin yerini alır.", "Ein neues Bild ersetzt das alte.")</p>
                </div>
            </div>
            <div class="adm-panel__body">
                @if (!string.IsNullOrEmpty(Model.CarouselImagePath))
                {
                    <div class="adm-current">
                        <img src="~/img/@Model.CarouselImagePath" alt="" />
                        <small><i class="fa-solid fa-circle-check" style="color: var(--a-green)" aria-hidden="true"></i> @T("Şu anki görsel", "Aktuelles Bild")</small>
                    </div>
                }
                <label class="adm-drop">
                    <input type="file" asp-for="CarouselImage" accept="image/*" data-max-mb="5" />
                    <span class="adm-drop__empty">
                        <span class="adm-drop__icon"><i class="fa-solid fa-arrow-up-from-bracket" aria-hidden="true"></i></span>
                        <strong>@T("Yeni görsel seç", "Neues Bild wählen")</strong>
                        <small>@T("JPG, PNG veya WEBP, en fazla 5 MB", "JPG, PNG oder WEBP, höchstens 5 MB")</small>
                    </span>
                    <span class="adm-drop__preview"></span>
                </label>
                <details class="adm-details">
                    <summary><i class="fa-solid fa-mobile-screen" aria-hidden="true"></i>@T("Telefon ve tablet görselleri", "Bilder für Handy und Tablet") <small>@T("isteğe bağlı", "freiwillig")</small></summary>
                    <div class="adm-details__body">
                        <p class="adm-hint">@T("Boş bırakırsanız ana görselden otomatik hazırlanır. Kaydet'e bastığınızda eksik ya da çok büyük olanlar da yeniden hazırlanır.", "Bleiben die Felder leer, werden die Bilder aus dem Hauptbild erstellt. Beim Speichern werden fehlende oder zu große Bilder neu erstellt.")</p>
                        <div class="adm-field">
                            <label asp-for="CarouselImage600w">@T("Telefon (600 px)", "Handy (600 px)")</label>
                            @if (!string.IsNullOrEmpty(Model.CarouselImage600wPath))
                            {
                                <img src="~/img/@Model.CarouselImage600wPath" alt="" style="max-height:90px; width:auto; border-radius:8px" />
                            }
                            <input type="file" asp-for="CarouselImage600w" class="form-control" accept="image/*" />
                        </div>
                        <div class="adm-field">
                            <label asp-for="CarouselImage1200w">@T("Tablet (1200 px)", "Tablet (1200 px)")</label>
                            @if (!string.IsNullOrEmpty(Model.CarouselImage1200wPath))
                            {
                                <img src="~/img/@Model.CarouselImage1200wPath" alt="" style="max-height:90px; width:auto; border-radius:8px" />
                            }
                            <input type="file" asp-for="CarouselImage1200w" class="form-control" accept="image/*" />
                        </div>
                    </div>
                </details>
            </div>
        </section>
        <div class="adm-savebar" style="margin-top:0">
            <a class="adm-btn adm-btn--ghost" href="@Url.Action(section.Action)">@T("Vazgeç", "Abbrechen")</a>
            <button type="submit" class="adm-btn adm-btn--primary" style="flex:1"><i class="fa-solid fa-check" aria-hidden="true"></i>@T("Kaydet", "Speichern")</button>
        </div>
    </aside>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
