@model SpeakingClub.Models.UserEditModel
@*
    Admin → Kullanıcılar → Düzenle. Roles the signed-in user may not hand out (Root/Admin for an Admin) show
    but can't be changed; your own roles, lock and e-mail state are changed elsewhere (Hesabım).
*@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var section = AdminNav.Find("users", isGerman)!;
    ViewData["Title"] = T("Kullanıcıyı düzenle", "Benutzer bearbeiten");
    ViewData["AdminSection"] = section.Key;
    var assignable = ViewBag.AssignableRoles as List<string> ?? new List<string>();
    var lockedChoice = Model.IsSelf || Model.IsRootUser;
    string RoleName(string role) => role switch { "Teacher" => T("Öğretmen (Teacher)", "Lehrkraft (Teacher)"), "User" => T("Öğrenci (User)", "Lernende (User)"), _ => role };
    var name = string.Join(' ', new[] { Model.FirstName, Model.LastName }.Where(p => !string.IsNullOrWhiteSpace(p)));
}

@{
    var adminHeader = new AdminHeader("user-form", string.IsNullOrWhiteSpace(name) ? T("Kullanıcıyı düzenle", "Benutzer bearbeiten") : name,
    Model.IsSelf ? T("Bu sizin hesabınız. Rolünüzü ve kilidinizi buradan değiştiremezsiniz; şifrenizi “Hesabım” sayfasından değiştirin.", "Das ist Ihr eigenes Konto. Rolle und Sperre ändern Sie hier nicht; Ihr Passwort ändern Sie unter „Mein Konto“.")
                 : T("Bilgileri düzeltin, rolünü değiştirin, hesabı kilitleyin ya da yeni bir şifre verin.", "Angaben korrigieren, Rolle ändern, Konto sperren oder ein neues Passwort vergeben."),
    ParentTitle: section.Title, ParentHref: Url.Action(section.Action));
}
<partial name="_AdminHeader" model="adminHeader" />

<form method="post" asp-action="UserEdit" asp-route-id="@Model.UserId" class="adm-form" autocomplete="off" data-dirty-guard data-loading>
    <input type="hidden" asp-for="UserId" />
    <div class="adm-form__main">
        <partial name="_AdminErrors" />
        <section class="adm-panel" style="--i:0">
            <div class="adm-panel__head">
                <span class="adm-panel__num">1</span>
                <div><h2>@T("Kişisel bilgiler", "Persönliche Angaben")</h2></div>
            </div>
            <div class="adm-panel__body">
                <div class="adm-row">
                    <div class="adm-field">
                        <label asp-for="FirstName">@T("Ad", "Vorname") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                        <input asp-for="FirstName" class="adm-input" data-val-required="@T("Lütfen adı yazın.", "Bitte Vornamen eingeben.")" />
                        <span asp-validation-for="FirstName"></span>
                    </div>
                    <div class="adm-field">
                        <label asp-for="LastName">@T("Soyad", "Nachname") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                        <input asp-for="LastName" class="adm-input" data-val-required="@T("Lütfen soyadı yazın.", "Bitte Nachnamen eingeben.")" />
                        <span asp-validation-for="LastName"></span>
                    </div>
                </div>
                <div class="adm-row">
                    <div class="adm-field">
                        <label asp-for="Age">@T("Yaş", "Alter") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                        <input asp-for="Age" type="number" min="1" max="120" class="adm-input" data-val-required="@T("Lütfen yaşı yazın.", "Bitte Alter eingeben.")" data-val-range="@T("Yaş 1 ile 120 arasında olmalı.", "Das Alter muss zwischen 1 und 120 liegen.")" />
                        <span asp-validation-for="Age"></span>
                    </div>
                    <div class="adm-field">
                        <label asp-for="Email">@T("E-posta", "E-Mail") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                        <input asp-for="Email" type="email" class="adm-input" data-val-required="@T("Lütfen e-postayı yazın.", "Bitte E-Mail eingeben.")" data-val-email="@T("Bu bir e-posta adresi gibi görünmüyor.", "Das sieht nicht nach einer E-Mail-Adresse aus.")" />
                        <span asp-validation-for="Email"></span>
                    </div>
                </div>
                <div class="adm-field">
                    <label asp-for="UserName">@T("Kullanıcı adı", "Benutzername") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                    <input asp-for="UserName" class="adm-input" data-val-required="@T("Lütfen bir kullanıcı adı yazın.", "Bitte Benutzernamen eingeben.")" />
                    <span asp-validation-for="UserName"></span>
                </div>
            </div>
        </section>

        @if (!Model.IsSelf)
        {
            <section class="adm-panel" style="--i:1">
                <div class="adm-panel__head">
                    <span class="adm-panel__num">2</span>
                    <div>
                        <h2>@T("Yeni şifre ver", "Neues Passwort vergeben")</h2>
                        <p>@T("Kişi şifresini unuttuysa kullanın. Boş bırakırsanız şifre değişmez.", "Nutzen Sie das, wenn die Person ihr Passwort vergessen hat. Leer lassen = Passwort bleibt.")</p>
                    </div>
                </div>
                <div class="adm-panel__body">
                    <div class="adm-field">
                        <label asp-for="Password">@T("Yeni şifre", "Neues Passwort") <span class="adm-opt">@T("isteğe bağlı", "freiwillig")</span></label>
                        <div class="input-group">
                            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" data-val-length="@T("Şifre en az 8 karakter olmalı.", "Das Passwort braucht mindestens 8 Zeichen.")" />
                            <button type="button" class="btn" data-reveal="Password" aria-label="@T("Şifreyi göster", "Passwort anzeigen")"><i class="fa-regular fa-eye" aria-hidden="true"></i></button>
                            <button type="button" class="btn" data-copy="Password"><i class="fa-regular fa-copy" aria-hidden="true"></i>@T("Kopyala", "Kopieren")</button>
                        </div>
                        <span asp-validation-for="Password"></span>
                        <p class="adm-hint">@T("En az 8 karakter; büyük harf, küçük harf ve rakam içermeli.", "Mindestens 8 Zeichen mit Groß- und Kleinbuchstaben und einer Ziffer.")</p>
                    </div>
                    <div class="adm-field">
                        <label asp-for="ConfirmPassword">@T("Yeni şifre (tekrar)", "Neues Passwort (Wiederholung)")</label>
                        <input asp-for="ConfirmPassword" type="password" class="adm-input" autocomplete="new-password" data-val-equalto="@T("İki şifre aynı değil.", "Die Passwörter stimmen nicht überein.")" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                    <div>
                        <button type="button" class="adm-btn adm-btn--soft" data-generate-password="Password,ConfirmPassword"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>@T("Şifre oluştur", "Passwort erzeugen")</button>
                    </div>
                </div>
            </section>
        }
    </div>

    <aside class="adm-form__aside">
        <section class="adm-panel" style="--i:2">
            <div class="adm-panel__head">
                <span class="adm-panel__num">@(Model.IsSelf ? 2 : 3)</span>
                <div><h2>@T("Rol ve hesap", "Rolle und Konto")</h2></div>
            </div>
            <div class="adm-panel__body adm-panel__body--tight">
                <div class="adm-choices adm-choices--grid" style="grid-template-columns: 1fr">
                    @foreach (var role in Model.AllRoles)
                    {
                        var canChange = !lockedChoice && assignable.Contains(role);
                        <label class="adm-choice" title="@(canChange ? "" : T("Bu rolü değiştiremezsiniz.", "Diese Rolle können Sie nicht ändern."))">
                            <input type="checkbox" name="SelectedRoles" value="@role" @(Model.SelectedRoles.Contains(role) ? "checked" : "") @(canChange ? "" : "disabled") />
                            <span>@RoleName(role)@if (!canChange) { <i class="fa-solid fa-lock ms-auto" style="font-size:0.75rem; opacity:0.6" aria-hidden="true"></i> }</span>
                        </label>
                    }
                </div>
                @if (lockedChoice)
                {
                    <p class="adm-hint"><i class="fa-solid fa-circle-info" aria-hidden="true"></i>@(Model.IsSelf ? T("Kendi rolünüzü değiştiremezsiniz.", "Die eigene Rolle können Sie nicht ändern.") : T("Root hesabının rolleri değiştirilemez.", "Die Rollen des Root-Kontos sind fest."))</p>
                }
                <label class="adm-toggle">
                    <input type="checkbox" asp-for="EmailConfirmed" disabled="@(Model.IsSelf ? "disabled" : null)" />
                    <span class="adm-toggle__track" aria-hidden="true"></span>
                    <span class="adm-toggle__text">
                        <strong>@T("E-posta onaylı", "E-Mail bestätigt")</strong>
                        <small>@T("Kapalıysa kişi giriş yapamaz; e-postasındaki onay bağlantısını bekler.", "Wenn aus, kann sich die Person nicht anmelden, bis sie den Link in der E-Mail öffnet.")</small>
                    </span>
                </label>
                <label class="adm-toggle">
                    <input type="checkbox" asp-for="Lockout" disabled="@(lockedChoice ? "disabled" : null)" />
                    <span class="adm-toggle__track" aria-hidden="true"></span>
                    <span class="adm-toggle__text">
                        <strong>@T("Hesabı kilitle", "Konto sperren")</strong>
                        <small>@(lockedChoice
                            ? (Model.IsSelf ? T("Kendi hesabınızı kilitleyemezsiniz.", "Ihr eigenes Konto können Sie nicht sperren.") : T("Root hesabı kilitlenemez.", "Das Root-Konto kann nicht gesperrt werden."))
                            : T("Açıksa kişi giriş yapamaz. Bilgileri ve sonuçları silinmez; kilidi istediğiniz zaman kaldırabilirsiniz.", "Wenn an, kann sich die Person nicht anmelden. Daten und Ergebnisse bleiben; Sie können die Sperre jederzeit aufheben."))</small>
                    </span>
                </label>
            </div>
        </section>
        <div class="adm-savebar" style="margin-top:0">
            <a class="adm-btn adm-btn--ghost" href="@Url.Action(section.Action)">@T("Vazgeç", "Abbrechen")</a>
            <button type="submit" class="adm-btn adm-btn--primary" style="flex:1"><i class="fa-solid fa-check" aria-hidden="true"></i>@T("Kaydet", "Speichern")</button>
        </div>
    </aside>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
