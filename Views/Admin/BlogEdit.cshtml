@model SpeakingClub.Models.BlogEditModel
@* Admin → Blog yazıları → Düzenle. The form itself: _BlogForm.cshtml. *@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var section = AdminNav.Find("blogs", isGerman)!;
    ViewData["Title"] = T("Yazıyı düzenle", "Beitrag bearbeiten");
    ViewData["AdminSection"] = section.Key;
    var adminHeader = new AdminHeader("blog-form", string.IsNullOrWhiteSpace(Model.Title) ? T("Yazıyı düzenle", "Beitrag bearbeiten") : Model.Title,
        T("Değiştirmek istediğiniz sekmeye geçin, sonra kaydedin. Değişiklikler hemen sitede görünür.", "Wechseln Sie zum gewünschten Reiter und speichern Sie. Änderungen sind sofort online."),
        ParentTitle: section.Title, ParentHref: Url.Action(section.Action));
}
@section Css {
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/44.3.0/ckeditor5.css" />
    <link rel="stylesheet" href="~/css/ck.css" />
}

<partial name="_AdminHeader" model="adminHeader" />
<partial name="_BlogForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.ckeditor.com/ckeditor5/44.3.0/ckeditor5.umd.js"></script>
    <script src="https://cdn.ckeditor.com/ckeditor5/44.3.0/translations/@(isGerman ? "de" : "tr").umd.js"></script>
    <script src="~/js/ckeditor.js" asp-append-version="true"></script>
    <script src="~/js/admin-blog.js" asp-append-version="true"></script>
}
