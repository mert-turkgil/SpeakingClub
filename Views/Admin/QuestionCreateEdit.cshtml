@model QuestionEditViewModel
@*
    Admin → Sorular → Yeni / Düzenle. Answers A–D (more can be added); empty rows are skipped on save.
    The "correct" tick of an added answer posted "on" instead of "true" before, so a new correct answer could
    never be saved. Every tick now posts "true", with a hidden "false" after it for unticked rows.
*@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var isEdit = Model.QuestionId != 0;
    var section = AdminNav.Find("questions", isGerman)!;
    ViewData["Title"] = isEdit ? T("Soruyu düzenle", "Frage bearbeiten") : T("Yeni soru", "Neue Frage");
    ViewData["AdminSection"] = section.Key;
    const string letters = "ABCDEFGHIJ";
    var answersError = ViewData.ModelState.TryGetValue("Answers", out var answersEntry) && answersEntry.Errors.Count > 0;
}
@section Css {
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/44.3.0/ckeditor5.css" />
}

@{
    var adminHeader = new AdminHeader("question-form", isEdit ? T("Soruyu düzenle", "Frage bearbeiten") : T("Yeni soru", "Neue Frage"),
    T("Soruyu yazın, sınavını seçin, cevapları girin ve doğru olanı işaretleyin.", "Frage schreiben, Prüfung wählen, Antworten eintragen und die richtige markieren."),
    ParentTitle: section.Title, ParentHref: Url.Action(section.Action), Guide: isEdit ? null : section.Guide);
}
<partial name="_AdminHeader" model="adminHeader" />

<form method="post" asp-action="@(isEdit ? "QuestionEdit" : "QuestionCreate")" asp-route-id="@(isEdit ? Model.QuestionId : null)"
      enctype="multipart/form-data" class="adm-form" autocomplete="off" data-dirty-guard data-loading id="questionForm">
    @if (isEdit)
    {
        <input type="hidden" asp-for="QuestionId" />
    }
    <div class="adm-form__main">
        <partial name="_AdminErrors" />
        <section class="adm-panel" style="--i:0">
            <div class="adm-panel__head">
                <span class="adm-panel__num">1</span>
                <div><h2>@T("Soru", "Frage")</h2></div>
            </div>
            <div class="adm-panel__body">
                <div class="adm-field">
                    <label for="QuizId">@T("Hangi sınavın sorusu?", "Zu welcher Prüfung gehört die Frage?") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                    <select id="QuizId" name="QuizId" class="form-select @(ViewData.ModelState.TryGetValue("QuizId", out var qe) && qe.Errors.Count > 0 ? "input-validation-error" : "")">
                        <option value="0">@T("— Bir sınav seçin —", "— Prüfung wählen —")</option>
                        @foreach (var quiz in Model.AvailableQuizzes ?? Enumerable.Empty<SelectListItem>())
                        {
                            <option value="@quiz.Value" selected="@(quiz.Value == Model.QuizId.ToString() ? "selected" : null)">@quiz.Text</option>
                        }
                    </select>
                    @Html.ValidationMessage("QuizId")
                </div>
                <div class="adm-field adm-mini">
                    <label for="QuestionText">@T("Soru metni", "Fragetext") <span class="adm-req">@T("Zorunlu", "Pflicht")</span></label>
                    <textarea id="QuestionText" name="QuestionText" data-editor="mini" class="adm-input" placeholder="@T("ör. Wie ___ du? (heißen)", "z. B. Wie ___ du? (heißen)")"
                              data-val="true" data-val-required="@T("Lütfen soruyu yazın.", "Bitte schreiben Sie die Frage.")">@Model.QuestionText</textarea>
                    @Html.ValidationMessage("QuestionText")
                </div>
            </div>
        </section>

        <section class="adm-panel" style="--i:1">
            <div class="adm-panel__head">
                <span class="adm-panel__num">2</span>
                <div>
                    <h2>@T("Cevaplar", "Antworten")</h2>
                    <p>@T("Her satıra bir cevap yazın ve doğru olanın yanındaki kutuyu işaretleyin. Boş bıraktığınız satırlar kaydedilmez.", "Eine Antwort pro Zeile; markieren Sie die richtige. Leere Zeilen werden nicht gespeichert.")</p>
                </div>
            </div>
            <div class="adm-panel__body">
                @if (answersError)
                {
                    <div class="adm-alert adm-alert--error" style="padding:0.6rem 0.9rem"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>@Html.ValidationMessage("Answers")</div>
                }
                <div class="adm-answers" data-answers>
                    @for (var i = 0; i < Model.Answers.Count; i++)
                    {
                        var answer = Model.Answers[i];
                        var correct = answer.IsCorrect == "true";
                        <div class="adm-answer @(correct ? "is-correct" : "")" data-answer>
                            <span class="adm-answer__letter" data-letter>@letters[Math.Min(i, letters.Length - 1)]</span>
                            <input type="hidden" name="Answers[@i].AnswerId" value="@answer.AnswerId" />
                            <input type="text" name="Answers[@i].AnswerText" value="@answer.AnswerText" class="form-control" maxlength="200"
                                   placeholder="@T("Cevap", "Antwort") @letters[Math.Min(i, letters.Length - 1)]" aria-label="@T("Cevap", "Antwort") @letters[Math.Min(i, letters.Length - 1)]" />
                            <label class="adm-answer__ok">
                                <input type="checkbox" name="Answers[@i].IsCorrect" value="true" @(correct ? "checked" : "") data-correct />
                                <input type="hidden" name="Answers[@i].IsCorrect" value="false" />
                                @T("Doğru cevap", "Richtige Antwort")
                            </label>
                            <button type="button" class="adm-btn adm-btn--ghost adm-btn--sm adm-btn--icon" data-remove-answer aria-label="@T("Bu cevabı kaldır", "Diese Antwort entfernen")"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
                        </div>
                    }
                </div>
                <div>
                    <button type="button" class="adm-btn adm-btn--soft" data-add-answer><i class="fa-solid fa-plus" aria-hidden="true"></i>@T("Cevap ekle", "Antwort hinzufügen")</button>
                </div>
            </div>
        </section>
    </div>

    <aside class="adm-form__aside">
        <section class="adm-panel" style="--i:2">
            <div class="adm-panel__head">
                <span class="adm-panel__num">3</span>
                <div>
                    <h2>@T("Resim, ses veya video", "Bild, Audio oder Video")</h2>
                    <p>@T("Tamamen isteğe bağlı.", "Ganz freiwillig.")</p>
                </div>
            </div>
            <div class="adm-panel__body">
                <div class="adm-field">
                    <span class="adm-label"><i class="fa-regular fa-image" aria-hidden="true"></i>@T("Resim", "Bild")</span>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="adm-current"><img src="@Model.ImageUrl" alt="" /><small>@T("Şu anki resim. Yenisini seçerseniz yerini alır.", "Aktuelles Bild. Ein neues ersetzt es.")</small></div>
                    }
                    <label class="adm-drop" style="min-height:110px">
                        <input type="file" name="ImageFile" accept=".jpg,.jpeg,.png,.gif" data-max-mb="5" />
                        <span class="adm-drop__empty"><strong>@T("Resim seç", "Bild wählen")</strong><small>JPG, PNG, GIF · 5 MB</small></span>
                        <span class="adm-drop__preview"></span>
                    </label>
                    @Html.ValidationMessage("ImageFile")
                </div>
                <div class="adm-field">
                    <span class="adm-label"><i class="fa-solid fa-volume-high" aria-hidden="true"></i>@T("Ses dosyası", "Audiodatei")</span>
                    @if (!string.IsNullOrEmpty(Model.AudioUrl))
                    {
                        <div class="adm-current"><audio controls src="@Model.AudioUrl" style="width:100%"></audio><small>@T("Şu anki ses dosyası", "Aktuelle Audiodatei")</small></div>
                    }
                    <label class="adm-drop" style="min-height:110px">
                        <input type="file" name="AudioFile" accept=".mp3,.wav,.ogg,.m4a" data-max-mb="10" />
                        <span class="adm-drop__empty"><strong>@T("Ses dosyası seç", "Audiodatei wählen")</strong><small>MP3, WAV, OGG, M4A · 10 MB</small></span>
                        <span class="adm-drop__preview"></span>
                    </label>
                    @Html.ValidationMessage("AudioFile")
                </div>
                <div class="adm-field">
                    <label for="VideoUrl"><i class="fa-brands fa-youtube" aria-hidden="true"></i>@T("YouTube bağlantısı", "YouTube-Link")</label>
                    <input id="VideoUrl" name="VideoUrl" value="@Model.VideoUrl" class="adm-input" placeholder="https://www.youtube.com/watch?v=…" />
                    <p class="adm-hint">@T("Videonun adres çubuğundaki bağlantısını yapıştırmanız yeterli.", "Fügen Sie einfach den Link aus der Adresszeile des Videos ein.")</p>
                </div>
            </div>
        </section>
        <div class="adm-savebar" style="margin-top:0">
            <a class="adm-btn adm-btn--ghost" href="@Url.Action(section.Action)">@T("Vazgeç", "Abbrechen")</a>
            <button type="submit" class="adm-btn adm-btn--primary" style="flex:1"><i class="fa-solid fa-check" aria-hidden="true"></i>@T("Soruyu kaydet", "Frage speichern")</button>
        </div>
    </aside>
</form>

<template id="answer-template">
    <div class="adm-answer" data-answer>
        <span class="adm-answer__letter" data-letter></span>
        <input type="hidden" data-name="AnswerId" value="0" />
        <input type="text" data-name="AnswerText" class="form-control" maxlength="200" />
        <label class="adm-answer__ok">
            <input type="checkbox" data-name="IsCorrect" value="true" data-correct />
            <input type="hidden" data-name="IsCorrect" value="false" />
            @T("Doğru cevap", "Richtige Antwort")
        </label>
        <button type="button" class="adm-btn adm-btn--ghost adm-btn--sm adm-btn--icon" data-remove-answer aria-label="@T("Bu cevabı kaldır", "Diese Antwort entfernen")"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.ckeditor.com/ckeditor5/44.3.0/ckeditor5.umd.js"></script>
    <script>
        // Answers: add / remove rows, keep the A, B, C… letters and the Answers[i] names in order
        (function () {
            const list = document.querySelector('[data-answers]');
            const template = document.getElementById('answer-template');
            const letters = 'ABCDEFGHIJ';
            const word = @Json.Serialize(T("Cevap", "Antwort"));
            function renumber() {
                list.querySelectorAll('[data-answer]').forEach((row, i) => {
                    const letter = letters[Math.min(i, letters.length - 1)];
                    row.querySelector('[data-letter]').textContent = letter;
                    row.querySelectorAll('input').forEach((input) => {
                        const field = input.dataset.name || input.name.replace(/^Answers\[\d+\]\./, '');
                        input.dataset.name = field;
                        input.name = 'Answers[' + i + '].' + field;
                    });
                    const text = row.querySelector('input[type="text"]');
                    text.placeholder = word + ' ' + letter;
                    text.setAttribute('aria-label', word + ' ' + letter);
                });
            }
            document.querySelector('[data-add-answer]').addEventListener('click', () => {
                if (list.children.length >= letters.length) return;
                list.appendChild(template.content.firstElementChild.cloneNode(true));
                renumber();
                list.lastElementChild.querySelector('input[type="text"]').focus();
                window.admMarkDirty?.(list.closest('form'));
            });
            list.addEventListener('click', (e) => {
                const remove = e.target.closest('[data-remove-answer]');
                if (!remove) return;
                if (list.children.length <= 2) {
                    remove.closest('[data-answer]').querySelectorAll('input[type="text"]').forEach((i) => { i.value = ''; });
                    return;
                }
                remove.closest('[data-answer]').remove();
                renumber();
                window.admMarkDirty?.(list.closest('form'));
            });
            list.addEventListener('change', (e) => {
                if (e.target.matches('[data-correct]')) e.target.closest('[data-answer]').classList.toggle('is-correct', e.target.checked);
            });
            renumber();
        })();
    </script>
}
