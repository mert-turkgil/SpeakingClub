@model ChangePasswordViewModel
@inject LanguageService _localization
@{
    ViewData["Title"] = _localization.GetKey("ChangePassword_Title");
    ViewData["jQuery"] = true;   // jQuery Validation (the layout loads jQuery only when asked)
    ViewData["Robots"] = "noindex, nofollow";
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
}
@section Css {
    <script>document.documentElement.classList.add('bp-js');</script>
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="site-page auth auth--single auth--register">
    <div class="auth__shell">
        <section class="auth__panel">
            <div class="auth__card">
                <a class="auth__back" asp-action="Account"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>@_localization.GetKey("MyAccount_Header")</a>
                <h1 class="auth__title">@_localization.GetKey("ChangePassword_Title")</h1>
                <p class="auth__lead">@T("Güçlü bir şifre seçin; bu cihazdaki oturumunuz açık kalır.", "Wählen Sie ein starkes Passwort; Sie bleiben auf diesem Gerät angemeldet.")</p>

                <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert--error" role="alert"></div>

                <form method="post" class="auth-form" data-auth-form novalidate>
                    <div class="auth-field">
                        <label asp-for="CurrentPassword">@_localization.GetKey("CurrentPassword")</label>
                        <div class="auth-input">
                            <i class="fa-solid fa-unlock" aria-hidden="true"></i>
                            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" placeholder="••••••••"
                                   data-val-required="@T("Mevcut şifrenizi girin.", "Bitte geben Sie Ihr aktuelles Passwort ein.")" />
                            <button type="button" class="auth-eye" data-toggle-password="CurrentPassword" aria-pressed="false"
                                    aria-label="@T("Şifreyi göster", "Passwort anzeigen")" data-label-show="@T("Şifreyi göster", "Passwort anzeigen")" data-label-hide="@T("Şifreyi gizle", "Passwort verbergen")">
                                <i class="fa-regular fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="CurrentPassword" class="auth-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="NewPassword">@_localization.GetKey("NewPassword")</label>
                        <div class="auth-input">
                            <i class="fa-solid fa-lock" aria-hidden="true"></i>
                            <input asp-for="NewPassword" type="password" autocomplete="new-password" placeholder="••••••••" aria-describedby="passwordRules"
                                   data-val-required="@T("Yeni bir şifre belirleyin.", "Bitte wählen Sie ein neues Passwort.")"
                                   data-val-minlength="@T("Şifre en az 8 karakter olmalı.", "Das Passwort muss mindestens 8 Zeichen lang sein.")" />
                            <button type="button" class="auth-eye" data-toggle-password="NewPassword" aria-pressed="false"
                                    aria-label="@T("Şifreyi göster", "Passwort anzeigen")" data-label-show="@T("Şifreyi göster", "Passwort anzeigen")" data-label-hide="@T("Şifreyi gizle", "Passwort verbergen")">
                                <i class="fa-regular fa-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="auth-strength" data-strength-for="NewPassword" data-score="0" role="meter" aria-valuemin="0" aria-valuemax="4" aria-valuenow="0" aria-label="@T("Şifre gücü", "Passwortstärke")">
                            <span></span><span></span><span></span><span></span>
                        </div>
                        <ul class="auth-rules" id="passwordRules" data-rules>
                            <li data-rule="length">@T("En az 8 karakter", "Mind. 8 Zeichen")</li>
                            <li data-rule="upper">@T("Büyük harf", "Großbuchstabe")</li>
                            <li data-rule="lower">@T("Küçük harf", "Kleinbuchstabe")</li>
                            <li data-rule="digit">@T("Rakam", "Ziffer")</li>
                        </ul>
                        <span class="auth-hint" data-caps-for="NewPassword"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>@T("Caps Lock açık", "Feststelltaste ist aktiv")</span>
                        <span asp-validation-for="NewPassword" class="auth-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="ConfirmNewPassword">@_localization.GetKey("ConfirmNewPassword")</label>
                        <div class="auth-input">
                            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                            <input asp-for="ConfirmNewPassword" type="password" autocomplete="new-password" placeholder="••••••••" data-match-for="NewPassword"
                                   data-val-required="@T("Yeni şifrenizi tekrar girin.", "Bitte wiederholen Sie das neue Passwort.")"
                                   data-val-equalto="@T("Şifreler eşleşmiyor.", "Die Passwörter stimmen nicht überein.")" />
                        </div>
                        <span asp-validation-for="ConfirmNewPassword" class="auth-error"></span>
                    </div>

                    <button type="submit" class="auth-submit">
                        <span class="auth-spinner" aria-hidden="true"></span>
                        @_localization.GetKey("UpdatePasswordButton")
                        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/blog.js" asp-append-version="true" defer></script>
    <script src="~/js/auth.js" asp-append-version="true" defer></script>
}
