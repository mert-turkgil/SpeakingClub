@model SpeakingClub.Models.QuizLobbyViewModel
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    string Pct(int? value) => value == null ? "–" : isGerman ? $"{value} %" : $"%{value}";
    string Tone(int score) => score >= 80 ? "good" : score >= 50 ? "mid" : "low";
    var quizzesPath = isGerman ? "/pruefungen" : "/sinavlar";
    var initial = string.IsNullOrEmpty(Model.StudentName) ? "?" : Model.StudentName.Substring(0, 1).ToUpper();
    var notice = TempData["QuizNotice"] as string;
    var hasQuestions = Model.QuestionCount > 0;
    var json = new System.Text.Json.JsonSerializerOptions { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Create(System.Text.Unicode.UnicodeRanges.All) };

    // System check texts for quiz.js ({0}, {1} are filled in by the script)
    var strings = new Dictionary<string, string>
    {
        ["fullscreenOk"] = T("Destekleniyor", "Unterstützt"),
        ["fullscreenNo"] = T("Desteklenmiyor – sekme değişiklikleri yine de kaydedilir", "Nicht unterstützt – Tab-Wechsel werden trotzdem erfasst"),
        ["online"] = T("Bağlı", "Verbunden"),
        ["offline"] = T("Bağlantı yok – cevaplar cihazda saklanır", "Keine Verbindung – Antworten werden lokal gespeichert"),
        ["storageOk"] = T("Kullanılabilir", "Verfügbar"),
        ["storageNo"] = T("Kapalı – yalnızca sunucuya kaydedilir", "Deaktiviert – nur Speicherung auf dem Server"),
        ["screenOk"] = T("{0}×{1} piksel", "{0}×{1} Pixel"),
        ["screenSmall"] = T("{0}×{1} – küçük ekran, yatay kullanım önerilir", "{0}×{1} – kleiner Bildschirm, Querformat empfohlen"),
        ["expired"] = T("Süre doldu", "Zeit abgelaufen")
    };
}
@section Css {
    <script>document.documentElement.classList.add('bp-js');</script>
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/quiz.css" asp-append-version="true" />
}

<div class="quiz-page ql" data-page="quiz-lobby" data-remaining="@Model.ActiveRemainingSeconds">
    <script type="application/json" id="lobbyStrings">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(strings, json))</script>
    <div class="bp-container">
        <nav aria-label="@T("Sayfa yolu", "Brotkrumen")">
            <ol class="qz-breadcrumb bp-enter">
                <li><a href="@quizzesPath">@T("Sınavlar", "Prüfungen")</a></li>
                <li aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        @if (!string.IsNullOrEmpty(notice))
        {
            <div class="qz-notice qz-notice--warn" role="status"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><span>@notice</span><button type="button" data-dismiss aria-label="@T("Kapat", "Schließen")">&times;</button></div>
        }

        <div class="ql-grid" style="margin-top: 1rem">
            <div class="ql-main">
                <article class="qz-card-surface ql-hero bp-enter" style="--bp-delay: 80ms">
                    <div class="ql-hero__media">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="" fetchpriority="high" />
                        }
                        else
                        {
                            <span class="qz-card__placeholder" aria-hidden="true">@(Model.Level ?? Model.Title.Substring(0, 1).ToUpper())</span>
                        }
                    </div>
                    <div class="ql-hero__body">
                        <div class="ql-hero__pills">
                            @if (Model.Level != null)
                            {
                                <span class="qz-level" data-level="@Model.Level">@Model.Level</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                            {
                                <span class="bp-chip" style="padding: 0.25rem 0.7rem; font-size: 0.75rem">@Model.CategoryName</span>
                            }
                        </div>
                        <h1 class="ql-hero__title">@Model.Title</h1>
                        <p class="ql-hero__teacher"><i class="fa-solid fa-chalkboard-user me-1" aria-hidden="true"></i>@Model.TeacherName</p>
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="ql-hero__desc">@Model.Description</p>
                        }
                    </div>
                </article>

                <div class="ql-facts">
                    <div class="ql-fact reveal"><i class="fa-solid fa-list-ol" aria-hidden="true"></i><strong>@Model.QuestionCount</strong><span>@T("soru", "Fragen")</span></div>
                    <div class="ql-fact reveal" style="--bp-delay: 60ms"><i class="fa-regular fa-clock" aria-hidden="true"></i><strong>@Model.TimeLimitMinutes @T("dk", "Min.")</strong><span>@T("süre sınırı", "Zeitlimit")</span></div>
                    <div class="ql-fact reveal" style="--bp-delay: 120ms"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><strong>@Model.MaxViolations</strong><span>@T("ihlal hakkı", "erlaubte Verstöße")</span></div>
                    <div class="ql-fact reveal" style="--bp-delay: 180ms"><i class="fa-solid fa-rotate" aria-hidden="true"></i><strong>@Model.AttemptCount</strong><span>@T("denemeniz", "Ihre Versuche")</span></div>
                </div>

                <section class="qz-card-surface ql-section reveal" aria-labelledby="rules-title">
                    <h2 id="rules-title"><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>@T("Sınav kuralları", "Prüfungsregeln")</h2>
                    <ul class="ql-rules">
                        <li><i class="fa-solid fa-hourglass-half" aria-hidden="true"></i><div><strong>@T("Süre, Başlat'a bastığınızda başlar", "Die Zeit läuft ab „Starten“")</strong><span>@T($"{Model.TimeLimitMinutes} dakikanız var. Sayfayı yenilemek süreyi durdurmaz; süre bitince cevaplarınız otomatik gönderilir.", $"Sie haben {Model.TimeLimitMinutes} Minuten. Neu laden hält die Zeit nicht an; bei Ablauf werden Ihre Antworten automatisch abgegeben.")</span></div></li>
                        <li><i class="fa-solid fa-expand" aria-hidden="true"></i><div><strong>@T("Tam ekran zorunludur", "Vollbild ist Pflicht")</strong><span>@T("Sınav tam ekranda yapılır. Tam ekrandan çıkmak bir ihlal olarak kaydedilir.", "Die Prüfung läuft im Vollbild. Das Verlassen des Vollbilds wird als Verstoß erfasst.")</span></div></li>
                        <li><i class="fa-solid fa-window-restore" aria-hidden="true"></i><div><strong>@T("Sekme veya uygulama değiştirmeyin", "Keinen Tab- oder App-Wechsel")</strong><span>@T("Başka bir sekmeye geçmek, kopyalamak veya yapıştırmak ihlal sayılır.", "Tab-Wechsel, Kopieren und Einfügen gelten als Verstoß.")</span></div></li>
                        <li><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><div><strong>@T($"{Model.MaxViolations}. ihlalde sınav sona erer", $"Beim {Model.MaxViolations}. Verstoß endet die Prüfung")</strong><span>@T("Her ihlalden sonra uyarılırsınız. Sınır dolduğunda sınav o ana kadarki cevaplarla gönderilir.", "Nach jedem Verstoß werden Sie gewarnt. Ist das Limit erreicht, wird mit den bisherigen Antworten abgegeben.")</span></div></li>
                        <li><i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i><div><strong>@T("Cevaplar otomatik kaydedilir", "Antworten werden automatisch gespeichert")</strong><span>@T("Bağlantınız koparsa cevaplarınız cihazınızda tutulur ve bağlantı gelince gönderilir.", "Bei Verbindungsabbruch bleiben Ihre Antworten auf dem Gerät und werden nachgereicht.")</span></div></li>
                        <li><i class="fa-solid fa-flag" aria-hidden="true"></i><div><strong>@T("Soruları işaretleyip dönebilirsiniz", "Fragen markieren und zurückkehren")</strong><span>@T("Soru gezgini cevapladığınız ve işaretlediğiniz soruları gösterir. Göndermeden önce bir özet görürsünüz.", "Die Fragenübersicht zeigt beantwortete und markierte Fragen. Vor der Abgabe sehen Sie eine Zusammenfassung.")</span></div></li>
                    </ul>
                </section>

                @if (!string.IsNullOrEmpty(Model.AudioUrl) || !string.IsNullOrEmpty(Model.YouTubeVideoUrl))
                {
                    <section class="qz-card-surface ql-section reveal" aria-labelledby="material-title">
                        <h2 id="material-title"><i class="fa-solid fa-headphones" aria-hidden="true"></i>@T("Sınav öncesi materyal", "Material vor der Prüfung")</h2>
                        <div class="ql-media">
                            @if (!string.IsNullOrEmpty(Model.AudioUrl))
                            {
                                <audio controls preload="none" src="@Model.AudioUrl"></audio>
                            }
                            @if (!string.IsNullOrEmpty(Model.YouTubeVideoUrl))
                            {
                                <iframe src="@Model.YouTubeVideoUrl" title="@T("Sınav videosu", "Prüfungsvideo")" loading="lazy" allowfullscreen></iframe>
                            }
                        </div>
                    </section>
                }
            </div>

            <aside class="ql-side">
                <div class="qz-card-surface ql-start bp-enter" style="--bp-delay: 160ms">
                    <h2>@(Model.ActiveAttemptId != null ? T("Sınavınız devam ediyor", "Ihre Prüfung läuft") : T("Sınava hazır mısınız?", "Bereit für die Prüfung?"))</h2>

                    <div class="ql-start__student">
                        <span class="ql-start__avatar" aria-hidden="true">@initial</span>
                        <div><small>@T("Sınava giren", "Prüfling")</small><strong>@Model.StudentName</strong></div>
                    </div>

                    @if (Model.ActiveAttemptId != null)
                    {
                        <div class="ql-resume" role="status">
                            <strong>@T("Kalan süre", "Verbleibende Zeit")</strong>
                            <span data-countdown>@(Model.ActiveRemainingSeconds / 60):@((Model.ActiveRemainingSeconds % 60).ToString("00"))</span>
                        </div>
                    }
                    else if (Model.BestScore.HasValue)
                    {
                        <div class="ql-history">
                            <span class="qz-ring" style="--value: @Model.BestScore" data-tone="@Tone(Model.BestScore.Value)" role="img" aria-label="@T("En iyi puan", "Bestes Ergebnis") @Pct(Model.BestScore)">
                                <svg viewBox="0 0 36 36" aria-hidden="true"><circle class="qz-ring__track" cx="18" cy="18" r="15.9" pathLength="100" /><circle class="qz-ring__bar" cx="18" cy="18" r="15.9" pathLength="100" /></svg>
                                <span class="qz-ring__label">@Model.BestScore</span>
                            </span>
                            <div>
                                <strong>@T("En iyi", "Bestes"): @Pct(Model.BestScore)</strong><br />
                                @T("Son", "Zuletzt"): @Pct(Model.LastScore) · <a asp-action="ReviewQuiz" asp-route-id="@Model.QuizId">@T("İncele", "Ansehen")</a>
                            </div>
                        </div>
                    }

                    <ul class="ql-checks" aria-label="@T("Sistem kontrolü", "Systemprüfung")">
                        <li data-check="fullscreen" data-state="pending"><i class="fa-solid fa-circle-notch" aria-hidden="true"></i><div>@T("Tam ekran desteği", "Vollbild-Unterstützung")<small data-detail></small></div></li>
                        <li data-check="online" data-state="pending"><i class="fa-solid fa-circle-notch" aria-hidden="true"></i><div>@T("İnternet bağlantısı", "Internetverbindung")<small data-detail></small></div></li>
                        <li data-check="storage" data-state="pending"><i class="fa-solid fa-circle-notch" aria-hidden="true"></i><div>@T("Otomatik kayıt (tarayıcı deposu)", "Autospeichern (Browser-Speicher)")<small data-detail></small></div></li>
                        <li data-check="screen" data-state="pending"><i class="fa-solid fa-circle-notch" aria-hidden="true"></i><div>@T("Ekran boyutu", "Bildschirmgröße")<small data-detail></small></div></li>
                    </ul>

                    @if (!hasQuestions)
                    {
                        <div class="qr-banner qr-banner--warn"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>@T("Bu sınavda henüz soru yok.", "Diese Prüfung enthält noch keine Fragen.")</span></div>
                    }
                    else
                    {
                        <form method="post" asp-action="BeginQuiz" data-begin-form>
                            <input type="hidden" name="quizId" value="@Model.QuizId" />
                            @if (Model.ActiveAttemptId == null)
                            {
                                <label class="ql-pledge">
                                    <input type="checkbox" data-pledge required />
                                    <span class="ql-pledge__box" aria-hidden="true"><i class="fa-solid fa-check"></i></span>
                                    <span class="ql-pledge__text">@T($"Ben, {Model.StudentName}, bu sınavı kimseden yardım almadan, not veya başka bir kaynak kullanmadan tek başıma tamamlayacağımı taahhüt ederim.", $"Ich, {Model.StudentName}, versichere, diese Prüfung ohne fremde Hilfe, Notizen oder andere Quellen allein abzulegen.")</span>
                                </label>
                                <button type="submit" class="bp-btn" data-start disabled><i class="fa-solid fa-play" aria-hidden="true"></i>@T("Sınavı başlat", "Prüfung starten")</button>
                                <p class="ql-start__note">@T("Başlat'a bastığınızda süre başlar ve sınav odası açılır.", "Mit „Starten“ beginnt die Zeit und der Prüfungsraum öffnet sich.")</p>
                            }
                            else
                            {
                                <button type="submit" class="bp-btn"><i class="fa-solid fa-play" aria-hidden="true"></i>@T("Sınava devam et", "Prüfung fortsetzen")</button>
                                <p class="ql-start__note">@T("Süreniz sınavdan çıkmış olsanız da işlemeye devam ediyor.", "Ihre Zeit läuft weiter, auch wenn Sie die Prüfung verlassen haben.")</p>
                            }
                        </form>
                    }
                </div>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/blog.js" asp-append-version="true" defer></script>
    <script src="~/js/quiz.js" asp-append-version="true" defer></script>
}
