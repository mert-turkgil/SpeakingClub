@* Brand panel of the login and sign-up pages (left half on desktop, a slim band on phones) *@
@{
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
}
<aside class="auth__brand" aria-label="@T("Almanca Konuş hakkında", "Über Almanca Konuş")">
    <span class="auth__blob auth__blob--a" aria-hidden="true"></span>
    <span class="auth__blob auth__blob--b" aria-hidden="true"></span>
    <span class="auth__blob auth__blob--c" aria-hidden="true"></span>

    <a class="auth__logo" href="@(isGerman ? "/de" : "/")">
        <span><img src="~/img/logo.svg" alt="" width="26" height="26" /></span>
        <span>@T("Almanca Konuş", "Sprich Deutsch")</span>
    </a>

    <div class="auth__pitch">
        <span class="bp-eyebrow"><i class="fa-solid fa-comments" aria-hidden="true"></i>@T("Online konuşma kulübü", "Online-Gesprächsclub")</span>
        <p class="auth__headline">@Html.Raw(T("Almancayı <em>konuşarak</em> öğrenin.", "Deutsch lernen – <em>im Gespräch</em>."))</p>
        <ul class="auth__perks">
            <li style="--i: 0"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>@T("Ücretsiz online seviye sınavları", "Kostenlose Online-Einstufungstests")</li>
            <li style="--i: 1"><i class="fa-solid fa-chart-line" aria-hidden="true"></i>@T("Sonuçlarınız ve ilerlemeniz tek yerde", "Ergebnisse und Fortschritt an einem Ort")</li>
            <li style="--i: 2"><i class="fa-solid fa-user-group" aria-hidden="true"></i>@T("4–6 kişilik konuşma grupları", "Gesprächsgruppen mit 4–6 Personen")</li>
            <li style="--i: 3"><i class="fa-solid fa-stethoscope" aria-hidden="true"></i>@T("Sağlık çalışanları için Klinik Almanca", "Klinisches Deutsch für Gesundheitsberufe")</li>
        </ul>
    </div>

    <figure class="auth__quote">
        <img src="~/img/SecondImageGoesForAboutMe.jpeg" alt="" width="52" height="52" loading="lazy" />
        <div>
            <blockquote>@T("“Amacım; Almancayı bir ders gibi değil, hayatın bir parçası olarak kullanabilmenizi sağlamak.”", "„Mein Ziel ist es, Ihnen zu ermöglichen, Deutsch nicht als Unterricht, sondern als Teil des Lebens zu nutzen.“")</blockquote>
            <figcaption>Suna Türkgil · @T("Almanca öğretmeni", "Deutschlehrerin")</figcaption>
        </div>
    </figure>
</aside>
