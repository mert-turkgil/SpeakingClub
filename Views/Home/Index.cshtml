@model IndexModel
@inject LanguageService Localizer
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersion
@{
    ViewData["Title"] ??= "Almanca Konuşma Kulübü"; // the controller sets the SEO title
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    string Key(string key) => Localizer.GetKey(key).Value;

    var blogListPath = isGerman ? "/beitraege" : "/yazilar";
    var quizzesPath = isGerman ? "/pruefungen" : "/sinavlar";
    var aboutPath = isGerman ? "/ueber-uns" : "/hakkimizda";
    var doctorsPath = isGerman ? "/aerztedeutsch" : "/hekim-almancasi";
    var nursesPath = isGerman ? "/pflegedeutsch" : "/hemsirelik-almancasi";

    var levels = new[] { "A1", "A2", "B1", "B2", "C1" };
    var shorts = new[]
    {
        "rc2WQ26x3ME", "Xr83xGCEA_U", "sTQWle9gtzs", "8qR-ptz53TU", "u4ZOGWZ1uZE", "wbhst8AgHdo", "euc6ko6NYDg",
        "E4VymzSDsK4", "ZD5mekHCQt8", "GSCndE0gpkE", "T__UufkqlcE", "dvkT1iu88-Q", "OG7vm0mAbuk"
    };
    var features = new[]
    {
        (Icon: "fa-award", Title: Key("ftheader1"), Body: Key("ftbody1")),
        (Icon: "fa-comments", Title: Key("ftheader2"), Body: Key("ftbody2")),
        (Icon: "fa-people-group", Title: Key("ftheader3"), Body: Key("ftbody3"))
    };
}
@section Css {
    <script>document.documentElement.classList.add('bp-js');</script>
    <link rel="preload" as="image" href="~/img/FirstImageThatGoesForTheIndex.jpeg" fetchpriority="high" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@@0,9..144,600;1,9..144,600&display=swap" />
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    @* Three.js for the slider transitions and the 3D clinical band (home-3d.js loads it only when needed).
       "<!script>" opts out of ASP.NET's ScriptTagHelper, which takes over type="importmap" and drops the attribute.
       Both build files carry a content hash (like asp-append-version) so browsers never reuse a stale copy;
       the second entry also catches three.module's own relative import of three.core. *@
    <!script type="importmap">
        {
            "imports": {
                "three": "@FileVersion.AddFileVersionToPath(Context.Request.PathBase, "/lib/three/build/three.module.min.js")",
                "/lib/three/build/three.core.min.js": "@FileVersion.AddFileVersionToPath(Context.Request.PathBase, "/lib/three/build/three.core.min.js")",
                "three/addons/": "/lib/three/examples/jsm/"
            }
        }
    </!script>
}

<div class="home-page"
     data-play-label="@T("Videoyu oynat", "Video abspielen")">

    <!-- Hero ------------------------------------------------------------- -->
    <section class="hp-hero">
        <div class="bp-container hp-hero__grid">
            <div class="hp-hero__copy">
                <span class="bp-eyebrow bp-enter"><span class="hp-flag" aria-hidden="true"></span>@Key("HeroSubtitle")</span>
                <h1 class="hp-hero__title bp-enter" style="--bp-delay: 80ms">
                    @if (isGerman)
                    {
                        <text>Deutsch lernen – <em>durch Sprechen.</em></text>
                    }
                    else
                    {
                        <text>Almancayı <em>konuşarak</em> öğrenin.</text>
                    }
                </h1>
                <p class="hp-hero__lead bp-enter" style="--bp-delay: 160ms">
                    @T("Almanya'da doğup büyüyen Suna Koç ile birebir ve grup konuşma dersleri. Sağlık profesyonelleri için klinik Almanca dahil, özgüvenle konuşmanız için.",
                       "Gesprächstraining mit Suna Koç, aufgewachsen in Deutschland: Einzel- und Gruppenunterricht – inklusive klinischem Deutsch für Gesundheitsberufe. Damit Sie selbstbewusst sprechen.")
                </p>
                <div class="hp-hero__actions bp-enter" style="--bp-delay: 240ms">
                    <a class="bp-btn" href="@quizzesPath">@Key("SeviyeniziÖlçün") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                    <a class="bp-btn bp-btn--ghost" href="@(aboutPath)#contact-form"><i class="fa-regular fa-paper-plane" aria-hidden="true"></i>@T("Bize yazın", "Schreiben Sie uns")</a>
                </div>
                <ul class="hp-hero__facts bp-enter" style="--bp-delay: 320ms">
                    <li><i class="fa-solid fa-medal" aria-hidden="true"></i>@T("20+ yıl deneyim", "20+ Jahre Erfahrung")</li>
                    <li><i class="fa-solid fa-user-group" aria-hidden="true"></i>@T("Birebir & grup", "Einzeln & in Gruppen")</li>
                    <li><i class="fa-solid fa-stethoscope" aria-hidden="true"></i>@Key("KlinikAlmanca")</li>
                </ul>
            </div>

            <div class="hp-hero__visual">
                <figure class="hp-portrait">
                    @* Responsive copies of FirstImageThatGoesForTheIndex.jpeg (the LCP image on phones) *@
                    <picture>
                        <source type="image/webp" srcset="/img/suna-hero-480.webp 480w, /img/suna-hero-800.webp 800w, /img/suna-hero-1200.webp 1200w" sizes="(min-width: 480px) 440px, calc(100vw - 2rem)" />
                        <img src="/img/suna-hero-800.jpg" srcset="/img/suna-hero-480.jpg 480w, /img/suna-hero-800.jpg 800w, /img/suna-hero-1200.jpg 1200w" sizes="(min-width: 480px) 440px, calc(100vw - 2rem)"
                             alt="@T("Suna Koç – Almanca konuşma koçu", "Suna Koç – Deutsch-Sprechcoach")" width="1200" height="1600" fetchpriority="high" decoding="async" />
                    </picture>
                </figure>
                <div class="hp-bubble hp-bubble--1" aria-hidden="true">Guten Tag! 👋</div>
                <div class="hp-bubble hp-bubble--2" aria-hidden="true">Wie geht es Ihnen?</div>
                <div class="hp-bubble hp-bubble--3" aria-hidden="true">Ich spreche Deutsch!</div>
                <div class="hp-hero__badge">
                    <span class="hp-hero__badge-icon" aria-hidden="true"><i class="fa-solid fa-microphone-lines"></i></span>
                    <span><strong>Suna Koç</strong><small>@T("Almanca konuşma koçu", "Deutsch-Sprechcoach")</small></span>
                </div>
            </div>
        </div>
    </section>

    <!-- Highlights (admin-managed carousel) -------------------------------- -->
    @await Component.InvokeAsync("Slide")

    <!-- Approach --------------------------------------------------------------- -->
    <section class="hp-section bp-container" aria-labelledby="hp-approach-title">
        <header class="hp-head reveal">
            <span class="bp-eyebrow">@T("Yaklaşımımız", "Unser Ansatz")</span>
            <h2 class="hp-head__title" id="hp-approach-title">@T("Konuşarak öğrenmek, hatadan korkmadan.", "Lernen durch Sprechen – ohne Angst vor Fehlern.")</h2>
        </header>
        <div class="hp-features">
            @for (var i = 0; i < features.Length; i++)
            {
                <article class="hp-feature reveal" style="--bp-delay: @(i * 90)ms">
                    <div class="hp-feature__top">
                        <span class="hp-feature__icon" aria-hidden="true"><i class="fa-solid @features[i].Icon"></i></span>
                        <span class="hp-feature__num" aria-hidden="true">0@(i + 1)</span>
                    </div>
                    <h3 class="hp-feature__title">@features[i].Title</h3>
                    <p class="hp-feature__text">@features[i].Body</p>
                </article>
            }
        </div>
    </section>

    <!-- Clinical German --------------------------------------------------------- -->
    <section class="hp-band hp-band--clinic" aria-labelledby="hp-clinic-title">
        @* 3D scene (speech bubbles, cross, capsule) drawn by home-3d.js; empty without WebGL *@
        <div class="hp-band__3d" data-clinic-3d aria-hidden="true"></div>
        <div class="bp-container hp-band__inner">
            <header class="hp-head reveal">
                <span class="bp-eyebrow hp-eyebrow--dark"><i class="fa-solid fa-staff-snake" aria-hidden="true"></i>@Key("KlinikAlmanca")</span>
                <h2 class="hp-head__title" id="hp-clinic-title">@T("Sağlık profesyonelleri için klinik Almanca", "Klinisches Deutsch für Gesundheitsberufe")</h2>
                <p class="hp-head__lead">@T("Anamnezden hasta devrine, FSP'den bakım dokümantasyonuna: klinikte gerçekten ihtiyaç duyduğunuz Almanca, örnek diyaloglarla.",
                                           "Von der Anamnese bis zur Übergabe, von der FSP bis zur Pflegedokumentation: das Deutsch, das Sie in der Klinik wirklich brauchen – mit Beispieldialogen.")</p>
            </header>
            <div class="hp-clinic">
                <article class="hp-clinic__card reveal">
                    <span class="hp-clinic__icon" aria-hidden="true"><i class="fa-solid fa-user-doctor"></i></span>
                    <h3 class="hp-clinic__title"><a href="@doctorsPath">@Key("FuerAerzte")</a></h3>
                    <p>@T("FSP hazırlığı, anamnez, hasta sunumu, Arztbrief ve klinik iletişim için kalıp ifadeler.",
                          "FSP-Vorbereitung, Anamnese, Patientenvorstellung, Arztbrief und Redemittel für die klinische Kommunikation.")</p>
                    <ul class="hp-clinic__tags" aria-label="@T("Konular", "Themen")">
                        <li>FSP</li><li>Anamnese</li><li>Patientenvorstellung</li><li>Arztbrief</li>
                    </ul>
                    <span class="hp-clinic__more" aria-hidden="true">@T("Keşfet", "Entdecken") <i class="fa-solid fa-arrow-right"></i></span>
                </article>
                <article class="hp-clinic__card reveal" style="--bp-delay: 90ms">
                    <span class="hp-clinic__icon" aria-hidden="true"><i class="fa-solid fa-user-nurse"></i></span>
                    <h3 class="hp-clinic__title"><a href="@nursesPath">@Key("FuerPflege")</a></h3>
                    <p>@T("Hasta ile iletişim, hasta devri (Übergabe), bakım dokümantasyonu ve günlük klinik diyaloglar.",
                          "Pflegekommunikation, Patientenübergabe, Pflegedokumentation und Dialoge aus dem Klinikalltag.")</p>
                    <ul class="hp-clinic__tags" aria-label="@T("Konular", "Themen")">
                        <li>Übergabe</li><li>Pflegekommunikation</li><li>Pflegedokumentation</li>
                    </ul>
                    <span class="hp-clinic__more" aria-hidden="true">@T("Keşfet", "Entdecken") <i class="fa-solid fa-arrow-right"></i></span>
                </article>
            </div>
        </div>
    </section>

    <!-- Levels ---------------------------------------------------------------- -->
    <section class="hp-section bp-container" aria-labelledby="hp-levels-title">
        <header class="hp-head hp-head--split reveal">
            <div>
                <span class="bp-eyebrow"><i class="fa-solid fa-chart-line" aria-hidden="true"></i>@T("Seviye testi", "Einstufungstest")</span>
                <h2 class="hp-head__title" id="hp-levels-title">@Key("Kurs")</h2>
            </div>
            <p class="hp-head__lead">@T("Kısa bir testle seviyenizi ölçün, size uygun yerden başlayın.", "Finden Sie mit einem kurzen Test heraus, wo Sie stehen – und starten Sie auf dem passenden Niveau.")</p>
        </header>
        <ol class="hp-levels">
            @for (var i = 0; i < levels.Length; i++)
            {
                var code = levels[i];
                <li class="hp-level reveal" style="--lv: @i; --bp-delay: @(i * 70)ms">
                    <div class="hp-level__meter" aria-hidden="true">
                        @for (var b = 0; b < levels.Length; b++)
                        {
                            <span class="@(b <= i ? "is-on" : "")"></span>
                        }
                    </div>
                    <span class="hp-level__code">@code</span>
                    <h3 class="hp-level__title"><a href="@quizzesPath/@code.ToLowerInvariant()">@Key($"Level_{code}_Title")</a></h3>
                    <p class="hp-level__text">@Key($"Level_{code}_Desc")</p>
                    <span class="hp-level__more" aria-hidden="true">@Key("TesteBasla") <i class="fa-solid fa-arrow-right"></i></span>
                </li>
            }
        </ol>
    </section>

    <!-- Quote ----------------------------------------------------------------- -->
    <section class="hp-section bp-container" aria-label="@T("Suna Koç'tan bir söz", "Ein Wort von Suna Koç")">
        <figure class="hp-quote reveal">
            <div class="hp-quote__media">
<picture>
                    <source type="image/webp" srcset="/img/suna-about-480.webp 480w, /img/suna-about-800.webp 800w, /img/suna-about-1200.webp 1200w" sizes="(min-width: 768px) 380px, calc(100vw - 2rem)" />
                    <img src="/img/suna-about-800.jpg" srcset="/img/suna-about-480.jpg 480w, /img/suna-about-800.jpg 800w, /img/suna-about-1200.jpg 1200w" sizes="(min-width: 768px) 380px, calc(100vw - 2rem)"
                         alt="" width="1200" height="1600" loading="lazy" decoding="async" />
                </picture>
            </div>
            <div class="hp-quote__body">
                <i class="fa-solid fa-quote-left hp-quote__mark" aria-hidden="true"></i>
                <blockquote class="hp-quote__text">@Key("qt1")</blockquote>
                <figcaption class="hp-quote__by">
                    <strong>Suna Koç</strong>
                    <span>@T("Almanca konuşma koçu", "Deutsch-Sprechcoach")</span>
                </figcaption>
                <div class="hp-quote__social">
                    <span class="bp-filters__label">@Key("FollowUs")</span>
                    <a href="https://www.youtube.com/channel/UCP0ZwNE7FazB7ndyiH_Knjg" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="bp-share__btn" style="--brand:#FF0000"><i class="fa-brands fa-youtube" aria-hidden="true"></i></a>
                    <a href="https://www.instagram.com/almanca_konus_sprachcoach?igsh=MWMzNzhlcm85Ym05YQ==" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="bp-share__btn" style="--brand:#DD2A7B"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
                    <a href="https://www.facebook.com/AlmancaKonusmaKulubu.Suna/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="bp-share__btn" style="--brand:#1877F2"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>
                </div>
            </div>
        </figure>
    </section>

    <!-- YouTube Shorts ---------------------------------------------------------- -->
    <section class="hp-band hp-band--shorts" aria-labelledby="hp-shorts-title">
        <div class="bp-container">
            <header class="hp-head hp-head--split reveal">
                <div>
                    <span class="bp-eyebrow hp-eyebrow--dark"><i class="fa-brands fa-youtube" aria-hidden="true"></i>YouTube</span>
                    <h2 class="hp-head__title" id="hp-shorts-title">@Key("ShortsTitle")</h2>
                    <p class="hp-head__lead mb-0">@Key("ShortsSubtitle")</p>
                </div>
                <div class="hp-rail-nav">
                    <button type="button" class="hp-rail-nav__btn" data-rail-prev aria-label="@T("Geri", "Zurück")"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button>
                    <button type="button" class="hp-rail-nav__btn" data-rail-next aria-label="@T("İleri", "Weiter")"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
                </div>
            </header>
        </div>
        <ul class="hp-shorts" data-rail>
            @for (var i = 0; i < shorts.Length; i++)
            {
                <li class="hp-short">
                    @* A thumbnail until clicked: 13 YouTube players at once made the page very slow *@
                    <button type="button" class="hp-short__play" data-yt="@shorts[i]" aria-label="@T("Videoyu oynat", "Video abspielen") (Shorts @(i + 1))">
                        <img src="https://i.ytimg.com/vi/@shorts[i]/oar2.jpg" alt="" loading="lazy" decoding="async"
                             onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/@shorts[i]/hqdefault.jpg'" />
                        <span class="hp-short__badge"><i class="fa-brands fa-youtube" aria-hidden="true"></i>Shorts</span>
                        <span class="hp-short__icon" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
                    </button>
                </li>
            }
        </ul>
        <div class="bp-container hp-shorts__foot">
            <a class="bp-btn bp-btn--light" href="https://www.youtube.com/channel/UCP0ZwNE7FazB7ndyiH_Knjg" target="_blank" rel="noopener noreferrer">
                <i class="fa-brands fa-youtube" aria-hidden="true"></i>@T("Kanala abone olun", "Kanal abonnieren")
            </a>
        </div>
    </section>

    <!-- Latest posts ------------------------------------------------------------ -->
    @if (Model.LatestPosts.Count > 0)
    {
        <section class="hp-section bp-container" aria-labelledby="hp-posts-title">
            <header class="hp-head hp-head--split reveal">
                <div>
                    <span class="bp-eyebrow"><i class="fa-solid fa-feather-pointed" aria-hidden="true"></i>Blog</span>
                    <h2 class="hp-head__title" id="hp-posts-title">@T("Blogdan son yazılar", "Neues aus dem Blog")</h2>
                </div>
                <a class="bp-btn bp-btn--ghost" href="@blogListPath">@T("Tüm yazılar", "Alle Beiträge") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </header>
            <div class="bp-grid">
                @for (var i = 0; i < Model.LatestPosts.Count; i++)
                {
                    <partial name="_BlogPostCard" model="Model.LatestPosts[i]" view-data='new ViewDataDictionary(ViewData) { ["HeadingTag"] = "h3", ["Delay"] = i * 90 }' />
                }
            </div>
        </section>
    }

    <!-- Call to action ---------------------------------------------------------- -->
    <section class="bp-container hp-cta-wrap">
        <div class="hp-cta reveal">
            <h2 class="hp-cta__title">@T("Almanca konuşmaya bugün başlayın.", "Fangen Sie heute an, Deutsch zu sprechen.")</h2>
            <p class="hp-cta__text">@T("Seviyenizi ölçün ya da bize yazın; size en uygun dersi birlikte planlayalım.", "Testen Sie Ihr Niveau oder schreiben Sie uns – gemeinsam planen wir den passenden Unterricht.")</p>
            <div class="hp-cta__actions">
                <a class="bp-btn" href="@quizzesPath">@Key("SeviyeniziÖlçün") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                <a class="bp-btn bp-btn--light" href="@(aboutPath)#contact-form"><i class="fa-regular fa-paper-plane" aria-hidden="true"></i>@T("Bize yazın", "Schreiben Sie uns")</a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/blog.js" asp-append-version="true" defer></script>
    <script src="~/js/home.js" asp-append-version="true" defer></script>
    <script type="module" src="~/js/home-3d.js" asp-append-version="true"></script>
}
