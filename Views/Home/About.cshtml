@using SpeakingClub.Models
@model AboutPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] ??= Model.PageTitle;
    ViewData["jQuery"] = true;   // jQuery Validation (the layout loads jQuery only when asked)
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var quizzesPath = isGerman ? "/pruefungen" : "/sinavlar";
    var faq = AboutFaqContent.Build(isGerman);
    var whatsappUrl = AboutFaqContent.WhatsAppUrl(AboutFaqContent.WhatsAppGreeting(isGerman));
    var json = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Create(System.Text.Unicode.UnicodeRanges.All)
    };
    var chatData = new
    {
        topics = faq,
        whatsapp = whatsappUrl,
        whatsappBase = "https://wa.me/" + AboutFaqContent.WhatsAppNumber + "?text=",
        strings = new Dictionary<string, string>
        {
            ["greeting"] = T("Merhaba, hoş geldiniz! 👋 Ben Suna'nın asistanıyım. Ne öğrenmek istersiniz?", "Hallo und willkommen! 👋 Ich bin Sunas Assistent. Was möchten Sie wissen?"),
            ["more"] = T("Başka bir sorunuz var mı?", "Haben Sie noch eine Frage?"),
            ["otherTopic"] = T("Başka bir konu", "Anderes Thema"),
            ["sameTopic"] = T("Bu konuda başka soru", "Weitere Fragen hierzu"),
            ["human"] = T("Bir insanla konuşmak istiyorum", "Ich möchte mit einem Menschen sprechen"),
            ["humanAnswer"] = T("Tabii! WhatsApp'tan yazın, mesajınızı Suna okuyup yanıtlıyor. İsterseniz e-posta ya da iletişim formunu da kullanabilirsiniz.", "Gern! Schreiben Sie per WhatsApp – Suna liest und beantwortet Ihre Nachricht. Alternativ per E-Mail oder Kontaktformular."),
            ["notFound"] = T("Bu soruya hazır bir yanıtım yok. Sorunuzu doğrudan Suna'ya iletebilirsiniz:", "Darauf habe ich keine fertige Antwort. Sie können Ihre Frage direkt an Suna senden:"),
            ["askOnWhatsApp"] = T("Bu soruyu WhatsApp'tan sor", "Diese Frage per WhatsApp stellen"),
            ["maybe"] = T("Şunu mu demek istediniz?", "Meinten Sie vielleicht:"),
            ["typing"] = T("yazıyor…", "schreibt…"),
            ["you"] = T("Siz", "Sie")
        }
    };

    // FAQPage structured data (Google rich results) from the same content
    var faqSchema = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = faq.SelectMany(t => t.Items).Select(i => new Dictionary<string, object>
        {
            ["@type"] = "Question",
            ["name"] = i.Question,
            ["acceptedAnswer"] = new Dictionary<string, object> { ["@type"] = "Answer", ["text"] = i.Answer }
        }).ToList()
    };
    ViewData["ArticleSchema"] = "<script type=\"application/ld+json\">" + System.Text.Json.JsonSerializer.Serialize(faqSchema, json) + "</script>";
}
@section Css {
    <script>document.documentElement.classList.add('bp-js');</script>
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}

<div class="site-page about">

    @* ---------------- Hero ---------------- *@
    <section class="ab-hero">
        <div class="bp-container ab-hero__grid">
            <div class="ab-hero__text">
                <span class="bp-eyebrow bp-enter"><i class="fa-solid fa-hand-sparkles" aria-hidden="true"></i>@Model.AboutSection.Title</span>
                <h1 class="ab-hero__title bp-enter" style="--bp-delay: 80ms">@Html.Raw(T("Merhaba, ben <em>Suna</em>.", "Hallo, ich bin <em>Suna</em>."))</h1>
                <p class="ab-hero__lead bp-enter" style="--bp-delay: 160ms">@T("Bremen'de doğup büyüdüm; Almanca ana dilim. Almancayı anlıyor ama konuşurken zorlanıyorsanız, yalnız değilsiniz — birlikte özgüvenle konuşmaya başlayalım.", "Ich bin in Bremen aufgewachsen, Deutsch ist meine Muttersprache. Wenn Sie Deutsch verstehen, aber beim Sprechen zögern, sind Sie nicht allein – lassen Sie uns gemeinsam selbstbewusst sprechen.")</p>
                <div class="ab-hero__cta bp-enter" style="--bp-delay: 240ms">
                    <a class="bp-btn" href="#faq"><i class="fa-regular fa-comments" aria-hidden="true"></i>@T("Sorularınızı yanıtlayalım", "Ihre Fragen beantwortet")</a>
                    <a class="bp-btn bp-btn--ghost" href="#contact-form">@T("İletişime geçin", "Kontakt aufnehmen")<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
                <ul class="ab-hero__facts bp-enter" style="--bp-delay: 320ms">
                    <li><i class="fa-solid fa-globe" aria-hidden="true"></i>@T("Online dersler", "Online-Unterricht")</li>
                    <li><i class="fa-solid fa-school" aria-hidden="true"></i>@T("Devlet ve özel okul deneyimi", "Staatliche & private Schulen")</li>
                    <li><i class="fa-solid fa-user-group" aria-hidden="true"></i>@T("4–6 kişilik gruplar", "Gruppen mit 4–6 Personen")</li>
                    <li><i class="fa-solid fa-stethoscope" aria-hidden="true"></i>@T("Klinik Almanca", "Klinisches Deutsch")</li>
                </ul>
            </div>
            <figure class="ab-hero__media bp-enter" style="--bp-delay: 120ms">
                <span class="ab-hero__ring" aria-hidden="true"></span>
                <div class="ab-hero__frame">
                    <picture>
                        <source type="image/webp" srcset="/img/suna-about-480.webp 480w, /img/suna-about-800.webp 800w, /img/suna-about-1200.webp 1200w" sizes="(min-width: 576px) 420px, calc(100vw - 2rem)" />
                        <img src="/img/suna-about-800.jpg" srcset="/img/suna-about-480.jpg 480w, /img/suna-about-800.jpg 800w, /img/suna-about-1200.jpg 1200w" sizes="(min-width: 576px) 420px, calc(100vw - 2rem)"
                             alt="@Model.HeroSection.ImageAlt" width="1200" height="1600" fetchpriority="high" decoding="async" />
                    </picture>
                </div>
                <span class="ab-float ab-float--a"><i class="fa-solid fa-language" aria-hidden="true"></i>@T("Ana dili Almanca", "Muttersprache Deutsch")</span>
                <span class="ab-float ab-float--b"><i class="fa-solid fa-microphone-lines" aria-hidden="true"></i>@T("Konuşma odaklı", "Sprechen im Fokus")</span>
            </figure>
        </div>
    </section>

    @* ---------------- Story ---------------- *@
    <section class="ab-story" aria-labelledby="story-title">
        <div class="bp-container ab-story__grid">
            <aside class="ab-story__aside reveal">
                <span class="bp-eyebrow"><i class="fa-solid fa-feather" aria-hidden="true"></i>@T("Hikayem", "Meine Geschichte")</span>
                <h2 id="story-title" class="ab-h2">@T("Dili bir ders gibi değil, hayatın bir parçası olarak", "Sprache nicht als Fach, sondern als Teil des Lebens")</h2>
                <blockquote class="ab-quote">
                    <i class="fa-solid fa-quote-left" aria-hidden="true"></i>
                    <p>@T("Amacım; Almancayı bir ders gibi değil, hayatın bir parçası olarak kullanabilmenizi sağlamak.", "Mein Ziel ist es, Ihnen zu ermöglichen, Deutsch nicht als Unterricht, sondern als Teil des Lebens zu nutzen.")</p>
                    <cite class="ab-quote__by">Suna Türkgil</cite>
                </blockquote>
            </aside>
            <div class="ab-story__body">
                <p class="ab-lead reveal">@Html.Raw(Model.AboutSection.Paragraph1)</p>
                <p class="reveal">@Html.Raw(Model.AboutSection.Paragraph2)</p>
                <p class="reveal">@Html.Raw(Model.AboutSection.Paragraph3)</p>
                <p class="reveal">@Html.Raw(Model.AboutSection.Paragraph4)</p>
                <p class="reveal">@Html.Raw(Model.AboutSection.Paragraph5)</p>
            </div>
        </div>
    </section>

    @* ---------------- How it works ---------------- *@
    <section class="ab-steps" aria-labelledby="steps-title">
        <div class="bp-container">
            <div class="ab-section-head reveal">
                <span class="bp-eyebrow"><i class="fa-solid fa-route" aria-hidden="true"></i>@T("Süreç", "Ablauf")</span>
                <h2 id="steps-title" class="ab-h2">@Model.ProcessSection.Title</h2>
            </div>
            <ol class="ab-steps__list">
                @for (var i = 0; i < Model.ProcessSection.Steps.Count; i++)
                {
                    var step = Model.ProcessSection.Steps[i];
                    var href = step.Id == 1 ? quizzesPath : step.Id >= 4 ? "#faq" : "#contact-form";
                    <li class="ab-step reveal" style="--bp-delay: @(i * 80)ms">
                        <a href="@href">
                            <span class="ab-step__num" aria-hidden="true">@((i + 1).ToString("00"))</span>
                            <span class="ab-step__icon" aria-hidden="true"><i class="@step.IconClass"></i></span>
                            <strong>@step.Title</strong>
                            <span class="ab-step__text">@step.Description</span>
                            <span class="ab-step__more">@T("Detay", "Mehr")<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                        </a>
                    </li>
                }
            </ol>
        </div>
    </section>

    @* ---------------- FAQ concierge ---------------- *@
    <section class="ab-faq" id="faq" aria-labelledby="faq-title">
        <div class="bp-container ab-faq__grid">
            <div class="ab-faq__intro reveal">
                <span class="bp-eyebrow"><i class="fa-regular fa-circle-question" aria-hidden="true"></i>@T("SSS", "FAQ")</span>
                <h2 id="faq-title" class="ab-h2">@Model.FAQSection.Title</h2>
                <p>@T("Merak ettiğiniz konuyu seçin ya da sorunuzu yazın; yanıt hemen gelsin. Aradığınızı bulamazsanız tek dokunuşla WhatsApp'tan sorun.", "Wählen Sie ein Thema oder tippen Sie Ihre Frage – die Antwort kommt sofort. Nicht dabei? Dann fragen Sie mit einem Tipp per WhatsApp.")</p>
                <ul class="ab-faq__points">
                    <li><i class="fa-solid fa-bolt" aria-hidden="true"></i>@T("Anında yanıt, beklemek yok", "Sofort eine Antwort, ohne Warten")</li>
                    <li><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>@T("Kendi sorunuzu yazarak arayın", "Eigene Frage eintippen und suchen")</li>
                    <li><i class="fa-brands fa-whatsapp" aria-hidden="true"></i>@T("Gerekirse doğrudan Suna'ya ulaşın", "Bei Bedarf direkt an Suna")</li>
                </ul>
            </div>

            <div class="concierge reveal" data-concierge style="--bp-delay: 120ms">
                <script type="application/json" id="conciergeData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(chatData, json))</script>
                <header class="concierge__head">
                    <span class="concierge__avatar"><picture><source type="image/webp" srcset="/img/suna-avatar-96.webp" /><img src="/img/suna-avatar-96.jpg" alt="" width="44" height="44" loading="lazy" /></picture></span>
                    <div class="concierge__who">
                        <strong>@T("Almanca Konuş", "Sprich Deutsch")</strong>
                        <small><span class="concierge__dot" aria-hidden="true"></span>@T("Sık sorulan sorular · anında yanıt", "Häufige Fragen · sofortige Antwort")</small>
                    </div>
                    <button type="button" class="concierge__restart" data-restart aria-label="@T("Baştan başla", "Neu starten")" title="@T("Baştan başla", "Neu starten")"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i></button>
                    <div class="concierge__progress" aria-hidden="true"><span></span><span></span><span></span></div>
                </header>

                <div class="concierge__log" data-log role="log" aria-live="polite" aria-label="@T("Sohbet", "Chat")">
                    @* Without JavaScript (and for search engines) every question is listed with its answer *@
                    <div class="concierge__fallback">
                        @foreach (var topic in faq)
                        {
                            <h3><i class="@topic.Icon" aria-hidden="true"></i>@topic.Title</h3>
                            @foreach (var item in topic.Items)
                            {
                                <details>
                                    <summary>@item.Question</summary>
                                    <p>@item.Answer</p>
                                </details>
                            }
                        }
                    </div>
                </div>

                <form class="concierge__input" data-ask autocomplete="off">
                    <label for="conciergeQuestion" class="bp-sr-only">@T("Sorunuzu yazın", "Ihre Frage")</label>
                    <input id="conciergeQuestion" type="text" maxlength="300" placeholder="@T("Sorunuzu yazın…", "Ihre Frage eingeben…")" />
                    <button type="submit" aria-label="@T("Gönder", "Senden")"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i></button>
                </form>
                <footer class="concierge__foot">
                    @T("Yanıt bulamadınız mı?", "Keine Antwort gefunden?") <a href="@whatsappUrl" target="_blank" rel="noopener"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i>@T("WhatsApp'tan yazın", "Per WhatsApp schreiben")</a>
                </footer>
            </div>
        </div>
    </section>

    @* ---------------- Contact ---------------- *@
    <section id="contact-form" class="ab-contact" aria-labelledby="contact-title">
        <div class="bp-container ab-contact__grid">
            <div class="ab-contact__intro reveal">
                <span class="bp-eyebrow"><i class="fa-regular fa-envelope" aria-hidden="true"></i>@T("İletişim", "Kontakt")</span>
                <h2 id="contact-title" class="ab-h2">@Model.ContactSection.Title</h2>
                <p>@T("Mevcut seviyenizi, müsait olduğunuz zamanları ve hedeflerinizi yazın; size en uygun programı birlikte belirleyelim.", "Schreiben Sie mir Ihr Niveau, Ihre Verfügbarkeit und Ihre Ziele – gemeinsam finden wir das passende Programm.")</p>

                <a class="ab-wa" href="@whatsappUrl" target="_blank" rel="noopener">
                    <span class="ab-wa__icon" aria-hidden="true"><i class="fa-brands fa-whatsapp"></i></span>
                    <span class="ab-wa__text">
                        <strong>@T("WhatsApp'tan yazın", "Per WhatsApp schreiben")</strong>
                        <small>@T("En hızlı yol", "Der schnellste Weg") · +49 160 3866222</small>
                    </span>
                    <i class="fa-solid fa-arrow-up-right-from-square ab-wa__go" aria-hidden="true"></i>
                </a>

                <ul class="ab-contact__list">
                    <li><a href="mailto:@AboutFaqContent.Email"><span aria-hidden="true"><i class="fa-regular fa-envelope"></i></span><span><small>@T("E-posta", "E-Mail")</small>@AboutFaqContent.Email</span></a></li>
                    <li><a href="tel:+491603866222"><span aria-hidden="true"><i class="fa-solid fa-phone"></i></span><span><small>@T("Telefon", "Telefon")</small>+49 160 3866222</span></a></li>
                    <li><div><span aria-hidden="true"><i class="fa-solid fa-globe"></i></span><span><small>@T("Dersler", "Unterricht")</small>@T("Online", "Online")</span></div></li>
                </ul>
            </div>

            <div class="ab-contact__card reveal" style="--bp-delay: 120ms">
                <form method="post" asp-controller="Home" asp-action="Contact" id="contactForm" class="ab-form">
                    @Html.AntiForgeryToken()
                    @* Bot detection: hidden fields a person never fills in *@
                    <input type="text" name="honeypot" style="display:none" autocomplete="off" tabindex="-1" />
                    <input type="text" name="phone" style="display:none" autocomplete="off" tabindex="-1" />
                    <input type="text" name="website" style="display:none" autocomplete="off" tabindex="-1" />
                    <input type="hidden" name="_ts" id="contactTs" />
                    <div asp-validation-summary="All" class="ab-form__errors"></div>

                    <div class="ab-form__row">
                        <div class="ab-field">
                            <label asp-for="ContactForm.Name">@Model.ContactSection.NameLabel</label>
                            <div class="ab-input"><i class="fa-regular fa-user" aria-hidden="true"></i><input asp-for="ContactForm.Name" autocomplete="name" required placeholder="@T("Adınız ve soyadınız", "Ihr Vor- und Nachname")" /></div>
                            <span asp-validation-for="ContactForm.Name" class="ab-error"></span>
                        </div>
                        <div class="ab-field">
                            <label asp-for="ContactForm.Email">@Model.ContactSection.EmailLabel</label>
                            <div class="ab-input"><i class="fa-regular fa-envelope" aria-hidden="true"></i><input asp-for="ContactForm.Email" type="email" autocomplete="email" required placeholder="@T("ornek@eposta.com", "beispiel@email.de")" /></div>
                            <span asp-validation-for="ContactForm.Email" class="ab-error"></span>
                        </div>
                    </div>

                    <div class="ab-field">
                        <label asp-for="ContactForm.Message">@Model.ContactSection.MessageLabel</label>
                        <div class="ck-editor-wrapper">
                            <textarea asp-for="ContactForm.Message" class="form-control" id="messageEditor" rows="5" required></textarea>
                            <div class="ck-word-count-bar"><span id="ck-word-count">0 @T("kelime", "Wörter")</span></div>
                        </div>
                        <span asp-validation-for="ContactForm.Message" class="ab-error"></span>
                    </div>

                    <div id="turnstile-widget" class="ab-turnstile"></div>

                    <button type="submit" class="ab-submit">
                        <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>@Model.ContactSection.ButtonText
                    </button>
                </form>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/blog.js" asp-append-version="true" defer></script>
    <script src="~/js/about-chat.js" asp-append-version="true" defer></script>
    <script>
        window.onloadTurnstileAbout = function () {
            if (!document.getElementById('turnstile-widget') || !window.turnstile) return;
            turnstile.render('#turnstile-widget', {
                sitekey: '@ViewBag.TurnstileSiteKey',
                theme: document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'dark' : 'light'
            });
        };
        // Bot detection for the contact form: timestamp + honeypot
        document.addEventListener('DOMContentLoaded', function () {
            var ts = document.getElementById('contactTs');
            if (ts) ts.value = Date.now();
            var form = document.getElementById('contactForm');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                var trapped = ['honeypot', 'phone', 'website'].some(function (name) {
                    var field = form.querySelector('input[name="' + name + '"]');
                    return field && field.value;
                });
                if (trapped) e.preventDefault();
            });
        });
    </script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadTurnstileAbout&render=explicit" defer></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js" asp-append-version="true"></script>

    <script src="https://cdn.ckeditor.com/ckeditor5/44.3.0/ckeditor5.umd.js"></script>
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/44.3.0/ckeditor5.css" />
    <script type="module">
        const { ClassicEditor, Essentials, Bold, Italic, Underline, Strikethrough, Font, Paragraph, Heading, Link, List, BlockQuote, Alignment, Indent, IndentBlock, Undo, WordCount } = window.CKEDITOR;
        let editorInstance;
        ClassicEditor
            .create(document.querySelector('#messageEditor'), {
                licenseKey: '@ViewBag.CKEditorLicenseKey',
                plugins: [Essentials, Bold, Italic, Underline, Strikethrough, Font, Paragraph, Heading, Link, List, BlockQuote, Alignment, Indent, IndentBlock, Undo, WordCount],
                toolbar: {
                    items: ['bold', 'italic', 'underline', '|', 'link', 'bulletedList', 'numberedList', '|', 'blockQuote', '|', 'undo', 'redo'],
                    shouldNotGroupWhenFull: true
                },
                wordCount: {
                    onUpdate: stats => {
                        const el = document.getElementById('ck-word-count');
                        if (el) el.textContent = stats.words + ' ' + @Json.Serialize(T("kelime", "Wörter"));
                    }
                },
                placeholder: @Json.Serialize(Model.ContactSection.MessagePlaceholder ?? Model.ContactSection.MessageLabel),
                language: @Json.Serialize(System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName)
            })
            .then(editor => {
                editorInstance = editor;
                // The textarea carries the message; keep it in sync before the form posts
                document.getElementById('contactForm')?.addEventListener('submit', () => {
                    document.querySelector('#messageEditor').value = editorInstance.getData();
                });
            })
            .catch(error => console.error('CKEditor initialization error:', error));
    </script>
}
