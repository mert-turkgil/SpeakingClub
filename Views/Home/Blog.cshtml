@model SpeakingClub.Models.BlogFilterViewModel
@{
    // Title, description, canonical, robots and hreflang come from HomeController.Blog.
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;

    // List URL with only the filters that are set, so every filter combination has one URL
    string ListUrl(string? category = null, string? tag = null, string? search = null, int page = 1)
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(category)) query.Add("category=" + Uri.EscapeDataString(category));
        if (!string.IsNullOrWhiteSpace(tag)) query.Add("tag=" + Uri.EscapeDataString(tag));
        if (!string.IsNullOrWhiteSpace(search)) query.Add("searchTerm=" + Uri.EscapeDataString(search));
        if (page > 1) query.Add("page=" + page);
        return Model.BlogListPath + (query.Count > 0 ? "?" + string.Join("&", query) : "");
    }

    var showFeatured = !Model.IsFiltered && Model.CurrentPage == 1 && Model.Posts.Count > 0;
    var featured = showFeatured ? Model.Posts[0] : null;
    var gridPosts = showFeatured ? Model.Posts.Skip(1).ToList() : Model.Posts;

    // Pages to show: first, last and the two around the current one; null = gap
    var pages = new List<int?>();
    for (var p = 1; p <= Model.TotalPages; p++)
    {
        if (p == 1 || p == Model.TotalPages || Math.Abs(p - Model.CurrentPage) <= 1)
            pages.Add(p);
        else if (pages.Count > 0 && pages[^1] != null)
            pages.Add(null);
    }

    // Blog + its posts as structured data (unfiltered pages only)
    string? schemaJson = null;
    if (!Model.IsFiltered && Model.Posts.Count > 0)
    {
        var schema = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Blog",
            ["name"] = T("Almanca Konuş Blog", "Almanca Konuş Blog"),
            ["description"] = Model.BlogList_Description,
            ["url"] = SeoHelper.SiteUrl + Model.BlogListPath,
            ["inLanguage"] = isGerman ? "de" : "tr",
            ["blogPost"] = Model.Posts.Select(p => new Dictionary<string, object?>
            {
                ["@type"] = "BlogPosting",
                ["headline"] = p.Title,
                ["url"] = SeoHelper.SiteUrl + p.Href,
                ["datePublished"] = p.Date.ToString("yyyy-MM-dd"),
                ["image"] = string.IsNullOrEmpty(p.Image) ? null : SeoHelper.SiteUrl + p.Image,
                ["author"] = string.IsNullOrEmpty(p.Author) ? null : new Dictionary<string, object?> { ["@type"] = "Person", ["name"] = p.Author }
            }).ToList()
        };
        schemaJson = System.Text.Json.JsonSerializer.Serialize(schema, new System.Text.Json.JsonSerializerOptions
        {
            Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Create(System.Text.Unicode.UnicodeRanges.All),
            DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
        });
    }
}

@section Css {
    <script>document.documentElement.classList.add('bp-js');</script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@@0,9..144,600;1,9..144,600&display=swap" />
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
    @if (schemaJson != null)
    {
        <script type="application/ld+json">@Html.Raw(schemaJson)</script>
    }
}

<div class="blog-page blog-index">
    <header class="bp-hero">
        <div class="bp-container">
            <span class="bp-eyebrow bp-enter"><i class="fa-solid fa-feather-pointed" aria-hidden="true"></i>@Model.BlogList_Title</span>
            <h1 class="bp-hero__title bp-enter" style="--bp-delay: 80ms">
                @if (isGerman)
                {
                    <text>Blog zum <em>Deutschlernen</em></text>
                }
                else
                {
                    <text>Almanca Öğrenme <em>Blogu</em></text>
                }
            </h1>
            @if (!string.IsNullOrWhiteSpace(Model.BlogList_Description))
            {
                <p class="bp-hero__lead bp-enter" style="--bp-delay: 160ms">@Model.BlogList_Description</p>
            }

            <form class="bp-search bp-enter" style="--bp-delay: 240ms" method="get" action="@Model.BlogListPath" role="search">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <label for="blog-search" class="bp-sr-only">@Model.BlogList_SearchLabel</label>
                <input id="blog-search" type="search" name="searchTerm" value="@Model.SearchTerm"
                       placeholder="@T("Yazılarda ara…", "Beiträge durchsuchen…")" autocomplete="off" />
                @if (!string.IsNullOrWhiteSpace(Model.Category))
                {
                    <input type="hidden" name="category" value="@Model.Category" />
                }
                @if (!string.IsNullOrWhiteSpace(Model.Tag))
                {
                    <input type="hidden" name="tag" value="@Model.Tag" />
                }
                <button type="submit" class="bp-btn">@Model.BlogList_SearchLabel</button>
            </form>

            @if (Model.Categories.Count > 0 || Model.AvailableTags.Count > 0)
            {
                <nav class="bp-filters bp-enter" style="--bp-delay: 320ms" aria-label="@T("Yazıları filtrele", "Beiträge filtern")">
                    @if (Model.Categories.Count > 0)
                    {
                        <span class="bp-filters__label">@Model.BlogList_AllCategories</span>
                        <ul class="bp-chips">
                            <li><a class="bp-chip @(string.IsNullOrWhiteSpace(Model.Category) ? "is-active" : "")"
                                   href="@ListUrl(null, Model.Tag, Model.SearchTerm)">@T("Tümü", "Alle")</a></li>
                            @foreach (var category in Model.Categories)
                            {
                                var active = string.Equals(category, Model.Category, StringComparison.OrdinalIgnoreCase);
                                <li><a class="bp-chip @(active ? "is-active" : "")" aria-current="@(active ? "true" : null)"
                                       href="@ListUrl(active ? null : category, Model.Tag, Model.SearchTerm)">@category</a></li>
                            }
                        </ul>
                    }
                    @if (Model.AvailableTags.Count > 0)
                    {
                        <span class="bp-filters__label">@Model.BlogList_TagLabel</span>
                        <ul class="bp-chips">
                            @foreach (var tag in Model.AvailableTags)
                            {
                                var active = string.Equals(tag, Model.Tag, StringComparison.OrdinalIgnoreCase);
                                <li><a class="bp-chip @(active ? "is-active" : "")" aria-current="@(active ? "true" : null)"
                                       href="@ListUrl(Model.Category, active ? null : tag, Model.SearchTerm)"><i class="fa-solid fa-hashtag" aria-hidden="true"></i>@tag</a></li>
                            }
                        </ul>
                    }
                </nav>
            }
        </div>
    </header>

    <section class="bp-container" aria-label="@T("Yazılar", "Beiträge")">
        <div class="bp-results">
            @if (Model.IsFiltered)
            {
                <span>@Html.Raw(string.Format(T("<strong>{0}</strong> yazı bulundu", "<strong>{0}</strong> Beiträge gefunden"), Model.TotalBlogs))</span>
                <a href="@Model.BlogListPath"><i class="fa-solid fa-xmark me-1" aria-hidden="true"></i>@T("Filtreleri temizle", "Filter zurücksetzen")</a>
            }
            else
            {
                <span>@Html.Raw(string.Format(T("Toplam <strong>{0}</strong> yazı", "Insgesamt <strong>{0}</strong> Beiträge"), Model.TotalBlogs))</span>
                @if (Model.TotalPages > 1)
                {
                    <span>@string.Format(T("Sayfa {0} / {1}", "Seite {0} von {1}"), Model.CurrentPage, Model.TotalPages)</span>
                }
            }
        </div>

        @if (Model.Posts.Count == 0)
        {
            <div class="bp-empty reveal">
                <i class="fa-solid fa-book-open-reader" aria-hidden="true"></i>
                <h2>@T("Aradığınız yazıyı bulamadık", "Keine passenden Beiträge gefunden")</h2>
                <p class="mb-4">@T("Farklı bir kelime deneyin ya da tüm yazılara göz atın.", "Versuchen Sie ein anderes Wort oder sehen Sie sich alle Beiträge an.")</p>
                <a class="bp-btn" href="@Model.BlogListPath">@T("Tüm yazılar", "Alle Beiträge") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
        }
        else
        {
            @if (featured != null)
            {
                <div class="bp-featured">
                    <partial name="_BlogPostCard" model="featured" view-data='new ViewDataDictionary(ViewData) { ["Featured"] = true, ["HeadingTag"] = "h2" }' />
                </div>
            }

            @if (gridPosts.Count > 0)
            {
                <div class="bp-grid">
                    @for (var i = 0; i < gridPosts.Count; i++)
                    {
                        <partial name="_BlogPostCard" model="gridPosts[i]" view-data='new ViewDataDictionary(ViewData) { ["HeadingTag"] = "h2", ["Delay"] = (i % 3) * 90 }' />
                    }
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="@T("Sayfalar", "Seiten")">
                    <ul class="bp-pagination">
                        @if (Model.CurrentPage > 1)
                        {
                            <li><a href="@ListUrl(Model.Category, Model.Tag, Model.SearchTerm, Model.CurrentPage - 1)" rel="prev"
                                   aria-label="@T("Önceki sayfa", "Vorherige Seite")"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a></li>
                        }
                        @foreach (var p in pages)
                        {
                            if (p == null)
                            {
                                <li><span aria-hidden="true">…</span></li>
                            }
                            else if (p == Model.CurrentPage)
                            {
                                <li><span aria-current="page">@p</span></li>
                            }
                            else
                            {
                                <li><a href="@ListUrl(Model.Category, Model.Tag, Model.SearchTerm, p.Value)">@p</a></li>
                            }
                        }
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li><a href="@ListUrl(Model.Category, Model.Tag, Model.SearchTerm, Model.CurrentPage + 1)" rel="next"
                                   aria-label="@T("Sonraki sayfa", "Nächste Seite")"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></li>
                        }
                    </ul>
                </nav>
            }
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/blog.js" asp-append-version="true" defer></script>
}
