@using SpeakingClub.Models
@*
    Privacy policy (/gizlilik, /datenschutz). Written from what the code actually does; keep it in step when a
    feature that touches personal data changes (sign-in, exams, downloads, contact form, dictionary, cookies,
    third-party services). Also linked from the Google sign-in consent screen.
    Almanca Konuş is Suna Koç's personal website, not a company: the text says so and names her as the person
    responsible. Frame (hero, contents, progress, print): _LegalLayout.cshtml.
*@
@{
    Layout = "_LegalLayout";
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    var contactEmail = "almancakonus.info@gmail.com";
    var aboutPath = isGerman ? "/ueber-uns" : "/hakkimizda";
    var termsPath = isGerman ? "/nutzungsbedingungen" : "/kullanim-kosullari";
    var sections = new (string Id, string Title)[]
    {
        ("sorumlu", T("Sorumlu kim?", "Wer ist verantwortlich?")),
        ("veriler", T("Hangi verileri, neden işliyoruz?", "Welche Daten wir verarbeiten und warum")),
        ("hukuki-sebep", T("Hukuki sebepler", "Rechtsgrundlagen")),
        ("cerezler", T("Çerezler ve tarayıcı depolama", "Cookies und Speicher im Browser")),
        ("hizmet-saglayicilar", T("Hizmet sağlayıcılar ve aktarım", "Dienstleister und Übermittlung")),
        ("google", T("Google ile giriş ve Google verileri", "Anmeldung mit Google und Google-Daten")),
        ("saklama", T("Ne kadar süre saklıyoruz?", "Wie lange wir Daten speichern")),
        ("haklar", T("Haklarınız", "Ihre Rechte")),
        ("guvenlik", T("Güvenlik", "Sicherheit")),
        ("cocuklar", T("Çocuklar", "Kinder")),
        ("degisiklikler", T("Değişiklikler ve iletişim", "Änderungen und Kontakt"))
    };
    ViewData["Legal"] = new LegalPage(
        Eyebrow: T("Gizlilik", "Datenschutz"),
        EyebrowIcon: "fa-shield-halved",
        Title: T("Gizlilik Politikası", "Datenschutzerklärung"),
        Lead: T("Almanca Konuş'u kullanırken hangi bilgilerinizin işlendiğini, neden işlendiğini ve bunlar üzerinde hangi haklara sahip olduğunuzu açık bir dille anlatıyoruz.",
                "Hier erklären wir verständlich, welche Daten bei der Nutzung von Almanca Konuş verarbeitet werden, warum, und welche Rechte Sie haben."),
        Updated: T("27 Ekim 2026", "27. Oktober 2026"),
        Sections: sections,
        OtherTitle: T("Kullanım Koşulları", "Nutzungsbedingungen"),
        OtherText: T("Hesap, sınavlar, sözlük ve içeriklerle ilgili kurallar", "Regeln zu Konto, Prüfungen, Wörterbuch und Inhalten"),
        OtherPath: termsPath,
        OtherIcon: "fa-file-lines");
}

<section class="legal-summary" aria-labelledby="legal-summary-title">
    <h2 id="legal-summary-title"><i class="fa-solid fa-circle-info" aria-hidden="true"></i>@T("Kısaca", "Das Wichtigste in Kürze")</h2>
    <ul>
        <li>@T("Almanca Konuş bir şirket değil; Almanca öğretmeni Suna Koç'un kişisel sitesidir.", "Almanca Konuş ist kein Unternehmen, sondern die persönliche Website der Deutschlehrerin Suna Koç.")</li>
        <li>@T("Yalnızca dersler, sınavlar ve iletişim için gereken bilgileri işliyoruz.", "Wir verarbeiten nur, was für Unterricht, Prüfungen und Kontakt nötig ist.")</li>
        <li>@T("Verilerinizi satmıyoruz, reklam için kullanmıyoruz; reklam ve takip çerezi yok.", "Wir verkaufen Ihre Daten nicht, nutzen sie nicht für Werbung und setzen keine Werbe- oder Tracking-Cookies.")</li>
        <li>@T("Şifreniz geri çevrilemez biçimde şifrelenerek saklanır; biz bile göremeyiz.", "Ihr Passwort wird unumkehrbar verschlüsselt gespeichert; auch wir können es nicht sehen.")</li>
        <li>@T("Hesabınızı istediğiniz an \"Hesabım\" sayfasından kendiniz silebilirsiniz.", "Sie können Ihr Konto jederzeit selbst auf der Seite \"Mein Konto\" löschen.")</li>
        <li>@Html.Raw(T($"Her soru ve talep için: <a href=\"mailto:{contactEmail}\">{contactEmail}</a>", $"Für alle Fragen und Anliegen: <a href=\"mailto:{contactEmail}\">{contactEmail}</a>"))</li>
    </ul>
</section>

<section id="sorumlu">
    <h2><span>1</span>@sections[0].Title</h2>
    <p>@T("Almanca Konuş bir şirket değildir. Almanca öğretmeni Suna Koç'un kişisel olarak yürüttüğü bir web sitesidir. Kişisel verilerinizden sorumlu olan kişi (KVKK'daki adıyla \"veri sorumlusu\", DSGVO'daki adıyla \"Verantwortlicher\") Suna Koç'tur:",
          "Almanca Konuş ist kein Unternehmen, sondern eine Website, die die Deutschlehrerin Suna Koç persönlich betreibt. Verantwortlich für die Verarbeitung Ihrer personenbezogenen Daten (Verantwortliche im Sinne der DSGVO, \"veri sorumlusu\" im Sinne des türkischen KVKK) ist Suna Koç:")</p>
    <address class="legal-card">
        <strong>Suna Koç</strong><br />
        @T("Almanca öğretmeni – www.almanca-konus.com", "Deutschlehrerin – www.almanca-konus.com")<br />
        @T("E-posta", "E-Mail"): <a href="mailto:@contactEmail">@contactEmail</a><br />
        @T("İletişim formu", "Kontaktformular"): <a href="@aboutPath#contact-form">@T("Hakkımda sayfası", "Seite „Vita“")</a>
    </address>
    <p>@T("Bu metinde geçen \"biz\", Suna Koç'u ve siteyi onun adına teknik olarak yöneten kişiyi ifade eder. Sitenin yönetim paneline yalnızca Suna Koç'un yetki verdiği kişiler girebilir.",
          "\"Wir\" bezeichnet in diesem Text Suna Koç und die Person, die die Website in ihrem Auftrag technisch betreut. In den Verwaltungsbereich der Website kommen nur Personen, die Suna Koç dazu berechtigt hat.")</p>
</section>

<section id="veriler">
    <h2><span>2</span>@sections[1].Title</h2>

    <h3><i class="fa-solid fa-globe" aria-hidden="true"></i>@T("Siteyi ziyaret ettiğinizde", "Beim Besuch der Website")</h3>
    <p>@T("Her web sitesinde olduğu gibi, sayfayı size gönderebilmek için tarayıcınızın IP adresi ve isteğin teknik bilgileri (zaman, istenen sayfa, tarayıcı türü) sunucuya ulaşır. Bunları yalnızca siteyi çalıştırmak ve kötüye kullanımı (örneğin çok sayıda otomatik deneme) engellemek için kullanıyoruz:",
          "Wie bei jeder Website erreichen unseren Server die IP-Adresse Ihres Browsers und technische Angaben zur Anfrage (Zeitpunkt, aufgerufene Seite, Browsertyp), damit wir Ihnen die Seite ausliefern können. Wir nutzen sie nur für den Betrieb und gegen Missbrauch (z. B. massenhafte automatische Versuche):")</p>
    <ul>
        <li>@T("Giriş, kayıt, iletişim formu ve sözlükte aşırı denemeleri sınırlamak için IP adresi birkaç dakikalığına yalnızca sunucunun belleğinde tutulur.",
              "Um zu viele Versuche bei Anmeldung, Registrierung, Kontaktformular und Wörterbuch zu begrenzen, wird die IP-Adresse für wenige Minuten nur im Arbeitsspeicher des Servers gehalten.")</li>
        <li>@T("Hata ve güvenlik kayıtlarında IP adresi geçebilir; bu kayıtlar en geç 30 gün sonra otomatik olarak silinir.",
              "In Fehler- und Sicherheitsprotokollen kann die IP-Adresse vorkommen; diese Protokolle werden nach spätestens 30 Tagen automatisch gelöscht.")</li>
        <li>@T("Ziyaretçi sayılarını görmek için Cloudflare Web Analytics kullanıyoruz. Bu hizmet çerez kullanmaz ve sizi tanımlamaz.",
              "Für Besucherzahlen nutzen wir Cloudflare Web Analytics. Der Dienst setzt keine Cookies und identifiziert Sie nicht.")</li>
    </ul>

    <h3><i class="fa-solid fa-user-plus" aria-hidden="true"></i>@T("Hesap oluşturduğunuzda", "Bei der Registrierung")</h3>
    <p>@T("Adınız, soyadınız, yaşınız, e-posta adresiniz ve şifreniz. E-posta adresinizi doğrulamak için size bir onay e-postası gönderiyoruz. Şifreniz geri çevrilemez biçimde (hash) saklanır. Yaşınızı yalnızca derslerin ve seviyelerin size uygunluğu için soruyoruz.",
          "Vorname, Nachname, Alter, E-Mail-Adresse und Passwort. Zur Bestätigung Ihrer E-Mail-Adresse senden wir Ihnen eine E-Mail. Ihr Passwort wird unumkehrbar (als Hash) gespeichert. Ihr Alter fragen wir nur, damit Unterricht und Niveau zu Ihnen passen.")</p>

    <h3><i class="fa-brands fa-google" aria-hidden="true"></i>@T("Google ile giriş yaptığınızda", "Bei der Anmeldung mit Google")</h3>
    <p>@T("Google'dan yalnızca adınızı, soyadınızı, e-posta adresinizi ve bu adresin doğrulanmış olup olmadığını alırız. Google şifrenizi hiçbir zaman görmeyiz. Ayrıntılar aşağıda, 6. bölümde.",
          "Von Google erhalten wir nur Vorname, Nachname, E-Mail-Adresse und die Angabe, ob diese bestätigt ist. Ihr Google-Passwort sehen wir nie. Einzelheiten in Abschnitt 6.")</p>

    <h3><i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>@T("Sınavlara girdiğinizde", "Bei Prüfungen")</h3>
    <p>@T("Verdiğiniz cevaplar, puanınız, başlama ve bitiş zamanı, süre ve deneme sayısı. Sınavın adil olması için sınav sırasında şu olaylar zamanlarıyla birlikte kaydedilir: tam ekrandan çıkma, başka sekmeye veya pencereye geçme, kopyalama, yapıştırma ve yazdırma. Bağlantı koparsa cevaplarınız kaybolmasın diye tarayıcınızda geçici bir kopya tutulur; sonuç sayfası açıldığında silinir.",
          "Ihre Antworten, Ihre Punktzahl, Beginn und Ende, Dauer und Zahl der Versuche. Damit die Prüfung fair bleibt, werden während der Prüfung folgende Ereignisse mit Zeitpunkt protokolliert: Verlassen des Vollbilds, Wechsel in einen anderen Tab oder ein anderes Fenster, Kopieren, Einfügen und Drucken. Damit bei einem Verbindungsabbruch nichts verloren geht, liegt eine vorläufige Kopie Ihrer Antworten in Ihrem Browser; sie wird gelöscht, sobald die Ergebnisseite öffnet.")</p>

    <h3><i class="fa-solid fa-file-arrow-down" aria-hidden="true"></i>@T("Dosya indirdiğinizde", "Beim Herunterladen von Dateien")</h3>
    <p>@T("Yazılardaki dosyaları indirmek için giriş yapmanız gerekir. Hangi dosyayı ne zaman indirdiğinizi adınız ve e-posta adresinizle birlikte kaydederiz; böylece hangi materyallerin işe yaradığını görür ve kötüye kullanımı engelleriz.",
          "Zum Herunterladen von Dateien aus Beiträgen müssen Sie angemeldet sein. Wir speichern, welche Datei Sie wann heruntergeladen haben, zusammen mit Ihrem Namen und Ihrer E-Mail-Adresse – so sehen wir, welche Materialien helfen, und verhindern Missbrauch.")</p>

    <h3><i class="fa-solid fa-envelope" aria-hidden="true"></i>@T("İletişim formunu kullandığınızda", "Beim Kontaktformular")</h3>
    <p>@T("Adınız, e-posta adresiniz ve mesajınız bize e-posta olarak iletilir ve size bir alındı e-postası gönderilir. Mesaj, e-posta gönderilene kadar (genellikle birkaç saniye) sitenin e-posta kuyruğunda bekler ve gönderilince silinir; sonrasında yalnızca yazışma için gerektiği sürece e-posta kutumuzda kalır.",
          "Name, E-Mail-Adresse und Nachricht werden uns per E-Mail zugestellt, und Sie erhalten eine Eingangsbestätigung. Die Nachricht wartet nur bis zum Versand (meist wenige Sekunden) in der E-Mail-Warteschlange der Website und wird dann dort gelöscht; danach bleibt sie nur so lange in unserem Postfach, wie es für die Korrespondenz nötig ist.")</p>

    <h3><i class="fa-solid fa-paper-plane" aria-hidden="true"></i>@T("Size gönderdiğimiz e-postalar", "E-Mails, die wir Ihnen schicken")</h3>
    <ul>
        <li><strong>@T("Hesap ve sınav e-postaları:", "Konto- und Prüfungs-E-Mails:")</strong> @T("kayıt onayı ve bitirdiğiniz her sınavın sonucu. Bunlar hesabınızın bir parçasıdır ve her zaman gönderilir.", "Bestätigung der Registrierung und das Ergebnis jeder Prüfung, die Sie beenden. Sie gehören zu Ihrem Konto und werden immer verschickt.")</li>
        <li><strong>@T("Duyurular:", "Ankündigungen:")</strong> @T("yeni bir yazı ya da sınav yayınladığımda kısa bir haber. Kayıt olurken işaretlerseniz alırsınız; bu e-postalar başlamadan önce üye olanlara da gönderilir. Her duyurudaki “Duyurulardan çık” bağlantısıyla (Gmail'in “Abonelikten çık” düğmesiyle de) ya da Hesabım sayfasından tek tıkla vazgeçebilirsiniz.",
              "eine kurze Nachricht, wenn ich einen neuen Beitrag oder eine neue Prüfung veröffentliche. Sie erhalten sie, wenn Sie das bei der Registrierung ankreuzen; wer schon vor Beginn dieser E-Mails registriert war, erhält sie ebenfalls. Mit dem Link „Ankündigungen abbestellen“ in jeder Ankündigung (auch mit der Gmail-Schaltfläche „Abbestellen“) oder auf der Seite „Mein Konto“ melden Sie sich mit einem Klick ab.")</li>
        <li><strong>@T("Gönderim kaydı:", "Versandprotokoll:")</strong> @T("her e-posta için alıcı adresi, konu, tarih ve gönderilip gönderilemediği kaydedilir; içerik saklanmaz (yalnızca gönderilemeyen bir e-posta, tekrar gönderilene kadar). E-postalar Gmail üzerinden gönderilir.",
              "Zu jeder E-Mail werden Empfängeradresse, Betreff, Datum und Zustellstatus gespeichert, der Inhalt nicht (nur bei einer nicht zugestellten E-Mail, bis sie erneut gesendet ist). Die E-Mails werden über Gmail versendet.")</li>
    </ul>

    <h3><i class="fa-solid fa-book-open" aria-hidden="true"></i>@T("Sözlüğü kullandığınızda", "Beim Wörterbuch")</h3>
    <p>@T("Aradığınız kelime önce kendi sözlüğümüzde aranır. Bulunamazsa yalnızca kelimenin kendisi çeviri için DeepL'e, gerekirse PONS'a gönderilir; hesabınız veya IP adresiniz bu hizmetlere iletilmez. Aynı kelime tekrar sorulduğunda hızlı cevap vermek için sonuç en fazla 12 saat sunucunun belleğinde tutulur.",
          "Das gesuchte Wort wird zuerst in unserem eigenen Wörterbuch gesucht. Wird es nicht gefunden, geht nur das Wort selbst zur Übersetzung an DeepL und bei Bedarf an PONS; Ihr Konto oder Ihre IP-Adresse werden nicht übermittelt. Das Ergebnis bleibt bis zu 12 Stunden im Arbeitsspeicher des Servers, damit dieselbe Suche schneller beantwortet wird.")</p>

    <h3><i class="fa-solid fa-robot" aria-hidden="true"></i>@T("Robot koruması", "Schutz vor Bots")</h3>
    <p>@T("Giriş, kayıt ve iletişim formlarında Cloudflare Turnstile kullanıyoruz. Turnstile, formu bir insanın gönderdiğini tarayıcı bilgileri üzerinden doğrular; reklam amacıyla kullanılmaz.",
          "Bei Anmeldung, Registrierung und Kontaktformular nutzen wir Cloudflare Turnstile. Turnstile prüft anhand von Browserinformationen, ob ein Mensch das Formular sendet; die Daten werden nicht für Werbung genutzt.")</p>
</section>

<section id="hukuki-sebep">
    <h2><span>3</span>@sections[2].Title</h2>
    <div class="legal-table" role="region" aria-label="@sections[2].Title" tabindex="0">
        <table>
            <thead>
                <tr><th>@T("İşleme", "Verarbeitung")</th><th>KVKK</th><th>DSGVO</th></tr>
            </thead>
            <tbody>
                <tr><td>@T("Hesap, sınavlar, dosya indirme", "Konto, Prüfungen, Downloads")</td><td>@T("Sözleşmenin kurulması ve ifası (md. 5/2-c)", "Vertragserfüllung (Art. 5 Abs. 2 lit. c)")</td><td>Art. 6 Abs. 1 lit. b</td></tr>
                <tr><td>@T("İletişim formu ve e-postalar", "Kontaktformular und E-Mails")</td><td>@T("Sözleşme öncesi talebiniz (md. 5/2-c)", "Vorvertragliche Anfrage (Art. 5 Abs. 2 lit. c)")</td><td>Art. 6 Abs. 1 lit. b</td></tr>
                <tr><td>@T("Yeni yazı ve sınav duyuruları", "Ankündigungen neuer Beiträge und Prüfungen")</td><td>@T("Açık rıza ve meşru menfaat; her zaman geri alınabilir (md. 5/1, md. 5/2-f)", "Einwilligung bzw. berechtigtes Interesse; jederzeit widerrufbar (Art. 5 Abs. 1, Art. 5 Abs. 2 lit. f)")</td><td>@T("Art. 6 Abs. 1 lit. a / f", "Art. 6 Abs. 1 lit. a / f")</td></tr>
                <tr><td>@T("Güvenlik, robot koruması, kayıtlar, anonim istatistik", "Sicherheit, Bot-Schutz, Protokolle, anonyme Statistik")</td><td>@T("Meşru menfaat (md. 5/2-f)", "Berechtigtes Interesse (Art. 5 Abs. 2 lit. f)")</td><td>Art. 6 Abs. 1 lit. f</td></tr>
                <tr><td>@T("Google ile giriş, yurt dışındaki hizmetlere aktarım", "Anmeldung mit Google, Übermittlung ins Ausland")</td><td>@T("Açık rıza (md. 5/1, md. 9)", "Ausdrückliche Einwilligung (Art. 5 Abs. 1, Art. 9)")</td><td>@T("Art. 6 Abs. 1 lit. a / b, Art. 44 vd.", "Art. 6 Abs. 1 lit. a / b, Art. 44 ff.")</td></tr>
            </tbody>
        </table>
    </div>
    <p>@T("Açık rızanızı her zaman geri alabilirsiniz; bu, geri almadan önceki işlemlerin hukuka uygunluğunu etkilemez.",
          "Eine Einwilligung können Sie jederzeit widerrufen; das berührt die Rechtmäßigkeit der Verarbeitung bis zum Widerruf nicht.")</p>
</section>

<section id="cerezler">
    <h2><span>4</span>@sections[3].Title</h2>
    <p>@T("Yalnızca sitenin çalışması için gerekli çerezleri kullanıyoruz. Reklam, analiz veya takip çerezi yoktur; bu yüzden çerez onayı sormuyoruz.",
          "Wir verwenden nur Cookies, die für den Betrieb der Website notwendig sind. Es gibt keine Werbe-, Analyse- oder Tracking-Cookies; deshalb fragen wir nicht nach einer Cookie-Einwilligung.")</p>
    <div class="legal-table" role="region" aria-label="@sections[3].Title" tabindex="0">
        <table>
            <thead>
                <tr><th>@T("Ad", "Name")</th><th>@T("Amaç", "Zweck")</th><th>@T("Süre", "Dauer")</th></tr>
            </thead>
            <tbody>
                <tr><td><code>SpeakingClubAuth</code></td><td>@T("Giriş yaptığınızı hatırlar", "Merkt sich, dass Sie angemeldet sind")</td><td>@T("Çıkış yapana kadar, en fazla 7 gün", "Bis zur Abmeldung, höchstens 7 Tage")</td></tr>
                <tr><td><code>SpeakingClubCSRF</code></td><td>@T("Formları sahte isteklere karşı korur", "Schützt Formulare vor gefälschten Anfragen")</td><td>@T("Tarayıcı oturumu", "Browsersitzung")</td></tr>
                <tr><td><code>.AspNetCore.Culture</code></td><td>@T("Seçtiğiniz dili (Türkçe/Almanca) hatırlar", "Merkt sich die gewählte Sprache (Türkisch/Deutsch)")</td><td>@T("1 yıl", "1 Jahr")</td></tr>
                <tr><td><code>.AspNetCore.Correlation.*</code>, <code>Identity.External</code></td><td>@T("Google ile giriş sırasında güvenlik", "Sicherheit während der Anmeldung mit Google")</td><td>@T("Birkaç dakika", "Wenige Minuten")</td></tr>
                <tr><td><code>__cf_bm</code>, <code>cf_clearance</code> (Cloudflare)</td><td>@T("Robot ve saldırı koruması", "Schutz vor Bots und Angriffen")</td><td>@T("30 dakika – 1 yıl", "30 Minuten – 1 Jahr")</td></tr>
                <tr><td>@T("Tarayıcı deposu:", "Browserspeicher:") <code>theme</code></td><td>@T("Açık/koyu tema tercihiniz", "Ihre Wahl zwischen hellem und dunklem Design")</td><td>@T("Siz silene kadar", "Bis Sie ihn löschen")</td></tr>
                <tr><td>@T("Tarayıcı deposu:", "Browserspeicher:") <code>exam:…</code></td><td>@T("Sınav cevaplarınızın geçici yedeği", "Vorläufige Sicherung Ihrer Prüfungsantworten")</td><td>@T("Sonuç sayfası açılana kadar", "Bis die Ergebnisseite öffnet")</td></tr>
            </tbody>
        </table>
    </div>
</section>

<section id="hizmet-saglayicilar">
    <h2><span>5</span>@sections[4].Title</h2>
    <p>@T("Siteyi çalıştırmak için aşağıdaki hizmetlerden yararlanıyoruz. Her biri yalnızca kendi işi için gereken veriyi alır.",
          "Für den Betrieb der Website nutzen wir die folgenden Dienste. Jeder erhält nur die Daten, die er für seine Aufgabe braucht.")</p>
    <ul class="legal-providers">
        <li><strong>@T("Barındırma (hosting)", "Hosting")</strong> – @T("web sunucusu ve veritabanı; hesap, sınav ve indirme verileri burada saklanır.", "Webserver und Datenbank; hier liegen Konto-, Prüfungs- und Download-Daten.")</li>
        <li><strong>Cloudflare, Inc. (@T("ABD", "USA"))</strong> – @T("sitenin önünde çalışan ağ ve güvenlik hizmeti, robot koruması (Turnstile), çerezsiz ziyaretçi istatistiği. Her istek Cloudflare üzerinden geçer.", "Netzwerk- und Sicherheitsdienst vor der Website, Bot-Schutz (Turnstile), cookiefreie Besucherstatistik. Jede Anfrage läuft über Cloudflare.")</li>
        <li><strong>Google (@T("Google ile giriş, Gmail", "Anmeldung mit Google, Gmail"))</strong> – @T("Google ile girişi seçerseniz kimlik doğrulama; sitenin gönderdiği e-postalar (onay, sınav sonucu, duyurular, iletişim formu) Gmail üzerinden iletilir.", "Anmeldung, falls Sie \"Mit Google anmelden\" wählen; die E-Mails der Website (Bestätigung, Prüfungsergebnisse, Ankündigungen, Kontaktformular) werden über Gmail versendet.")</li>
        <li><strong>YouTube (Google)</strong> – @T("ana sayfadaki kısa videoların önizleme resimleri YouTube'dan yüklenir; video ancak siz tıkladığınızda oynatılır (youtube-nocookie.com). Yazılara ve sorulara eklenen videolar YouTube oynatıcısıyla gösterilir.", "Die Vorschaubilder der Kurzvideos auf der Startseite werden von YouTube geladen; das Video startet erst nach Ihrem Klick (youtube-nocookie.com). In Beiträge und Fragen eingebettete Videos zeigt der YouTube-Player.")</li>
