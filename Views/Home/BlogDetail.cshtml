@model SpeakingClub.Models.BlogDetailViewModel
@inject LanguageService Localizer
@using Microsoft.AspNetCore.Html
@{
    Layout = "_Layout";
    // Title, description, canonical, hreflang, robots and the BlogPosting/Breadcrumb JSON-LD come from
    // HomeController.BlogDetail; this view only renders the page.
    var isGerman = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "de";
    string T(string tr, string de) => isGerman ? de : tr;
    // Strings placed inside <script> must be JSON, not HTML-encoded (ğ would arrive as "&#x11F;")
    IHtmlContent Js(string value) => Html.Raw(System.Text.Json.JsonSerializer.Serialize(value));

    var encodedUrl = Uri.EscapeDataString(Model.CanonicalUrl);
    var encodedTitle = Uri.EscapeDataString(Model.Title);
    var facebookShareUrl = $"https://www.facebook.com/sharer/sharer.php?u={encodedUrl}";
    var twitterShareUrl = $"https://twitter.com/intent/tweet?url={encodedUrl}&text={encodedTitle}";
    var whatsappShareUrl = $"https://wa.me/?text={encodedTitle}%20{encodedUrl}";
    var linkedinShareUrl = $"https://www.linkedin.com/sharing/share-offsite/?url={encodedUrl}";

    var authorName = string.IsNullOrWhiteSpace(Model.Author) ? "Almanca Konuş" : Model.Author.Trim();
    var authorInitial = authorName.Substring(0, 1).ToUpper();
    var hasToc = Model.TableOfContents.Count >= 2;
    var correctAnswer = Model.QuizQuestion?.Answers?.FirstOrDefault(a => a.IsCorrect);

    void ShareButtons()
    {
        <a class="bp-share__btn bp-share__btn--facebook" href="@facebookShareUrl" target="_blank" rel="noopener noreferrer nofollow" aria-label="@T("Facebook'ta paylaş", "Auf Facebook teilen")"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>
        <a class="bp-share__btn bp-share__btn--x" href="@twitterShareUrl" target="_blank" rel="noopener noreferrer nofollow" aria-label="@T("X'te paylaş", "Auf X teilen")"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></a>
        <a class="bp-share__btn bp-share__btn--whatsapp" href="@whatsappShareUrl" target="_blank" rel="noopener noreferrer nofollow" aria-label="@T("WhatsApp'ta paylaş", "Per WhatsApp teilen")"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a>
        <a class="bp-share__btn bp-share__btn--linkedin" href="@linkedinShareUrl" target="_blank" rel="noopener noreferrer nofollow" aria-label="@T("LinkedIn'de paylaş", "Auf LinkedIn teilen")"><i class="fa-brands fa-linkedin-in" aria-hidden="true"></i></a>
        <button type="button" class="bp-share__btn bp-share__btn--copy" data-copy-url="@Model.CanonicalUrl" aria-label="@T("Bağlantıyı kopyala (Instagram için)", "Link kopieren (für Instagram)")"><i class="fa-solid fa-link" aria-hidden="true"></i></button>
        <button type="button" class="bp-share__btn bp-share__btn--native" data-native-share="@Model.CanonicalUrl" hidden aria-label="@T("Paylaş", "Teilen")"><i class="fa-solid fa-share-nodes" aria-hidden="true"></i></button>
    }
}
@section Css {
    <script>document.documentElement.classList.add('bp-js');</script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@@0,9..144,600;1,9..144,600&display=swap" />
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
}

<div class="blog-page blog-post"
     data-copied="@T("Bağlantı kopyalandı", "Link kopiert")"
     data-copy-manually="@T("Bu bağlantıyı kopyalayın:", "Diesen Link kopieren:")"
     data-copy-code="@T("Kopyala", "Kopieren")"
     data-copied-code="@T("Kopyalandı", "Kopiert")">

    <div class="bp-progress" aria-hidden="true"></div>

    <article>
        <header class="post-hero bp-container">
            <nav aria-label="@T("Sayfa yolu", "Brotkrumen")">
                <ol class="bp-breadcrumb bp-enter">
                    <li><a href="/">@T("Ana Sayfa", "Startseite")</a></li>
                    <li><a href="@Model.BlogListPath">Blog</a></li>
                    <li aria-current="page">@Model.Title</li>
                </ol>
            </nav>

            @if (Model.Category != null)
            {
                <a class="bp-eyebrow bp-enter" href="@(Model.BlogListPath)?category=@(Uri.EscapeDataString(Model.Category.Name))">
                    <i class="fa-solid fa-bookmark" aria-hidden="true"></i>@Model.Category.Name
                </a>
            }

            <h1 class="post-hero__title bp-enter" style="--bp-delay: 80ms">@Model.Title</h1>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="post-hero__lead bp-enter" style="--bp-delay: 160ms">@Model.Description</p>
            }

            <div class="bp-meta bp-enter" style="--bp-delay: 240ms">
                <span><span class="bp-avatar" aria-hidden="true">@authorInitial</span><span class="bp-author">@authorName</span></span>
                <time datetime="@Model.Date.ToString("yyyy-MM-dd")">@Model.Date.ToString("d MMMM yyyy")</time>
                <span><i class="fa-regular fa-clock" aria-hidden="true"></i>@string.Format(T("{0} dk okuma", "{0} Min. Lesezeit"), Model.ReadingMinutes)</span>
                <span title="@T("Görüntülenme", "Aufrufe")"><i class="fa-regular fa-eye" aria-hidden="true"></i>@Model.ViewCount<span class="bp-sr-only"> @T("görüntülenme", "Aufrufe")</span></span>
            </div>
        </header>

        @if (!string.IsNullOrEmpty(Model.Image))
        {
            <figure class="post-cover bp-container">
                <img class="post-cover__backdrop" src="@Model.Image" alt="" aria-hidden="true" decoding="async" />
                <img class="post-cover__image" src="@Model.Image" alt="@Model.Title" fetchpriority="high" decoding="async" />
            </figure>
        }

        <div class="post-layout bp-container">
            <aside class="post-aside" aria-label="@T("Yazı araçları", "Artikelwerkzeuge")">
                <div class="post-aside__inner">
                    @if (hasToc)
                    {
                        <details class="post-toc" open>
                            <summary>@T("İçindekiler", "Inhalt") <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
                            <nav aria-label="@T("İçindekiler", "Inhalt")">
                                <ol>
                                    @foreach (var item in Model.TableOfContents)
                                    {
                                        <li class="toc-l@(item.Level)"><a href="#@item.Id">@item.Text</a></li>
                                    }
                                </ol>
                            </nav>
                        </details>
                    }
                    <div class="post-share-rail">
                        <span class="bp-filters__label">@T("Paylaş", "Teilen")</span>
                        @{ ShareButtons(); }
                    </div>
                </div>
            </aside>

            <div class="post-main">
                <div class="post-body ck-content" lang="@Model.ContentLanguage">
                    @if (!string.IsNullOrEmpty(Model.Content))
                    {
                        @Html.Raw(Model.Content)
                    }
                    else
                    {
                        <p>@Localizer.GetKey("Err2").Value</p>
                    }
                </div>

                @if (Model.Tags != null && Model.Tags.Any())
                {
                    <div class="post-tags">
                        <span class="bp-filters__label">@Localizer.GetKey("Tag").Value</span>
                        <ul class="bp-chips">
                            @foreach (var tag in Model.Tags)
                            {
                                <li><a class="bp-chip" href="@(Model.BlogListPath)?tag=@(Uri.EscapeDataString(tag.Name))"><i class="fa-solid fa-hashtag" aria-hidden="true"></i>@tag.Name</a></li>
                            }
                        </ul>
                    </div>
                }

                @if (Model.QuizQuestion != null && correctAnswer != null)
                {
                    <section class="post-section post-quiz bp-card reveal" aria-labelledby="quiz-question">
                        <div class="post-quiz__head">
                            <span class="post-quiz__icon" aria-hidden="true"><i class="fa-solid fa-brain"></i></span>
                            <div>
                                <div class="post-quiz__label">@T("Kendini test et", "Teste dich selbst")</div>
                                <h2 class="post-quiz__question" id="quiz-question">@Model.QuizQuestion.QuestionText</h2>
                            </div>
                        </div>
                        <form id="advancedQuizForm" novalidate>
                            <fieldset class="post-quiz__options">
                                <legend class="bp-sr-only">@T("Cevabınızı seçin", "Wählen Sie Ihre Antwort")</legend>
                                @foreach (var answer in Model.QuizQuestion.Answers)
                                {
                                    <div class="post-quiz__option">
                                        <input type="radio" name="advancedQuizAnswer" id="advancedQuizAnswer_@answer.Id" value="@answer.Id" />
                                        <label for="advancedQuizAnswer_@answer.Id">@answer.AnswerText</label>
                                    </div>
                                }
                            </fieldset>
                            <button type="submit" class="bp-btn">
                                @Localizer.GetKey("SubmitAnswer").Value <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                            </button>
                        </form>
                        <div id="advancedQuizFeedback" class="post-quiz__feedback" role="status" aria-live="polite" hidden></div>
                    </section>
                }

                @if (Model.Files != null && Model.Files.Any())
                {
                    var attachmentsTitle = Localizer.GetKey("Attachments")?.Value ?? T("İndirilebilir dosyalar", "Downloads");
                    var totalFiles = Model.Files.Count;
                    <section class="post-section post-files reveal" aria-labelledby="files-title">
                        <div class="post-files__head">
                            <h2 class="bp-section-title" id="files-title"><i class="fa-solid fa-folder-open me-2" aria-hidden="true"></i>@attachmentsTitle</h2>
                            <span class="post-files__count">@totalFiles @T("dosya", totalFiles == 1 ? "Datei" : "Dateien")</span>
                        </div>
                        <div class="post-files__grid">
                            @foreach (var file in Model.Files)
                            {
                                var extension = file.FileExtension?.ToLowerInvariant();
                                var (kind, iconClass) = extension switch
                                {
                                    ".pdf" => ("pdf", "fa-file-pdf"),
                                    ".doc" or ".docx" => ("word", "fa-file-word"),
                                    ".xls" or ".xlsx" => ("excel", "fa-file-excel"),
                                    ".ppt" or ".pptx" => ("powerpoint", "fa-file-powerpoint"),
                                    _ => ("other", "fa-file")
                                };
                                var typeBadge = extension?.TrimStart('.').ToUpperInvariant();
                                var sizeMB = (file.FileSizeBytes / (1024.0 * 1024.0)).ToString("F2");

                                <div class="file-card file-card--@kind">
                                    <div class="file-card__preview">
                                        @if (kind == "pdf")
                                        {
                                            <iframe src="@file.StoredFilePath#toolbar=0&navpanes=0&scrollbar=0" title="@file.DisplayName" loading="lazy" tabindex="-1"></iframe>
                                        }
                                        else
                                        {
                                            <i class="fa-solid @iconClass" aria-hidden="true"></i>
                                        }
                                        <span class="file-card__type">@typeBadge</span>
                                    </div>
                                    <div class="file-card__body">
                                        <h3 class="file-card__name" title="@file.DisplayName">@file.DisplayName</h3>
                                        <div class="file-card__foot">
                                            <span>@sizeMB MB · <i class="fa-solid fa-arrow-down" aria-hidden="true"></i> <span id="download-count-@file.FileId">@file.DownloadCount</span></span>
                                            <a href="/download/@file.FileId" class="file-card__download" rel="nofollow" data-file-id="@file.FileId">
                                                <i class="fa-solid fa-download" aria-hidden="true"></i>@T("İndir", "Download")
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (!string.IsNullOrEmpty(Model.RawYT) || !string.IsNullOrEmpty(Model.RawMaps))
                {
                    <section class="post-section post-embeds reveal" aria-label="@T("Video ve harita", "Video und Karte")">
                        @if (!string.IsNullOrEmpty(Model.RawYT))
                        {
                            <iframe src="@Model.RawYT" title="YouTube video" loading="lazy"
                                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                    referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                        }
                        @if (!string.IsNullOrEmpty(Model.RawMaps))
                        {
                            <iframe src="@Model.RawMaps" title="@T("Harita", "Karte")" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
                        }
                    </section>
                }

                <section class="post-section post-share bp-card reveal" aria-labelledby="share-title">
                    <div>
                        <h2 class="post-share__title" id="share-title">@Localizer.GetKey("ShareThisPost").Value</h2>
                        <p class="post-share__text">@T("Faydalı bulduysanız Almanca öğrenen arkadaşlarınıza gönderin.", "Hilfreich? Schicken Sie den Beitrag an andere Deutschlernende.")</p>
                    </div>
                    <div class="bp-share">
                        @{ ShareButtons(); }
                    </div>
                </section>
            </div>
        </div>
    </article>

    @if (Model.RelatedPosts.Count > 0)
    {
        <section class="post-related bp-container" aria-labelledby="related-title">
            <div class="post-related__head">
                <h2 class="bp-section-title" id="related-title">@T("Bunları da okuyun", "Das könnte Sie auch interessieren")</h2>
                <a class="bp-btn bp-btn--ghost" href="@Model.BlogListPath">@T("Tüm yazılar", "Alle Beiträge") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="bp-grid">
                @for (var i = 0; i < Model.RelatedPosts.Count; i++)
                {
                    <partial name="_BlogPostCard" model="Model.RelatedPosts[i]" view-data='new ViewDataDictionary(ViewData) { ["HeadingTag"] = "h3", ["Delay"] = i * 90 }' />
                }
            </div>
        </section>
    }

    <button type="button" class="bp-top" aria-label="@T("Başa dön", "Nach oben")"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
    <div class="bp-toast" role="status" aria-live="polite"></div>
    <dialog class="bp-lightbox" aria-label="@T("Görsel", "Bild")">
        <figure class="m-0 text-center">
            <img alt="" />
            <figcaption></figcaption>
        </figure>
        <button type="button" class="bp-lightbox__close" aria-label="@T("Kapat", "Schließen")"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
    </dialog>
</div>

@section Scripts {
    <script src="~/js/blog.js" asp-append-version="true" defer></script>
    <script>
        @if (Model.QuizQuestion != null && correctAnswer != null)
        {
            <text>
            (function () {
                var form = document.getElementById('advancedQuizForm');
                var feedback = document.getElementById('advancedQuizFeedback');
                if (!form || !feedback) return;
                var correctId = @correctAnswer.Id;
                var correctText = @Js(correctAnswer.AnswerText ?? "");

                function show(kind, message) {
                    feedback.className = 'post-quiz__feedback';
                    void feedback.offsetWidth; // restart the entrance animation
                    feedback.classList.add('is-' + kind);
                    feedback.textContent = message;
                    feedback.hidden = false;
                }

                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    form.querySelectorAll('.post-quiz__option').forEach(function (option) {
                        option.classList.remove('is-correct', 'is-wrong');
                    });
                    var selected = form.querySelector('input[name="advancedQuizAnswer"]:checked');
                    if (!selected) {
                        show('warning', @Js(T("Lütfen bir cevap seçin.", "Bitte wählen Sie eine Antwort.")));
                        return;
                    }
                    var option = selected.closest('.post-quiz__option');
                    if (parseInt(selected.value, 10) === correctId) {
                        option.classList.add('is-correct');
                        show('correct', @Js(T("Doğru! Tebrikler 🎉", "Richtig! Glückwunsch 🎉")));
                    } else {
                        option.classList.add('is-wrong');
                        var right = document.getElementById('advancedQuizAnswer_' + correctId);
                        if (right) right.closest('.post-quiz__option').classList.add('is-correct');
                        show('wrong', @Js(T("Yanlış. Doğru cevap: ", "Leider falsch. Richtig ist: ")) + correctText);
                    }
                });
            })();
            </text>
        }

        // Download counter shown next to each file
        document.querySelectorAll('[data-file-id]').forEach(function (link) {
            link.addEventListener('click', function () {
                var count = document.getElementById('download-count-' + link.getAttribute('data-file-id'));
                if (count) count.textContent = parseInt(count.textContent, 10) + 1;
            });
        });

        // After login redirect: auto-start download and clean the URL
        (function () {
            var params = new URLSearchParams(window.location.search);
            var fileId = params.get('autoDownload');
            if (fileId) {
                // Strip the param from the URL first so refresh won't re-trigger
                params.delete('autoDownload');
                var clean = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
                window.history.replaceState({}, '', clean);
                // Navigate to download URL — browser stays on page because the
                // server responds with Content-Disposition: attachment
                window.location.href = '/download/' + encodeURIComponent(fileId);
            }
        })();
    </script>
}
